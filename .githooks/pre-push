#!/bin/sh
# A push to main releases its changesets (.changeset/README.md), so a commit there that changes what Imp ships needs
# one. This blocks a push to main whose commits change shipped code, add no changeset, and do not say
# "Changeset: none" in their messages. `pnpm install` installs it (the root's prepare script sets core.hooksPath).
set -eu

zero=0000000000000000000000000000000000000000
# What a release ships and runs (scripts/package.sh), less its tests, scripts and docs.
shipped() {
	git diff-tree --no-commit-id --name-only -r "$1" -- host sdk client scripts/install-host.sh scripts/install-mac.sh \
		':!host/test' ':!host/scripts' ':!client/app.test.contract' ':!client/.vscode' ':!*.md' | grep -q .
}

status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != "$zero" ] || continue
	# A remote tip this clone has not fetched makes the push non-fast-forward; git rejects it anyway.
	if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		continue
	fi
	if git diff --name-only --diff-filter=A "$remote_sha" "$local_sha" -- '.changeset/*.md' ':!.changeset/README.md' |
		grep -q .; then
		continue
	fi
	missing=
	for commit in $(git rev-list --no-merges "$remote_sha..$local_sha"); do
		if shipped "$commit" && ! git log -1 --format=%B "$commit" | grep -qi '^Changeset: *none'; then
			missing="$missing
  $(git log -1 --format='%h %s' "$commit")"
		fi
	done
	if [ -n "$missing" ]; then
		status=1
		cat >&2 <<EOF
These commits change what Imp ships, and the push adds no changeset:$missing

A push to main releases its changesets to every installed host. Either:
  - add one: \`pnpm changeset\`, or write .changeset/<name>.md with \`"@imp/host": patch\` (minor for a feature)
    in its front matter and a sentence for the changelog, commit it and push again; or
  - if the change keeps what Imp does the same (a refactor), add a line \`Changeset: none\` to the commit's message.
EOF
	fi
done
exit $status
