// A new app's screen: the shell feeds `notes` from the read of that name and `addNote` from the write.

// The shell's styles are its own: an app declares the ones it uses.
style Label
  font-family = "family.mono"
  font-size = "0.6875rem"
  font-weight = 500
  letter-spacing = "0.12em"
  text-transform = "uppercase"
  color = "ink.muted"

shape Note
  id: string
  text: string

component Screen
  props
    notes: Note[]
    addNote: action
  state draft = ""
  action edit(value: string)
    draft = value
  action add
    if draft.trim() != ""
      addNote(draft.trim())
      draft = ""
  view
    column max-width="48.5rem" margin="0 auto" padding="28px 20px 32px" gap=20 box-sizing="border-box" width="100%"
      row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
        input value=draft input=edit submit=add placeholder="Write a note" aria-label="New note" flex=1 min-width=0
          border="none" background-color="transparent" outline="none" padding="8px 0" font-size="1.0625rem"
        button press=add disabled=(draft.trim() == "") testId="note-add" padding="9px 14px" border="none"
          background-color="AccentColor" color="ink.on-fill"
          text "Add" class=Label color="inherit"
      for n in notes key=n.id
        text n.text padding="12px 0" border-bottom="1px solid line.subtle" font-size="1.0625rem"
      if notes.length == 0
        text "No notes yet." color="ink.muted" font-style="italic"
