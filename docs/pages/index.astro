---
// The landing page: what Imp is, in Imp's Catalogue look, with the one command that installs it.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
const install = "curl -fsSL https://github.com/peelar/imp/releases/latest/download/install-host.sh | sh";

const features = [
	{
		n: "01",
		title: "Chat is home",
		body: "Ask for something and the imp does it, on a Linux computer of its own. Watch it work there, or take over.",
	},
	{
		n: "02",
		title: "Apps that stay",
		body: "Ask for a tool and the imp builds an app you keep using: a screen for you, and operations it can run for you.",
	},
	{
		n: "03",
		title: "Yours, on your tailnet",
		body: "The host runs on your machine behind Tailscale. Your data, memories and keys never leave it.",
	},
	{
		n: "04",
		title: "Keys it never sees",
		body: "API keys live in a vault on the host and are added to requests as they leave. The imp only holds stand-ins.",
	},
];

const steps = [
	{ title: "Install the host", body: "One command on a Linux or macOS machine with Node 24 and Tailscale." },
	{ title: "Sign in with ChatGPT", body: "Your Plus or Pro plan is the model. Approve the code from any device." },
	{ title: "Give it a computer", body: "An E2B sandbox on the free plan, or a Linux computer of yours on the tailnet." },
];
---

<PageLayout
	site={{ title: config.title, description: config.description }}
	logo={config.logo}
	banner={config.banner}
	analytics={config.analytics}
	navigation={data.navigation}
	favicon={config.favicon}
	fontCssVars={data.fontCssVars}
	themeMode={config.theme.mode}
	searchEnabled={config.search.enabled}
	siteUrl={config.site}
	ogEnabled={config.og.enabled}
	page={{ title: "Imp — your own self-hosted assistant", description: config.description }}
>
	<div class="imp">
		<section class="hero">
			<div class="hero-text">
				<p class="label">Self-hosted · Early prototype</p>
				<h1><span class="cap">Y</span>our own imp.</h1>
				<p class="lede">
					A self-hosted assistant that runs errands in your apps and builds new ones for you, on a computer of its
					own.
				</p>
				<div class="actions">
					<a class="button primary" href="/docs/self-hosting/install">Install your Imp</a>
					<a class="button" href="/docs">Read the docs</a>
				</div>
			</div>
			<figure class="art">
				<img src="/workshop.jpg" alt="An engraving of a workshop full of machines, papers flying around the person at the desk" width="1200" height="800" />
			</figure>
		</section>

		<section class="install">
			<p class="label">Install</p>
			<pre><code>{install}</code></pre>
			<p class="note">Installs the latest release in <code>~/.imp</code> as a service, serves it on your tailnet, and prints one link.</p>
		</section>

		<section class="features">
			{features.map((f) => (
				<article>
					<p class="label">{f.n}</p>
					<h2>{f.title}</h2>
					<p>{f.body}</p>
				</article>
			))}
		</section>

		<section class="steps">
			<h2>Running in three steps</h2>
			<ol>
				{steps.map((s) => (
					<li>
						<h3>{s.title}</h3>
						<p>{s.body}</p>
					</li>
				))}
			</ol>
			<p class="more">
				Then learn <a href="/docs/how-it-works/architecture">how it fits together</a>, <a href="/docs/how-it-works/vault">how the vault keeps your keys</a>, and <a href="/docs/building-apps">how to build an app</a>.
			</p>
		</section>
	</div>
</PageLayout>

<style>
	@font-face {
		font-family: "Pinyon Script";
		src: url("/fonts/PinyonScript-Regular.ttf") format("truetype");
		font-display: swap;
	}
	.imp {
		--ink: light-dark(#111111, #f2f2f0);
		--muted: light-dark(#6b6b6b, #9b9b97);
		--line: light-dark(#e4e4e1, #262625);
		--soft: light-dark(#f3f3f1, #1b1b1a);
		--accent: light-dark(#2341d6, #5b74f2);
		color-scheme: light;
		color: var(--ink);
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
		font-family: var(--blume-font-body, "Newsreader", Georgia, serif);
	}
	:global([data-theme="dark"]) .imp {
		color-scheme: dark;
	}
	.label {
		font-family: var(--blume-font-mono, "IBM Plex Mono", monospace);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0;
	}
	h1,
	h2,
	h3 {
		font-family: var(--blume-font-display, "Instrument Serif", Georgia, serif);
		font-weight: 400;
		letter-spacing: -0.01em;
		margin: 0;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: 3rem;
		align-items: center;
		padding: 4.5rem 0 3.5rem;
		border-bottom: 1px solid var(--line);
	}
	.hero h1 {
		font-size: clamp(3.25rem, 7vw, 5.5rem);
		line-height: 0.95;
		margin: 1rem 0 1.25rem;
	}
	.cap {
		font-family: "Pinyon Script", "Snell Roundhand", serif;
		font-size: 1.2em;
		line-height: 0;
	}
	.lede {
		font-size: 1.3rem;
		line-height: 1.45;
		max-width: 30rem;
		margin: 0;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.button {
		font-family: var(--blume-font-mono, "IBM Plex Mono", monospace);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.8rem 1.1rem;
		border: 1px solid var(--ink);
		color: var(--ink);
		text-decoration: none;
	}
	.button:hover {
		background: var(--soft);
	}
	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}
	.button.primary:hover {
		filter: brightness(1.1);
	}
	.art {
		margin: 0;
		border: 1px solid var(--line);
	}
	.art img {
		display: block;
		width: 100%;
		height: auto;
	}
	.install {
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--line);
	}
	.install pre {
		margin: 0.75rem 0;
		padding: 1rem 1.25rem;
		background: var(--soft);
		border: 1px solid var(--line);
		overflow-x: auto;
		font-family: var(--blume-font-mono, "IBM Plex Mono", monospace);
		font-size: 0.9rem;
	}
	.install .note {
		color: var(--muted);
		margin: 0;
	}
	.install .note code {
		font-family: var(--blume-font-mono, "IBM Plex Mono", monospace);
		font-size: 0.9em;
	}
	.features {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-bottom: 1px solid var(--line);
	}
	.features article {
		padding: 2.25rem 1.5rem 2.5rem 0;
	}
	.features article + article {
		padding-left: 1.5rem;
		border-left: 1px solid var(--line);
	}
	.features h2 {
		font-size: 1.75rem;
		line-height: 1.1;
		margin: 0.75rem 0 0.6rem;
	}
	.features p:not(.label) {
		margin: 0;
		line-height: 1.5;
		color: var(--muted);
	}
	.steps {
		padding-top: 3rem;
	}
	.steps > h2 {
		font-size: 2.5rem;
	}
	.steps ol {
		list-style: none;
		counter-reset: step;
		padding: 0;
		margin: 1.75rem 0 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.steps li {
		counter-increment: step;
		border-top: 2px solid var(--ink);
		padding-top: 1rem;
	}
	.steps li::before {
		content: "0" counter(step);
		font-family: var(--blume-font-mono, "IBM Plex Mono", monospace);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.steps h3 {
		font-size: 1.5rem;
		margin: 0.4rem 0 0.4rem;
	}
	.steps li p {
		margin: 0;
		color: var(--muted);
		line-height: 1.5;
	}
	.more {
		margin-top: 2.5rem;
		font-size: 1.1rem;
	}
	.more a {
		color: var(--accent);
	}
	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			padding-top: 3rem;
		}
		.features {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.features article:nth-child(3) {
			border-left: none;
			padding-left: 0;
		}
		.steps ol {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 560px) {
		.features {
			grid-template-columns: 1fr;
		}
		.features article + article {
			border-left: none;
			padding-left: 0;
			border-top: 1px solid var(--line);
		}
	}
</style>
