// The computer: its screen, its Settings, and the onboarding's choice of computer (Imp cloud, a container on this
// machine, or a computer of yours on the tailnet).

use Label, rise, Body, Control, Heading, Lead, Mono, Small, Subheading, Title from "./look.contract"
use Button from "./controls.contract"
use Computer from "./host.contract"
use WizardTitle, WizardFold from "./onboarding.contract"

fn computerStatus(status: string): string =
  status == "ready" ? "Ready" : status == "starting" ? "Starting…" : status == "failed" ? "Not reachable" : "Not chosen yet"

// The Computer tab: the computer's live screen, which the host serves as a page of its own, while the computer is ready;
// otherwise what it is doing, or a way to choose one.
component ComputerScreen
  props
    computer: Computer
    src: string
    shown: bool
    openTab: action
    setUp: action
  view
    column flex=1 min-height=0 testId="computer-page"
      row align-items="center" gap="space.sm" padding="space.sm space.lg" border-bottom="1px solid line.subtle"
        row width=6 height=6 aria-hidden=true
          background-color=(computer.status == "ready" ? "ink.success" : computer.status == "failed" ? "ink.danger" : "ink.faint")
        text (computer.name == "" ? "No computer yet" : computer.name) class=Body flex=1 min-width=0
          line-clamp=1 testId="computer-page-name"
        text computerStatus(computer.status) class=Label testId="computer-page-status"
        if computer.status == "ready"
          Button(press=openTab, variant="secondary", disabled=false, testId="computer-new-tab")
            text "New window"
            text "↗" aria-hidden=true class=Mono
      // Connected only while the tab is open: a watched screen keeps the computer awake.
      if computer.status == "ready" and shown
        iframe src=src title="Your imp's computer" testId="computer-frame" flex=1 min-height=0 width="100%"
          border="none"
      else if computer.status != "ready"
        column flex=1 min-height=0 align-items="center" justify-content="center" gap="space.ms" padding="space.lg space.md"
          text-align="center" testId="computer-waiting"
          image (computer.kind == "cloud" ? "symbol:icon.cloud" : "symbol:icon.computer") width=28 height=28 aria-hidden=true
          text (computer.status == "none" ? "Your imp has no computer yet." : computer.status == "failed" ? `Could not reach ${computer.name}.` : `Starting ${computer.name}…`)
            class=Title max-width="30rem"
          text (computer.status == "none" ? "Give it Imp cloud, a Linux computer of yours on Tailscale, or this machine." : computer.status == "failed" ? computer.error : "A computer that slept wakes up in a few seconds.")
            color="ink.muted" class=Body max-width="measure.note" overflow-wrap="anywhere"
          if computer.status == "none" or computer.status == "failed"
            button press=setUp testId="computer-set-up" padding="space.sm space.ms" border="1px solid line.strong"
              background-color="transparent" color="ink.strong"
              :hover
                background-color="surface.soft"
              text "Open Settings" class=Label color="inherit"

// Where the agent works: the machine now, Imp cloud's sizes, and the computers on the person's tailnet with the two
// things to do once so one of them can be chosen.
component ComputerSettings
  props
    computer: Computer
    switching: bool
    switchError: string
    refreshing: bool
    useContainer: action
    useCloud: action
    setCloudKey: action
    useOwn: action
    refresh: action
    retry: action
    openScreen: action
    copyPrompt: action
  state settingUp = false
  state keyDraft = ""
  derive usable = computer.devices.filter(d => d.problem == "").length
  action toggleSetup
    settingUp = not settingUp
  action editKey(v: string)
    keyDraft = v
  view
    column
      row gap="space.ms" align-items="center" padding="space.md 0" border-bottom="1px solid line.subtle"
        row width="2.75rem" height="2.75rem" min-width="2.75rem" align-items="center" justify-content="center"
          border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
          image (computer.kind == "cloud" ? "symbol:icon.cloud" : "symbol:icon.computer") width=20 height=20
        column flex=1 min-width=0 gap="space.xs" align-items="flex-start"
          text (computer.name == "" ? "No computer yet" : computer.name) class=Heading
            overflow-wrap="anywhere" testId="computer-name"
          row gap="space.sm" align-items="center"
            row width=6 height=6 aria-hidden=true
              background-color=(computer.status == "ready" ? "ink.success" : computer.status == "failed" ? "ink.danger" : "ink.faint")
            text computerStatus(computer.status) class=Label testId="computer-status"
        if computer.status == "failed"
          Button(press=retry, variant="secondary", disabled=false, testId="computer-retry")
            text "Retry"
        if computer.status == "ready"
          Button(press=openScreen, variant="secondary", disabled=false, testId="computer-open-screen")
            text "Open screen"
            text "→" aria-hidden=true
      if computer.status == "failed" and computer.error != ""
        row gap="space.sm" align-items="flex-start" padding="space.sm space.ms" margin-top="space.ms" background-color="danger.soft"
          border-left="2px solid ink.danger"
          image "symbol:icon.alert" color="ink.danger" width=16 height=16 aria-hidden=true
          text computer.error class=Body flex=1 min-width=0 overflow-wrap="anywhere" testId="computer-error"
      if computer.kind == "dev"
        text "This host fixes the computer for development, so there is nothing to choose." class=Body
          color="ink.muted" padding-top="space.sm"
      else
        if switchError != "" and not switching
          text switchError color="ink.danger" class=Body padding-top="space.sm" testId="computer-switch-error"
        column gap="space.sm" padding-top="space.lg"
          text "Imp cloud" class=Subheading role="heading" aria-level=3
          text (computer.cloudAvailable ? "Sleeps when idle, keeps its files." : "Paste an API key from e2b.dev/dashboard.")
            class=Body color="ink.muted"
          if not computer.cloudAvailable
            row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.ms" border="1px solid line.strong"
              input type="password" value=keyDraft input=editKey submit=setCloudKey(keyDraft.trim()) placeholder="e2b_…"
                aria-label="E2B API key" testId="computer-cloud-key" flex=1 min-width=0 padding="space.sm 0" border="none"
                background-color="transparent" outline="none" class=Mono color="ink.strong"
              Button(press=setCloudKey(keyDraft.trim()), variant="primary", disabled=(keyDraft.trim() == "" or switching), testId="computer-cloud-key-save")
                text "Save"
          row role="radiogroup" aria-label="Imp cloud size"
            for z, i in computer.sizes key=z.id
              button role="radio" aria-checked=(computer.kind == "cloud" and computer.size == z.id) press=useCloud(z.id)
                disabled=(not computer.cloudAvailable or switching) flex=1 testId=`computer-size-${z.id}`
                padding="space.sm space.xs" border="1px solid line.strong" margin-left=(i == 0 ? "0" : "-1px")
                background-color=(computer.kind == "cloud" and computer.size == z.id ? "ink.strong" : "transparent")
                color=(computer.kind == "cloud" and computer.size == z.id ? "surface.page" : "ink.strong")
                class=Label
                :disabled
                  color="ink.faint"
                text z.label
        column gap="space.sm" padding-top="space.lg"
          row align-items="center" gap="space.sm"
            text "Your computer" class=Subheading role="heading" aria-level=3 flex=1
            button press=refresh disabled=refreshing aria-label="Look for computers again" testId="computer-refresh"
              appearance="none" width=32 height=32 padding=0 display="flex" align-items="center" justify-content="center"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                background-color="surface.soft"
              image "symbol:icon.refresh" width=15 height=15
          text "A Linux machine on your tailnet."
            class=Body color="ink.muted"
          if computer.tailnetError != ""
            text computer.tailnetError class=Body color="ink.danger" testId="computer-tailnet-error"
          column border-top="1px solid line.subtle"
            for d in computer.devices key=d.id
              button press=useOwn(d.id) disabled=(d.problem != "" or switching)
                aria-pressed=(computer.kind == "own" and computer.device == d.id) testId=`computer-device-${d.name}`
                display="flex" align-items="center" gap="space.ms" padding="space.ms 0" background-color="transparent" border="none"
                border-bottom="1px solid line.subtle" text-align="start" color="ink.strong"
                :hover
                  background-color="surface.soft"
                image "symbol:icon.computer" width=16 height=16 aria-hidden=true
                  color=(d.problem == "" ? "ink.strong" : "ink.faint")
                column flex=1 min-width=0 gap="space.xxs"
                  text d.name class=Lead color=(d.problem == "" ? "ink.strong" : "ink.muted")
                  if d.problem != ""
                    text d.problem class=Small color="ink.muted" font-style="italic"
                text (computer.kind == "own" and computer.device == d.id ? "In use" : d.problem == "" ? "Use" : "")
                  class=Label color=(computer.kind == "own" and computer.device == d.id ? "ink.strong" : "AccentColor")
            if computer.devices.length == 0 and computer.tailnetError == ""
              text "No Linux computers on your tailnet yet." font-style="italic" color="ink.muted" padding="space.ms 0"
                border-bottom="1px solid line.subtle"
          if usable > 0
            button press=toggleSetup aria-expanded=settingUp testId="computer-add" align-self="flex-start" padding="space.xs 0"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                color="ink.strong"
              text (settingUp ? "Hide setup" : "Add a computer") class=Label color="inherit"
          if usable == 0 or settingUp
            column gap="space.sm" padding-top="space.sm"
              text "Give this prompt to a coding agent on the computer." class=Body color="ink.muted"
              SetupPrompt(prompt=computer.setupPrompt, copy=copyPrompt)
        column gap="space.sm" padding-top="space.lg" testId="computer-container-section"
          row align-items="center" gap="space.sm"
            text "This machine" class=Subheading role="heading" aria-level=3 flex=1
            text "Free" class=Label
          text "A container here, through Docker, OrbStack or Podman. Less isolated; the first start takes minutes."
            class=Body color="ink.muted"
          if computer.kind == "container"
            text "In use" class=Label color="ink.strong" testId="computer-container-in-use"
          else if computer.containerAvailable
            row
              Button(press=useContainer, variant="secondary", disabled=switching, testId="computer-container")
                text "Use this machine"
          else
            row gap="space.sm" align-items="flex-start"
              text computer.containerProblem class=Body font-style="italic" color="ink.muted" flex=1
                testId="computer-container-problem"
              button press=refresh disabled=refreshing testId="computer-container-again" padding="space.xs 0" border="none"
                background-color="transparent" color="ink.muted"
                :hover
                  color="ink.strong"
                text "Look again" class=Label color="inherit"

// Text to copy into a terminal or a file, set in mono, with Copy.
// A prompt for the person's coding agent: the setup to do, which the agent reads and the person only copies. It
// stays folded, so the person sees a prompt to hand over, not the commands and configuration inside it.
component SetupPrompt
  props
    prompt: string
    copy: action
  state open = false
  action toggle
    open = not open
  view
    column border="1px solid line.strong" testId="computer-setup-prompt"
      row align-items="center"
        button press=toggle aria-expanded=open testId="computer-setup-prompt-toggle" flex=1 display="flex"
          align-items="center" gap="space.sm" padding="space.sm space.ms" border="none" background-color="transparent" color="ink.muted"
          text-align="start"
          :hover
            color="ink.strong"
          text (open ? "−" : "+") class=Mono width="0.75rem" aria-hidden=true
          text "Setup prompt" class=Label color="inherit"
        Button(press=copy, variant="quiet", disabled=false, testId="computer-setup-prompt-copy")
          image "symbol:icon.copy" width=12 height=12 aria-hidden=true
          text "Copy"
      if open
        text prompt class=Mono white-space="pre-wrap"
          overflow-wrap="anywhere" padding="space.ms space.ms" border-top="1px solid line.subtle" background-color="surface.soft"
          max-height="18rem" overflow-y="auto" testId="computer-setup-prompt-text"

// That the onboarding is looking for something to appear by itself, so the person need not press anything.
component Watching
  view
    row gap="space.sm" align-items="center" testId="computer-watching"
      progress aria-label="Waiting"
      text "Waiting…" font-style="italic" color="ink.muted"

// A computer of the person's that the onboarding found ready, and the one press that makes it the imp's.
component FoundComputer
  props
    name: string
    press: action
    disabled: bool
    testId: string
  view
    button press=press disabled=disabled testId=testId display="flex" align-items="center" gap="space.ms"
      padding="space.sm space.sm space.sm space.ms" border="none" background-color="surface.soft" color="ink.strong"
      text-align="start"
      :hover
        background-color="line.subtle"
      :disabled
        color="ink.faint"
      row width=8 height=8 min-width=8 background-color="ink.success" aria-hidden=true
      text name flex=1 min-width=0 class=Subheading
        overflow-wrap="anywhere"
      text "Use →" class=Label padding="space.sm space.ms" background-color="AccentColor" color="ink.on-fill"

// Onboarding's second step: which computer, then only what that one needs. Settings has the full picture.
component ComputerWizard
  props
    computer: Computer
    switching: bool
    error: string
    useContainer: action
    setCloudKey: action
    useOwn: action
    copyPrompt: action
    choice: string
    toggle: action
    still: bool
  state keyDraft = ""
  derive usable = computer.devices.filter(d => d.problem == "")
  action editKey(v: string)
    keyDraft = v
  view
    column gap="space.ms" testId="onboarding-computer" animation=(still ? "none" : "rise 260ms ease-out both")
      WizardTitle(title="Give it a computer", note="Where your imp works.")
      WizardFold(label="Imp cloud", press=toggle("cloud"), testId="choose-cloud", primary=(choice == ""),
        open=(choice == "cloud"), disabled=false)
        row gap="space.xs" align-items="baseline" class=Body color="ink.muted"
          text "Paste a key from"
          link href="https://e2b.dev/dashboard" testId="computer-cloud-key-link" color="ink.strong"
            text "e2b.dev/dashboard"
          text "."
        row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.ms" border="1px solid line.strong"
          input type="password" value=keyDraft input=editKey submit=setCloudKey(keyDraft.trim()) placeholder="e2b_…"
            aria-label="E2B API key" testId="computer-cloud-key" flex=1 min-width=0 padding="space.sm 0" border="none"
            background-color="transparent" outline="none" class=Mono color="ink.strong"
          Button(press=setCloudKey(keyDraft.trim()), variant="primary", disabled=(keyDraft.trim() == "" or switching), testId="computer-cloud-key-save")
            text "Use"
      WizardFold(label="Your computer", press=toggle("own"), testId="choose-own", primary=false, open=(choice == "own"),
        disabled=false)
        if computer.tailnetError != ""
          text computer.tailnetError class=Body color="ink.danger" testId="computer-tailnet-error"
        else if usable.length == 0
          text "Give this prompt to a coding agent on a Linux computer." class=Body color="ink.muted"
          SetupPrompt(prompt=computer.setupPrompt, copy=copyPrompt)
          Watching()
        else
          text (usable.length == 1 ? "Found it" : `Found ${usable.length}`) class=Label color="ink.strong"
            testId="computer-found"
          for d in usable key=d.id
            FoundComputer(name=d.name, press=useOwn(d.id), disabled=switching, testId=`computer-device-${d.name}`)
      // No computer is not a choice: skipping gives the imp a container on the host's machine, which needs nothing.
      if computer.containerAvailable
        row
          Button(press=useContainer, variant="quiet", disabled=switching, testId="computer-skip")
            text "Skip, use a container here"
      else
        button press=toggle("container") aria-expanded=(choice == "container") testId="computer-skip"
          align-self="flex-start" padding="space.xs 0" border="none" background-color="transparent" color="ink.muted"
          :hover
            color="ink.strong"
          text "Skip, use a container here" class=Label color="inherit"
        if choice == "container"
          text computer.containerProblem class=Body color="ink.muted" testId="computer-container-problem"
          Watching()
      if switching
        row gap="space.sm" align-items="center"
          progress aria-label="Setting it up"
          text "Setting it up…" font-style="italic" color="ink.muted"
      else if error != ""
        text error color="ink.danger" class=Body testId="computer-switch-error"
