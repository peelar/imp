tamber imp

// Catalogue: white paper, black ink, one cobalt action, square corners, engraved art in greyscale. Headlines are
// Instrument Serif with a Pinyon Script capital, prose is Instrument Sans, labels and numbers are IBM Plex Mono.

theme
  AccentColor = light-dark(#2341d6, #5b74f2)
  Highlight = light-dark(#dfe4fb, #26305e)
  // The preview bar's fill: the accent, deep enough in the dark for its white labels to read.
  fill.preview = light-dark(#2341d6, #3550e0)
  HighlightText = light-dark(#111111, #f2f2f0)

  ink.strong = light-dark(#111111, #f2f2f0)
  ink.muted = light-dark(#6b6b6b, #9b9b97)  pair=surface.page
  ink.faint = light-dark(#a3a3a3, #64645f)
  ink.on-fill = #ffffff  scheme=fixed

  surface.page = light-dark(#ffffff, #0d0d0d)
  surface.soft = light-dark(#f3f3f1, #1b1b1a)
  line.subtle = light-dark(#e4e4e1, #262625)
  line.strong = light-dark(#c9c9c5, #3d3d3a)
  danger.soft = light-dark(#fdeeee, #3a1d20)

  family.display = "Instrument Serif", "Iowan Old Style", Georgia, serif
  family.text = "Instrument Sans", ui-sans-serif, system-ui, sans-serif
  family.script = "Pinyon Script", "Snell Roundhand", serif
  family.mono = "IBM Plex Mono", ui-monospace, monospace

icons
  // Every icon is Phosphor's (phosphor-icons.com, MIT), regular weight, copied from @phosphor-icons/core's
  // assets/regular/<name>.svg with its fill set to #000; Apple draws the SF Symbol named beside it. Add new ones the
  // same way, and draw none from Exact's built-in roles, so the shell keeps one set.
  icon.imp = icon(sf "face.smiling", svg "icons/imp.svg")
  icon.add = icon(sf "plus", svg "icons/add.svg")
  icon.alert = icon(sf "exclamationmark.circle", svg "icons/alert.svg")
  icon.archive = icon(sf "archivebox", svg "icons/archive.svg")
  icon.back = icon(sf "chevron.left", svg "icons/back.svg")
  icon.book = icon(sf "book", svg "icons/book.svg")
  icon.chart = icon(sf "chart.xyaxis.line", svg "icons/chart.svg")
  icon.check = icon(sf "checkmark", svg "icons/check.svg")
  icon.close = icon(sf "xmark", svg "icons/close.svg")
  icon.cloud = icon(sf "cloud", svg "icons/cloud.svg")
  icon.compose = icon(sf "square.and.pencil", svg "icons/compose.svg")
  icon.computer = icon(sf "desktopcomputer", svg "icons/computer.svg")
  icon.copy = icon(sf "doc.on.doc", svg "icons/copy.svg")
  icon.delete = icon(sf "trash", svg "icons/delete.svg")
  icon.document = icon(sf "doc.text", svg "icons/document.svg")
  icon.expand = icon(sf "arrow.up.left.and.arrow.down.right", svg "icons/expand.svg")
  icon.github = icon(sf "chevron.left.forwardslash.chevron.right", svg "icons/github.svg")
  icon.home = icon(sf "house", svg "icons/home.svg")
  icon.layers = icon(sf "square.grid.2x2", svg "icons/layers.svg")
  icon.link = icon(sf "link", svg "icons/link.svg")
  icon.lock = icon(sf "lock", svg "icons/lock.svg")
  icon.menu = icon(sf "line.3.horizontal", svg "icons/menu.svg")
  icon.messages = icon(sf "bubble.left.and.bubble.right", svg "icons/messages.svg")
  icon.microphone = icon(sf "mic", svg "icons/microphone.svg")
  icon.moon = icon(sf "moon", svg "icons/moon.svg")
  icon.notifications = icon(sf "bell", svg "icons/notifications.svg")
  icon.open = icon(sf "arrow.up.forward.square", svg "icons/open.svg")
  icon.pencil = icon(sf "pencil", svg "icons/pencil.svg")
  icon.people = icon(sf "person.2", svg "icons/people.svg")
  icon.person = icon(sf "person", svg "icons/person.svg")
  icon.pin = icon(sf "mappin", svg "icons/pin.svg")
  icon.play = icon(sf "play", svg "icons/play.svg")
  icon.refresh = icon(sf "arrow.clockwise", svg "icons/refresh.svg")
  icon.repeat = icon(sf "repeat", svg "icons/repeat.svg")
  icon.restore = icon(sf "arrow.uturn.backward", svg "icons/restore.svg")
  icon.search = icon(sf "magnifyingglass", svg "icons/search.svg")
  icon.send = icon(sf "arrow.up", svg "icons/send.svg")
  icon.settings = icon(sf "gearshape", svg "icons/settings.svg")
  icon.sign-out = icon(sf "rectangle.portrait.and.arrow.right", svg "icons/sign-out.svg")
  icon.sparkles = icon(sf "sparkles", svg "icons/sparkles.svg")
  icon.star = icon(sf "star", svg "icons/star.svg")
  icon.stop = icon(sf "stop.fill", svg "icons/stop.svg")
  icon.terminal = icon(sf "terminal", svg "icons/terminal.svg")
  icon.todos = icon(sf "checklist", svg "icons/todos.svg")
