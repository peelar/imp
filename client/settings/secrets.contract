// Settings' Secrets: the owner's keys and logins, what the imp asked for, and the latest uses. Never a value.

use Label, Body, Lead, Mono, Small from "../look.contract"
use Button, ErrorNote from "../controls.contract"
use Secret, Secrets from "../host.contract"
use Confirm, SettingsPage, SettingsSection, SettingsRow, SettingsEmpty, SettingsFoot, SettingsError from "../parts.contract"

// A secret as the person knows it: a known service's own name ("GitHub" for the key named github), else its name.
fn shownName(x: Secret): string = x.name == x.service ? x.label : x.name

fn secretLabel(name: string, secrets: Secret[]): string =
  match first(secrets.filter(x => x.name == name)) { case some(x) => shownName(x), case none => name }

// The owner's secrets in Settings: the API keys the imp uses on its computer without seeing them, and the logins the
// host types into its Chrome; a form to add either (a value is never shown again once saved), what the imp asked for,
// and its latest uses. A login's form uses `hosts` for its site and `value` for its password.
component SecretSettings
  props
    secrets: Secrets
    saving: bool
    error: string
    loginError: string
    deleteError: string
    save: action
    saveLogin: action
    remove: action
    dismiss: action
  state adding = ""
  state name = ""
  state value = ""
  state hosts = ""
  state header = ""
  state prefix = ""
  state envName = ""
  state username = ""
  state otp = ""
  // The secret Delete asks about.
  state deleting = ""
  derive replacing = secrets.secrets.filter(x => x.name == name).length > 0
  derive login = adding == "login"
  derive formLabel = match first(secrets.services.filter(x => x.id == adding)) { case some(x) => x.label, case none => "Other" }
  derive ready = login ? (hosts.trim() != "" and username.trim() != "" and (value != "" or replacing)) : (value.trim() != "" and name.trim() != "")
  derive formError = login ? loginError : error
  // The last section's name: what its form adds, or what it offers to add.
  derive formTitle = (adding == "" ? "Add a secret" : replacing ? `Replace ${secretLabel(name, secrets.secrets)}` : login ? "Add a login"
    : adding == "other" ? "Add a key for another service" : `Add your ${formLabel} key`)
  action pick(service: string)
    adding = service
    name = (service == "other" or service == "login") ? "" : service
  action ask(service: string, wanted: string, host: string)
    adding = service
    name = wanted
    hosts = host
  action replace(service: string, secret: string, site: string, user: string)
    adding = service
    name = secret
    hosts = site
    username = user
  action cancel
    adding = ""
    name = ""
    value = ""
    hosts = ""
    username = ""
    otp = ""
  action editName(v: string)
    name = v
  action editValue(v: string)
    value = v
  action editHosts(v: string)
    hosts = v
  action editHeader(v: string)
    header = v
  action editPrefix(v: string)
    prefix = v
  action editEnv(v: string)
    envName = v
  action editUsername(v: string)
    username = v
  action editOtp(v: string)
    otp = v
  action askRemove(secret: string)
    deleting = secret
    showModal("confirm-secret-delete")
  action confirmRemove
    remove(deleting)
    deleting = ""
  action submit
    if ready and not saving
      if login
        saveLogin(name.trim(), hosts, username, value, otp)
      else
        save(name.trim(), adding, value.trim(), hosts, header, prefix, envName)
  view
    SettingsPage(intro="Keys and logins your imp uses without ever seeing them.", testId="secrets")
      if secrets.status == "failed"
        ErrorNote(message=secrets.error, testId="secrets-error")
      if secrets.requests.length > 0
        SettingsSection(title="Asked for", aside="", asideTestId="", note="", testId="")
          for q, k in secrets.requests key=q.id
            SettingsRow(testId=`secret-request-${k}`)
              column flex=1 min-width=0 gap="space.xxs"
                text `Your imp asks for ${q.name}` class=Lead overflow-wrap="anywhere"
                text q.why class=Small color="ink.muted" overflow-wrap="anywhere"
              Button(press=ask(q.service, q.name, q.host), variant="primary", disabled=false, testId=`secret-request-add-${k}`)
                text "Add"
              button press=dismiss(q.id) aria-label=`Dismiss the request for ${q.name}` testId=`secret-request-dismiss-${k}`
                cursor="pointer"
                appearance="none" width=28 height=28 padding=0 display="flex" align-items="center" justify-content="center"
                border="none" background-color="transparent" color="ink.faint"
                :hover
                  color="ink.strong"
                image "symbol:icon.close" width=11 height=11
      SettingsSection(title="Keys and logins", aside="", asideTestId="", note="", testId="")
        if secrets.secrets.length == 0
          SettingsEmpty(message=(secrets.status == "starting" ? "Opening the vault…" : "No secrets yet."), testId="secrets-empty")
        for x, i in secrets.secrets key=x.name
          SettingsRow(testId=`secret-${i}`)
            image (x.kind == "login" ? "symbol:icon.person" : "symbol:icon.lock") width=16 height=16 aria-hidden=true
            column flex=1 min-width=0 gap="space.xxs"
              text shownName(x) class=Lead overflow-wrap="anywhere" testId=`secret-name-${i}`
              text x.detail class=Mono color="ink.muted" overflow-wrap="anywhere"
                testId=`secret-detail-${i}`
              text (x.lastUsed == "" ? `Added ${x.updated}, not used yet` : `Used ${x.lastUsed}`) class=Small
                color="ink.muted" testId=`secret-used-${i}`
            button press=replace(x.service, x.name, x.site, x.username) aria-label=`Replace ${shownName(x)}`
              cursor="pointer"
              testId=`secret-replace-${i}` appearance="none" padding="space.xs 0"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                color="ink.strong"
              text "Replace" class=Label color="inherit"
            button press=askRemove(x.name) aria-label=`Delete ${shownName(x)}` testId=`secret-delete-${i}` appearance="none"
              cursor="pointer"
              padding="space.xs 0" border="none" background-color="transparent" color="ink.muted"
              :hover
                color="ink.danger"
              text "Delete" class=Label color="inherit"
        SettingsError(message=deleteError, testId="secret-delete-error")
        Confirm(id="confirm-secret-delete", question=`Delete ${secretLabel(deleting, secrets.secrets)}?`,
          message="Your imp can no longer use it, and its value can't be brought back. Add it again to use it.",
          label="Delete", confirm=confirmRemove, testId="secret-delete")
      SettingsSection(title=formTitle, aside="", asideTestId="", note="", testId="")
        if adding == ""
          SettingsFoot(testId="")
            row flex-wrap="wrap" gap="space.sm"
              for v in secrets.services key=v.id
                Button(press=pick(v.id), variant="secondary", disabled=false, testId=`secret-add-${v.id}`)
                  text v.label
              Button(press=pick("other"), variant="secondary", disabled=false, testId="secret-add-other")
                text "Other"
              Button(press=pick("login"), variant="secondary", disabled=false, testId="secret-add-login")
                text "Login"
        else
          SettingsFoot(testId="secret-form")
            // Why the last save was refused, read before the fields it is about.
            if formError != "" and not saving
              ErrorNote(message=formError, testId="secret-error")
            if adding == "other" and not replacing
              column gap="space.sm"
                input value=name input=editName placeholder="Name, such as weather" aria-label="Name" testId="secret-name"
                  padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent" class=Body
                  color="ink.strong"
                input value=hosts input=editHosts placeholder="Hosts, such as api.example.com" aria-label="Hosts"
                  testId="secret-hosts" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
                  class=Mono color="ink.strong"
                row gap="space.sm"
                  input value=header input=editHeader placeholder="Header, such as Authorization" aria-label="Header"
                    testId="secret-header" flex=1 min-width=0 padding="space.sm space.ms" border="1px solid line.strong"
                    background-color="transparent" class=Mono color="ink.strong"
                  input value=prefix input=editPrefix placeholder="Before the key, such as Bearer" aria-label="Before the key"
                    testId="secret-prefix" flex=1 min-width=0 padding="space.sm space.ms" border="1px solid line.strong"
                    background-color="transparent" class=Mono color="ink.strong"
                input value=envName input=editEnv placeholder="Variable, such as WEATHER_API_KEY" aria-label="Variable"
                  testId="secret-env" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
                  class=Mono color="ink.strong"
            if login
              column gap="space.sm"
                input value=hosts input=editHosts placeholder="Site, such as github.com" aria-label="Site" testId="secret-site"
                  padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent" class=Mono
                  color="ink.strong"
                input value=username input=editUsername placeholder="Username or email" aria-label="Username"
                  testId="secret-username" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
                  class=Body color="ink.strong"
                input type="password" value=value input=editValue submit=submit
                  placeholder=(replacing ? "Password: leave empty to keep it" : "Password") aria-label="Password"
                  testId="secret-value" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
                  class=Mono color="ink.strong"
                input type="password" value=otp input=editOtp submit=submit
                  placeholder=(replacing ? "One-time-code key: leave empty to keep it" : "One-time-code key (optional)")
                  aria-label="One-time-code key" testId="secret-otp" padding="space.sm space.ms" border="1px solid line.strong"
                  background-color="transparent" class=Mono color="ink.strong"
              text "Typed only into this site. For one-time codes, paste the otpauth:// link or setup key."
                class=Small color="ink.muted"
            else
              match first(secrets.services.filter(v => v.id == adding))
                case some(v)
                  text `Goes on requests to ${v.hosts}. Your imp reads it as ${v.env}.` class=Small color="ink.muted"
                case none
                  text "Sent in the Authorization header unless you name another."
                    class=Small color="ink.muted"
            if login
              row
                Button(press=submit, variant="primary", disabled=(not ready or saving), testId="secret-save")
                  text (saving ? "Saving" : "Save")
            else
              row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.ms" border="1px solid line.strong"
                input type="password" value=value input=editValue submit=submit
                  placeholder="Paste the key" aria-label="Key" testId="secret-value" flex=1 min-width=0 padding="space.sm 0" border="none"
                  background-color="transparent" outline="none" class=Mono color="ink.strong"
                Button(press=submit, variant="primary", disabled=(not ready or saving), testId="secret-save")
                  text (saving ? "Saving" : "Save")
            row
              Button(press=cancel, variant="quiet", disabled=false, testId="secret-cancel")
                text "Cancel"
      if secrets.uses.length > 0
        SettingsSection(title="Recent use", aside="", asideTestId="", note="", testId="")
          for u, j in secrets.uses key=u.id
            SettingsRow(testId=`secret-use-${j}`)
              text u.secret class=Small min-width="5rem"
              text u.what class=Mono color="ink.muted" flex=1 min-width=0 overflow-wrap="anywhere"
              text u.result class=Mono color=(u.failed ? "ink.danger" : "ink.muted")
              text u.when class=Small color="ink.muted"
