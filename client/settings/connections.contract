// Settings' Connections: the accounts the host signs in to, and what each one turns on. GitHub first: connecting
// signs in with a device code, and below it the person turns on Backup, which pushes their apps' code to it. Then the
// MCP servers the imp uses for the person.

use Label, Body, Code, ControlLarge, Heading, Mono, Subheading from "../look.contract"
use Button, ButtonLink, ErrorNote from "../controls.contract"
use Connection, Backup, McpServer from "../host.contract"
use Step from "../onboarding.contract"
use Confirm from "../parts.contract"

component ConnectionsSettings
  props
    github: Connection
    backup: Backup
    busy: bool
    connect: action
    cancel: action
    disconnect: action
    copyCode: action
    turnOn: action
    turnOff: action
  view
    column testId="connections"
      row padding-bottom="space.sm" border-bottom="1px solid ink.strong"
        text "GitHub" class=Label color="ink.strong" role="heading" aria-level=2
      if github.status == "on"
        row gap="space.ms" align-items="center" padding="space.md 0" border-bottom="1px solid line.subtle"
          column flex=1 min-width=0 gap="space.xs" align-items="flex-start"
            text (github.login == "" ? "Connected" : `@${github.login}`) class=Heading
              overflow-wrap="anywhere" testId="github-login"
            text "Your apps, your imp and Backup reach GitHub as you." class=Body color="ink.muted"
          Button(press=disconnect, variant="quiet-danger", disabled=busy, testId="github-disconnect")
            text "Disconnect"
      else
        column padding="space.md 0" border-bottom="1px solid line.subtle"
          GithubSignIn(github=github, busy=busy, connect=connect, cancel=cancel, copyCode=copyCode,
            note="Sign in once, and your apps, your imp and Backup reach GitHub as you.", prefix="")
      // Once on, only Disconnect can fail; before, the sign-in shows its own error.
      if github.status == "on" and github.error != ""
        ErrorNote(message=github.error, testId="github-error")
      // Backup: what the connection turns on. Every version stays on the host either way.
      column testId="backup" padding="space.md 0" gap="space.ms" border-bottom="1px solid line.subtle"
        row gap="space.ms" align-items="baseline"
          text "Backup" class=Subheading flex=1
          text `${backup.versions} ${backup.versions == 1 ? "version" : "versions"} kept` class=Label testId="backup-versions"
        text (not backup.git ? "Needs git on your host. Install it, then restart Imp."
          : github.status != "on" ? "Your host keeps every version of your apps' code. Connect GitHub to keep a private copy there too."
          : "Your host keeps every version of your apps' code. Push a private copy to your imp-apps repository on GitHub.")
          class=Body color="ink.muted"
        if backup.status == "on"
          row gap="space.ms" align-items="center"
            column flex=1 min-width=0 gap="space.xs" align-items="flex-start"
              text backup.repo class=Mono overflow-wrap="anywhere" testId="backup-repo"
              row gap="space.sm" align-items="center"
                row width=6 height=6 aria-hidden=true background-color=(backup.synced ? "ink.success" : "ink.faint")
                text (backup.synced ? "Up to date" : "Not backed up yet") class=Label testId="backup-state"
            ButtonLink(href=`https://github.com/${backup.repo}`, variant="secondary", testId="backup-open-repo")
              text "Open"
              text "↗" aria-hidden=true
          row
            Button(press=turnOff, variant="quiet-danger", disabled=busy, testId="backup-turn-off")
              text "Turn off"
        else if backup.status == "starting"
          row gap="space.sm" align-items="center" testId="backup-starting"
            progress aria-label="Loading"
            text "Finding your imp-apps repository…" font-style="italic" color="ink.muted"
        else
          row
            Button(press=turnOn, variant="secondary", disabled=(not backup.git or github.status != "on" or busy), testId="backup-turn-on")
              text "Turn on backup"
        if backup.error != ""
          ErrorNote(message=backup.error, testId="backup-error")

// Connecting GitHub, until it is on: the button, then GitHub's code to enter on its sign-in page, and why the last
// try failed. Settings shows it, and so does an app's page while the app waits for GitHub, in the same look.
component GithubSignIn
  props
    github: Connection
    busy: bool
    connect: action
    cancel: action
    copyCode: action
    note: string
    // Before each testId, so the same sign-in on two screens stays two things to tap.
    prefix: string
  view
    column gap="space.ms" align-items="stretch"
      if github.status == "waiting"
        column gap="space.sm" testId=`${prefix}github-waiting`
          Step(number="01", title="Open GitHub's sign-in page")
          link href=github.url testId=`${prefix}github-open` display="flex" align-items="center" justify-content="center"
            gap="space.sm" padding="space.ms space.md" border="1px solid AccentColor" background-color="AccentColor"
            color="ink.on-fill" class=ControlLarge text-decoration-line="none"
            text "Open GitHub"
            image "symbol:icon.open" width=14 height=14 aria-hidden=true
          Step(number="02", title="Enter this code")
          row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.md" border="1px solid line.strong"
            text github.code flex=1 class=Code
              user-select="all" testId=`${prefix}github-code`
            Button(press=copyCode, variant="secondary", disabled=false, testId=`${prefix}github-copy`)
              image "symbol:icon.copy" width=13 height=13 aria-hidden=true
              text "Copy"
          row gap="space.sm" align-items="center" padding-top="space.xxs"
            progress aria-label="Waiting for approval"
            text "Waiting for you to approve…" font-style="italic" color="ink.muted"
          row
            Button(press=cancel, variant="quiet", disabled=false, testId=`${prefix}github-cancel`)
              text "Cancel"
      else if github.status == "starting"
        row gap="space.sm" align-items="center" testId=`${prefix}github-starting`
          progress aria-label="Loading"
          text "Asking GitHub for a code…" font-style="italic" color="ink.muted"
      else
        column gap="space.ms" align-items="flex-start"
          if note != ""
            text note class=Body color="ink.muted"
          Button(press=connect, variant="primary", disabled=busy, testId=`${prefix}github-connect`)
            text "Connect GitHub"
      if github.error != ""
        ErrorNote(message=github.error, testId=`${prefix}github-error`)

// The MCP servers the owner added, such as Linear, Notion or Sentry: the imp finds and runs their tools, and asks
// before it changes anything in one. Signing in opens the server's own sign-in page; its tokens, or a key pasted here,
// stay in the vault, and are never shown again.
component McpServerSettings
  props
    servers: McpServer[]
    adding: bool
    error: string
    removeError: string
    add: action
    signIn: action
    cancel: action
    remove: action
  state name = ""
  state url = ""
  state key = ""
  // The server Remove asks about.
  state removing = ""
  derive ready = name.trim() != "" and url.trim() != ""
  action editName(v: string)
    name = v
  action editUrl(v: string)
    url = v
  action editKey(v: string)
    key = v
  action submit
    if ready and not adding
      add(name.trim(), url.trim(), key.trim())
  action askRemove(id: string)
    removing = id
    showModal("confirm-server-remove")
  action confirmRemove
    remove(removing)
    removing = ""
  view
    column testId="mcp-servers" padding-top="space.lg"
      row padding-bottom="space.sm" border-bottom="1px solid ink.strong"
        text "MCP servers" class=Label color="ink.strong" role="heading" aria-level=2
      if servers.length == 0
        text "Add a service's MCP server, and your imp can use it for you: it asks before it changes anything there."
          class=Body color="ink.muted" padding="space.md 0" border-bottom="1px solid line.subtle" testId="mcp-empty"
      for x, i in servers key=x.id
        column gap="space.sm" padding="space.md 0" border-bottom="1px solid line.subtle" testId=`mcp-server-${i}`
          row gap="space.ms" align-items="center"
            column flex=1 min-width=0 gap="space.xxs"
              text x.name class=Heading overflow-wrap="anywhere" testId=`mcp-name-${i}`
              text x.url class=Mono color="ink.muted" overflow-wrap="anywhere"
              text (x.status == "on" ? (x.tools < 0 ? "Connected" : `Connected · ${x.tools} ${x.tools == 1 ? "tool" : "tools"}`)
                : x.status == "starting" ? "Asking the server…" : x.status == "waiting" ? "Waiting for you to sign in…"
                : "Not signed in") class=Label testId=`mcp-status-${i}`
            if x.status == "off"
              Button(press=signIn(x.id), variant="secondary", disabled=false, testId=`mcp-sign-in-${i}`)
                text "Sign in"
            else if x.status == "on"
              Button(press=signIn(x.id), variant="quiet", disabled=false, testId=`mcp-sign-in-${i}`)
                text "Sign in again"
            Button(press=askRemove(x.id), variant="quiet-danger", disabled=false, testId=`mcp-remove-${i}`)
              text "Remove"
          if x.status == "waiting"
            row gap="space.sm" align-items="center"
              ButtonLink(href=x.signInUrl, variant="primary", testId=`mcp-open-${i}`)
                text `Open ${x.name}'s sign-in`
                text "↗" aria-hidden=true
              Button(press=cancel(x.id), variant="quiet", disabled=false, testId=`mcp-cancel-${i}`)
                text "Cancel"
          if x.error != ""
            ErrorNote(message=x.error, testId=`mcp-error-${i}`)
      Confirm(id="confirm-server-remove", question="Remove this server?",
        message="Your imp can no longer use it, and Imp forgets its sign-in. Your account there is untouched.",
        label="Remove", confirm=confirmRemove, testId="mcp-remove")
      if removeError != ""
        ErrorNote(message=removeError, testId="mcp-remove-error")
      column gap="space.sm" padding-top="space.md" testId="mcp-form"
        text "Add an MCP server" class=Subheading role="heading" aria-level=3
        input value=name input=editName placeholder="Name, such as Linear" aria-label="Name" testId="mcp-form-name"
          padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
        input value=url input=editUrl placeholder="Address, such as https://mcp.linear.app/mcp" aria-label="Address"
          testId="mcp-form-url" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
        input type="password" value=key input=editKey submit=submit placeholder="Key, if the server takes one instead of a sign-in"
          aria-label="Key" testId="mcp-form-key" padding="space.sm space.ms" border="1px solid line.strong"
          background-color="transparent"
        if error != ""
          ErrorNote(message=error, testId="mcp-form-error")
        row
          Button(press=submit, variant="primary", disabled=(not ready or adding), testId="mcp-form-add")
            text "Add server"
