// Settings' Connections: the accounts the host signs in to, and what each one turns on. GitHub first: connecting
// signs in with a device code. Then Backup: the host always keeps every version of the apps' code in a local git
// repository (host/src/backup/), and Copy to GitHub only adds a copy there, after the person confirms the repository it
// makes under their account and chooses who can see it. Then the MCP servers the imp uses for the person.

use Label, Body, Lead, Mono, Small, Title, Control from "../look.contract"
use Button, ButtonLink, ErrorNote, DeviceCode from "../controls.contract"
use Connection, Backup, McpServer from "../host.contract"
use Confirm, SettingsSection, SettingsRow, SettingsEmpty, SettingsFoot, SettingsError from "../parts.contract"

component ConnectionsSettings
  props
    github: Connection
    backup: Backup
    busy: bool
    connect: action
    cancel: action
    disconnect: action
    copyCode: action
    turnOn: action
    turnOff: action
  // Who can see the repository Copy to GitHub makes: private unless the person chooses public.
  state visibility = "private"
  action askTurnOn
    visibility = "private"
    showModal("confirm-backup")
  action choose(next: string)
    visibility = next
  view
    column gap="space.xl" testId="connections"
      SettingsSection(title="GitHub", aside="", asideTestId="", note="", testId="")
        if github.status == "on"
          SettingsRow(testId="")
            column flex=1 min-width=0 gap="space.xxs" align-items="flex-start"
              text (github.login == "" ? "Connected" : `@${github.login}`) class=Lead
                overflow-wrap="anywhere" testId="github-login"
              text "Your apps, your imp and Backup reach GitHub as you." class=Small color="ink.muted"
            Button(press=disconnect, variant="quiet-danger", disabled=busy, testId="github-disconnect")
              text "Disconnect"
        else
          column padding="space.ms 0" border-bottom="1px solid line.subtle"
            GithubSignIn(github=github, busy=busy, connect=connect, cancel=cancel, copyCode=copyCode,
              note="Sign in once, and your apps, your imp and Backup reach GitHub as you.", prefix="")
        // Once on, only Disconnect can fail; before, the sign-in shows its own error.
        if github.status == "on"
          SettingsError(message=github.error, testId="github-error")
      // Backup: every version always stays in a git repository on the host; GitHub only adds a copy of it.
      SettingsSection(title="Backup", aside=`${backup.versions} ${backup.versions == 1 ? "version" : "versions"} kept`,
        asideTestId="backup-versions",
        note=(not backup.git ? "Needs git on your host. Install it, then restart Imp."
          : "Your host always keeps every version of your apps' code, in a git repository on your host. You can also keep a copy on GitHub."),
        testId="backup")
        if backup.status == "on"
          SettingsRow(testId="")
            column flex=1 min-width=0 gap="space.xxs" align-items="flex-start"
              text "Copied to GitHub" class=Lead
              text backup.repo class=Mono color="ink.muted" overflow-wrap="anywhere" testId="backup-repo"
              row gap="space.sm" align-items="center"
                row width=6 height=6 aria-hidden=true background-color=(backup.synced ? "ink.success" : "ink.faint")
                text (backup.synced ? "Up to date" : "Not copied yet") class=Label testId="backup-state"
            ButtonLink(href=`https://github.com/${backup.repo}`, variant="secondary", testId="backup-open-repo")
              text "Open"
              text "↗" aria-hidden=true
            Button(press=turnOff, variant="quiet-danger", disabled=busy, testId="backup-turn-off")
              text "Stop copying"
        else if backup.status == "starting"
          SettingsEmpty(message="Finding your imp-apps repository on GitHub…", testId="backup-starting")
        else if backup.git and github.status != "on"
          SettingsEmpty(message="Connect GitHub above to copy your apps' code there.", testId="backup-needs-github")
        if backup.status == "off"
          SettingsFoot(testId="")
            row
              Button(press=askTurnOn, variant="secondary", disabled=(not backup.git or github.status != "on" or busy), testId="backup-turn-on")
                text "Copy to GitHub"
        SettingsError(message=backup.error, testId="backup-error")
      BackupConfirm(login=github.login, visibility=visibility, choose=choose, confirm=turnOn(visibility))

// What Copy to GitHub asks first: the repository it makes under the person's account, and who can see it, private
// unless they choose public. A repository of that name the person has already is used as it is.
component BackupConfirm
  props
    login: string
    visibility: string
    choose: action
    confirm: action
  derive repo = login == "" ? "imp-apps" : `${login}/imp-apps`
  derive account = login == "" ? "your GitHub account" : `your GitHub account, @${login}`
  view
    dialog id="confirm-backup" aria-label="Create a repository on GitHub?" width="min(30rem, calc(100vw - 32px))"
      box-sizing="border-box" padding=0 border="1px solid ink.strong" border-radius=0 background-color="surface.page"
      color="ink.strong" box-shadow="none" testId="backup-confirm"
      column gap="space.sm" padding="space.lg space.lg 0"
        text "Create a repository on GitHub?" class=Title role="heading" aria-level=2
        text `Imp creates the repository imp-apps under ${account}, and copies every version of your apps' code there. If you already have one by that name, Imp uses it as it is.` class=Body color="ink.muted"
        text repo class=Mono color="ink.strong" overflow-wrap="anywhere" testId="backup-confirm-repo"
      column gap="space.sm" padding="space.md space.lg 0"
        row role="radiogroup" aria-label="Who can see it"
          for v, i in ["private", "public"] key=v
            button role="radio" aria-checked=(visibility == v) press=choose(v) flex=1 testId=`backup-visibility-${v}`
              cursor="pointer"
              padding="space.sm 0" border="1px solid line.strong" margin-left=(i == 0 ? "0" : "-1px")
              background-color=(visibility == v ? "ink.strong" : "transparent")
              color=(visibility == v ? "surface.page" : "ink.strong")
              class=Control
              text (v == "private" ? "Private" : "Public")
        text (visibility == "private" ? "Only you, and people you invite, can see it."
          : "Anyone on the internet can see your apps' code.") class=Small color="ink.muted" testId="backup-visibility-note"
      row justify-content="flex-end" gap="space.sm" padding="space.md space.lg space.lg"
        button commandfor="confirm-backup" command="close" testId="backup-confirm-cancel" padding="space.sm space.ms"
          cursor="pointer" border="1px solid line.strong" border-radius=0 background-color="transparent" color="ink.strong"
          :hover
            background-color="surface.soft"
          text "Cancel" class=Label color="inherit"
        button press=confirm commandfor="confirm-backup" command="close" testId="backup-confirm-create"
          padding="space.sm space.ms" cursor="pointer" border="1px solid ink.strong" border-radius=0
          background-color="ink.strong" color="surface.page"
          :hover
            opacity=0.9
          text (visibility == "private" ? "Create private repository" : "Create public repository") class=Label color="inherit"

// Connecting GitHub, until it is on: the button, then GitHub's code to enter on its sign-in page (DeviceCode, as
// ChatGPT's sign-in shows it), and why the last try failed. Settings shows it, and so does an app's page while the
// app waits for GitHub, in the same look.
component GithubSignIn
  props
    github: Connection
    busy: bool
    connect: action
    cancel: action
    copyCode: action
    note: string
    // Before each testId, so the same sign-in on two screens stays two things to tap.
    prefix: string
  view
    column gap="space.ms" align-items="stretch"
      if github.status == "waiting"
        column gap="space.sm"
          DeviceCode(code=github.code, url=github.url, site="GitHub", copy=copyCode, prefix=`${prefix}github-`)
          row
            Button(press=cancel, variant="quiet", disabled=false, testId=`${prefix}github-cancel`)
              text "Cancel"
      else if github.status == "starting"
        row gap="space.sm" align-items="center" testId=`${prefix}github-starting`
          progress aria-label="Loading"
          text "Asking GitHub for a code…" font-style="italic" color="ink.muted"
      else
        column gap="space.ms" align-items="flex-start"
          if note != ""
            text note class=Body color="ink.muted"
          Button(press=connect, variant="primary", disabled=busy, testId=`${prefix}github-connect`)
            text "Connect GitHub"
      if github.error != ""
        ErrorNote(message=github.error, testId=`${prefix}github-error`)

// The MCP servers the owner added, such as Linear, Notion or Sentry: the imp finds and runs their tools, and asks
// before it changes anything in one. Signing in opens the server's own sign-in page; its tokens, or a key pasted here,
// stay in the vault, and are never shown again.
component McpServerSettings
  props
    servers: McpServer[]
    adding: bool
    error: string
    removeError: string
    add: action
    signIn: action
    cancel: action
    remove: action
  state name = ""
  state url = ""
  state key = ""
  // The server Remove asks about.
  state removing = ""
  derive ready = name.trim() != "" and url.trim() != ""
  action editName(v: string)
    name = v
  action editUrl(v: string)
    url = v
  action editKey(v: string)
    key = v
  action submit
    if ready and not adding
      add(name.trim(), url.trim(), key.trim())
  action askRemove(id: string)
    removing = id
    showModal("confirm-server-remove")
  action confirmRemove
    remove(removing)
    removing = ""
  view
    SettingsSection(title="MCP servers", aside="", asideTestId="",
      note="Your imp can use a service's MCP server for you, and asks before it changes anything there.", testId="mcp-servers")
      if servers.length == 0
        SettingsEmpty(message="No MCP servers yet.", testId="mcp-empty")
      for x, i in servers key=x.id
        column gap="space.sm" padding="space.ms 0" border-bottom="1px solid line.subtle" testId=`mcp-server-${i}`
          row gap="space.ms" align-items="center"
            column flex=1 min-width=0 gap="space.xxs"
              text x.name class=Lead overflow-wrap="anywhere" testId=`mcp-name-${i}`
              text x.url class=Mono color="ink.muted" overflow-wrap="anywhere"
              text (x.status == "on" ? (x.tools < 0 ? "Connected" : `Connected · ${x.tools} ${x.tools == 1 ? "tool" : "tools"}`)
                : x.status == "starting" ? "Asking the server…" : x.status == "waiting" ? "Waiting for you to sign in…"
                : "Not signed in") class=Label testId=`mcp-status-${i}`
            if x.status == "off"
              Button(press=signIn(x.id), variant="secondary", disabled=false, testId=`mcp-sign-in-${i}`)
                text "Sign in"
            else if x.status == "on"
              Button(press=signIn(x.id), variant="quiet", disabled=false, testId=`mcp-sign-in-${i}`)
                text "Sign in again"
            Button(press=askRemove(x.id), variant="quiet-danger", disabled=false, testId=`mcp-remove-${i}`)
              text "Remove"
          if x.status == "waiting"
            row gap="space.sm" align-items="center"
              ButtonLink(href=x.signInUrl, variant="primary", testId=`mcp-open-${i}`)
                text `Open ${x.name}'s sign-in`
                text "↗" aria-hidden=true
              Button(press=cancel(x.id), variant="quiet", disabled=false, testId=`mcp-cancel-${i}`)
                text "Cancel"
          if x.error != ""
            ErrorNote(message=x.error, testId=`mcp-error-${i}`)
      SettingsError(message=removeError, testId="mcp-remove-error")
      Confirm(id="confirm-server-remove", question="Remove this server?",
        message="Your imp can no longer use it, and Imp forgets its sign-in. Your account there is untouched.",
        label="Remove", confirm=confirmRemove, testId="mcp-remove")
      SettingsFoot(testId="mcp-form")
        text "Add an MCP server" class=Label color="ink.strong" role="heading" aria-level=3
        input value=name input=editName placeholder="Name, such as Linear" aria-label="Name" testId="mcp-form-name"
          padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
        input value=url input=editUrl placeholder="Address, such as https://mcp.linear.app/mcp" aria-label="Address"
          testId="mcp-form-url" padding="space.sm space.ms" border="1px solid line.strong" background-color="transparent"
        input type="password" value=key input=editKey submit=submit placeholder="Key, if the server takes one instead of a sign-in"
          aria-label="Key" testId="mcp-form-key" padding="space.sm space.ms" border="1px solid line.strong"
          background-color="transparent"
        if error != ""
          ErrorNote(message=error, testId="mcp-form-error")
        row
          Button(press=submit, variant="primary", disabled=(not ready or adding), testId="mcp-form-add")
            text "Add server"
