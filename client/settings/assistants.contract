// Settings' Assistants: other assistants on the tailnet, such as Claude Code or Cursor, using the apps the person shares
// with them, over MCP at the host's /mcp (host/src/assistants/). No app is shared until the person turns it on.

use Lead, Mono from "../look.contract"
use Button from "../controls.contract"
use SharedApp from "../host.contract"
use SettingsPage, SettingsSection, SettingsRow, SettingsEmpty from "../parts.contract"

component AssistantsSettings
  props
    apps: SharedApp[]
    // The host's MCP address, which an assistant is given.
    url: string
    copyUrl: action
    share: action
  view
    SettingsPage(intro="Claude Code, Cursor and other assistants on your tailnet can use the apps you share here, over MCP. What an app tells them goes to their model.",
      testId="assistants")
      SettingsSection(title="Address", aside="", asideTestId="", note="", testId="")
        column gap="space.sm" padding="space.ms 0" border-bottom="1px solid line.subtle"
          row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.md" border="1px solid line.strong"
            text url flex=1 min-width=0 class=Mono overflow-wrap="anywhere" user-select="all" testId="assistants-url"
            Button(press=copyUrl, variant="secondary", disabled=false, testId="assistants-copy")
              image "symbol:icon.copy" width=13 height=13 aria-hidden=true
              text "Copy"
          text `In Claude Code: claude mcp add --transport http imp ${url}` class=Mono color="ink.muted"
            overflow-wrap="anywhere" user-select="all" testId="assistants-claude"
      SettingsSection(title="Shared apps", aside="", asideTestId="", note="", testId="")
        if apps.length == 0
          SettingsEmpty(message="No apps yet.", testId="assistants-empty")
        for a in apps key=a.id
          SettingsRow(testId="")
            image a.symbol width=16 height=16 aria-hidden=true
            text a.name class=Lead flex=1 min-width=0 testId=`assistants-app-${a.id}`
            input type="checkbox" switch checked=a.shared change=share(a.id) aria-label=`Share ${a.name}`
              testId=`assistants-share-${a.id}`
