// Settings' Notifications: whether this Imp may show the person a notification while they are away.

use Button from "../controls.contract"
use NotificationStatus from "@exact/notifications"
use SettingsSection, SettingsEmpty, SettingsFoot from "../parts.contract"

// Whether this device tells the person what needs them. The browser or the system asks once; after a no, only its own
// settings can turn notifications back on.
component NotificationSettings
  props
    alerts: NotificationStatus
    asking: bool
    allow: action
  view
    SettingsSection(title="Notifications", aside=(not alerts.available ? "" : alerts.state == "granted" ? "On" : "Off"),
      asideTestId="notifications-state", note="Routine findings, key requests and finished replies, while Imp is open here.",
      testId="notifications")
      if not alerts.available
        SettingsEmpty(message="This browser can't show notifications.", testId="notifications-unavailable")
      else if alerts.state == "denied"
        SettingsEmpty(message="Notifications are blocked for Imp. Allow them in your browser's settings for this site, or in System Settings for the app.",
          testId="notifications-denied")
      else if alerts.state != "granted"
        SettingsFoot(testId="")
          row
            Button(press=allow, variant="primary", disabled=asking, testId="notifications-allow")
              text "Turn on notifications"
