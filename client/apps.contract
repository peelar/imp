// An installed app in the shell: its tab, and its page around the app's own screen (apps/<id>/app.contract), with
// the bar that says what it reads and offers Save, Discard and Undo for a draft, and Uninstall; and the onboarding's
// step that installs the first app.

use Label, Body, Small, Heading, Lead, rise from "./look.contract"
use Button, DialogButton, Callout from "./controls.contract"
use KeyBadge, Confirm from "./parts.contract"
use WizardTitle, WizardButton from "./onboarding.contract"
use Connection from "./host.contract"
use GithubSignIn from "./settings/connections.contract"

// An app's page: the shell's bar above the app's own screen, which the app cannot draw over. While the app shows a
// preview of a new version, the bar says so, says what the version reads from outside, and offers Save and Discard.
// Otherwise it says how the app's sync went, with Sync now, after a save offers to undo it, and offers to uninstall it.
// Above the app's screen, a card: what an app is, above the first one the onboarding installed, until the person
// closes it (`guide`); and while the app waits for a key (`needs`), GitHub's sign-in right there, or for another key a
// button to Settings, which adds it.
// Waiting is setup still to do, not a failure: the bar says nothing of the sync until the key is there.
component AppPage
  props
    id: string
    name: string
    draft: bool
    undo: string
    reads: string
    sync: string
    save: action
    discard: action
    undoSave: action
    syncNow: action
    uninstall: action
    uninstallError: string
    guide: bool
    dismissGuide: action
    keys: bool
    needs: string
    openSettings: action
    github: Connection
    githubBusy: bool
    connectGithub: action
    cancelGithub: action
    copyGithubCode: action
  slot
  view
    column flex=1 min-height=0
      if draft
        // The preview's own surface, in the accent: its two buttons are drawn in white on it rather than as Buttons.
        row testId="preview-bar" align-items="center" gap="space.ms" padding="space.sm space.md"
          background-color="fill.preview" color="ink.on-fill" flex-wrap="wrap"
          text "Preview" class=Label color="ink.on-fill"
          column flex=1 min-width="12rem" gap="space.xxs"
            text "A new version, on a copy of your data. Nothing you do here is kept." class=Body
            if reads != ""
              text reads class=Small opacity=0.85 testId="preview-reads"
          button press=discard(id) testId="preview-discard" padding="space.sm space.ms" border="1px solid ink.on-fill"
            background-color="transparent" color="ink.on-fill"
            text "Discard" class=Label color="inherit"
          button press=save(id) aria-keyshortcuts="Meta+S" testId="preview-save" padding="space.sm space.ms"
            border="1px solid ink.on-fill" background-color="ink.on-fill" color="fill.preview" position="relative"
            text "Save" class=Label color="inherit"
            if keys
              KeyBadge(chord="Meta+S", at="end")
      else
        // Under the page's header, in line with its title.
        row padding="space.sm space.lg" border-bottom="1px solid line.subtle"
          row width="100%" align-items="center" gap="space.ms"
            if sync != ""
              row flex=1 min-width=0 align-items="center" gap="space.sm" testId="sync-bar"
                text sync class=Small color=(sync.startsWith("Sync failing") ? "ink.danger" : "ink.muted")
                  min-width=0 overflow-wrap="anywhere" testId="sync-status"
                Button(press=syncNow(id), variant="quiet", disabled=(sync == "Syncing…"), testId="sync-now")
                  text "Sync now"
            else if uninstallError != ""
              text uninstallError class=Small color="ink.danger" flex=1 min-width=0 overflow-wrap="anywhere"
                testId="uninstall-error"
            else
              row flex=1
            if undo != ""
              DialogButton(dialog=`undo-${id}`, variant="secondary", testId="undo-save")
                text (undo == "remove" ? "Undo: remove app" : "Undo last save")
            DialogButton(dialog=`uninstall-${id}`, variant="quiet-danger", testId="uninstall")
              text "Uninstall"
        Confirm(id=`undo-${id}`, question="Undo the last save?",
          message=(undo == "remove" ? "This removes the app and its data." : undo == "data" ? "The app goes back to its previous version, and its data to how it was before that save: changes since are lost." : "The app goes back to its previous version. Its data stays."),
          label="Undo", confirm=undoSave(id), testId="undo")
        Confirm(id=`uninstall-${id}`, question=`Uninstall ${name}?`,
          message="Are you sure you want to delete the app and all its data?", label="Uninstall", confirm=uninstall(id),
          testId="uninstall")
      scroll id=`${id}-screen` flex=1 min-height=0
        if not draft and (guide or needs != "")
          column padding="space.lg space.lg space.xs" max-width="measure.note"
            Callout(tone="accent", testId="app-card")
              if guide
                row gap="space.sm" align-items="flex-start" testId="app-guide"
                  column flex=1 min-width=0 gap="space.xs"
                    text "Your first app" class=Label color="AccentColor" role="heading" aria-level=2
                    text `This is ${name}. Use it here, or ask your imp in the chat to use it, change it, or build you another.`
                      class=Body
                  button press=dismissGuide aria-label="Close" title="Close" testId="app-guide-dismiss" appearance="none"
                    width=24 height=24 min-width=24 padding=0 display="flex" align-items="center" justify-content="center"
                    border="none" background-color="transparent" color="ink.muted"
                    :hover
                      color="ink.strong"
                    image "symbol:icon.close" width=11 height=11 aria-hidden=true
              if needs == "github"
                column testId="app-needs"
                  GithubSignIn(github=github, busy=githubBusy, connect=connectGithub, cancel=cancelGithub,
                    copyCode=copyGithubCode, note="This app reads GitHub as you: connect GitHub, and the app fills in. Your imp can work on it meanwhile.",
                    prefix="app-")
              else if needs != ""
                column gap="space.sm" align-items="flex-start" testId="app-needs"
                  text `This app reads with your ${needs} key: add it, and the app fills in.` class=Body color="ink.muted"
                  Button(press=openSettings("secrets"), variant="accent", disabled=false, testId="app-needs-settings")
                    text "Add it in Settings"
                    text "→" aria-hidden=true
        children

// One tab in the bar along the bottom: its symbol over its name, and its keys over its corner while ⌘ is held.
component AppTab
  props
    prefix: string
    name: string
    label: string
    symbol: string
    chord: string
    selected: bool
    shown: bool
    keys: bool
    press: action
  view
    button role="tab" aria-controls=`panel-${name}` aria-selected=selected press=press(name)
      aria-keyshortcuts=chord aria-label=label title=label testId=`${prefix}tab-${name}` appearance="none"
      display=(shown ? "flex" : "none") flex-direction="column" align-items="center" justify-content="center"
      position="relative" box-sizing="border-box" flex="1 1 0" max-width="7rem" gap="space.xs" min-width=0 padding=0
      border="none" border-top=(selected ? "2px solid ink.strong" : "2px solid transparent")
      background-color="transparent" color=(selected ? "ink.strong" : "ink.muted")
      transition="background-color 120ms ease, color 120ms ease"
      :hover
        color="ink.strong"
        background-color="surface.soft"
      image symbol width=19 height=19 aria-hidden=true
      text label class=Label color="inherit" aria-hidden=true
      if keys and chord != ""
        KeyBadge(chord=chord, at="tab")

// The onboarding's last step: the first app. The person describes the GitHub app they want, and the imp builds it
// over Imp's GitHub app, which reads GitHub for it, while they watch; or they skip, and have Imp's as it ships.
// One thing to do here: connecting GitHub comes after, on the app's page, while the imp builds.
component FirstAppWizard
  props
    ask: string
    edit: action
    busy: bool
    error: string
    build: action
    skip: action
    still: bool
  view
    column gap="space.md" testId="first-app" animation=(still ? "none" : "rise 260ms ease-out both")
      WizardTitle(title="Build your first app", note="Say what you want to see. Your imp builds it while you watch.")
      row gap="space.ms" align-items="center" padding="space.ms 0" border-top="1px solid line.subtle"
        border-bottom="1px solid line.subtle"
        row width=44 height=44 min-width=44 align-items="center" justify-content="center" border="1px solid line.strong"
          box-sizing="border-box" aria-hidden=true
          image "symbol:icon.github" width=20 height=20
        column gap="space.xs" flex=1 min-width=0
          text "GitHub" class=Heading
          text "Imp reads your review requests, your pull requests, what's assigned to you and your notifications. Your app shows what you choose."
            class=Body color="ink.muted"
      textarea value=ask input=edit rows=4 aria-label="The app you want" testId="first-app-ask"
        padding="space.ms space.ms" border="1px solid line.strong" background-color="transparent" outline="none"
        resize="vertical" class=Lead color="ink.strong"
      if error != ""
        text error class=Body color="ink.danger" testId="first-app-error"
      WizardButton(label=(busy ? "Starting…" : "Build it"), press=build, testId="first-app-build", primary=true,
        disabled=(busy or ask.trim() == ""))
      WizardButton(label="Skip, use Imp's GitHub app", press=skip, testId="first-app-skip", primary=false, disabled=busy)
