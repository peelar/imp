// An installed app in the shell: its tab; its controls in its page's one bar, beside its title; its page around the
// app's own screen (apps/<id>/app.contract); the dialog that manages it; and the onboarding's step that installs the
// first app.

use Label, Body, Small, Heading, Lead, Title, Control, rise from "./look.contract"
use Button, DialogButton, ButtonLink, Callout, ErrorNote from "./controls.contract"
use KeyBadge, Confirm from "./parts.contract"
use WizardTitle, WizardButton from "./onboarding.contract"
use Connection, AppTile from "./host.contract"
use GithubSignIn from "./settings/connections.contract"

// An app's page, under the page's one bar (AppBar), around the app's own screen, which the app cannot draw over.
// Above the screen, a card: what an app is, above the first one the onboarding installed, until the person closes it
// (`guide`); while the app waits for a key (`needs`), GitHub's sign-in right there, or for another key a button to
// Settings, which adds it; and while a preview shows, what that version reads from outside, and, where this window
// runs a build of its own (`behind`: the Mac app, which carries its screens and never loads the host's), that it
// shows the new version's data on the screen it has, with a link to the page in the browser, which has the new one.
// Waiting is setup still to do, not a failure: the bar says nothing of the sync until the key is there.
component AppPage
  props
    id: string
    name: string
    draft: bool
    reads: string
    behind: bool
    origin: string
    guide: bool
    dismissGuide: action
    needs: string
    openSettings: action
    github: Connection
    githubBusy: bool
    connectGithub: action
    cancelGithub: action
    copyGithubCode: action
  slot
  view
    column flex=1 min-height=0
      scroll id=`${id}-screen` flex=1 min-height=0
        if (draft and (reads != "" or behind)) or (not draft and (guide or needs != ""))
          // In the apps' own column (docs/building-apps.md): measure.page wide, centered, inside space.page, so the card
          // lines up with the app's screen under it.
          column padding="space.lg space.page space.xs"
            column width="100%" max-width="measure.page" margin="0 auto"
              Callout(tone="accent", testId="app-card")
                if draft
                  column gap="space.sm" align-items="flex-start" testId="preview-note"
                    if reads != ""
                      text reads class=Body testId="preview-reads"
                    if behind
                      text "This window carries Imp's own screens: it shows the new version's data, not its screen. Try the new version in your browser before you save it."
                        class=Body color="ink.muted"
                      row
                        ButtonLink(href=`${origin}/${id}`, variant="accent", testId="preview-open")
                          text "Open in browser"
                          text "→" aria-hidden=true
                if guide
                  row gap="space.sm" align-items="flex-start" testId="app-guide"
                    column flex=1 min-width=0 gap="space.xs"
                      text "Your first app" class=Label color="AccentColor" role="heading" aria-level=2
                      text `This is ${name}. Use it here, or ask your imp in the chat to use it, change it, or build you another.`
                        class=Body
                    button press=dismissGuide aria-label="Close" title="Close" testId="app-guide-dismiss" appearance="none"
                      cursor="pointer"
                      width=24 height=24 min-width=24 padding=0 display="flex" align-items="center" justify-content="center"
                      border="none" background-color="transparent" color="ink.muted"
                      :hover
                        color="ink.strong"
                      image "symbol:icon.close" width=11 height=11 aria-hidden=true
                if needs == "github"
                  column testId="app-needs"
                    GithubSignIn(github=github, busy=githubBusy, connect=connectGithub, cancel=cancelGithub,
                      copyCode=copyGithubCode, note="This app reads GitHub as you: connect GitHub, and the app fills in. Your imp can work on it meanwhile.",
                      prefix="app-")
                else if needs != ""
                  column gap="space.sm" align-items="flex-start" testId="app-needs"
                    text `This app reads with your ${needs} key: add it, and the app fills in.` class=Body color="ink.muted"
                    Button(press=openSettings("secrets"), variant="accent", disabled=false, testId="app-needs-settings")
                      text "Add it in Settings"
                      text "→" aria-hidden=true
        children

// A symbol-only control in an app's bar, as tall as the page header's other controls (New chat, the drawer).
component BarSymbol
  props
    symbol: string
    label: string
    press: action
    testId: string
  view
    button press=press aria-label=label title=label testId=testId appearance="none" width=32 height=32 min-width=32
      cursor="pointer"
      padding=0 display="flex" align-items="center" justify-content="center" flex-shrink=0 box-sizing="border-box"
      border="1px solid line.strong" background-color="transparent" color="ink.strong"
      :hover
        background-color="surface.soft"
      image symbol width=15 height=15 aria-hidden=true

// BarSymbol for a control that opens a dialog (a Confirm, or ManageApp) by its id.
component BarDialogSymbol
  props
    symbol: string
    label: string
    dialog: string
    testId: string
  view
    button commandfor=dialog command="show-modal" aria-label=label title=label testId=testId appearance="none"
      cursor="pointer"
      width=32 height=32 min-width=32 padding=0 display="flex" align-items="center" justify-content="center"
      flex-shrink=0 box-sizing="border-box" border="1px solid line.strong" background-color="transparent"
      color="ink.strong"
      :hover
        background-color="surface.soft"
      image symbol width=15 height=15 aria-hidden=true

// An app's controls, in its page's one bar beside its title. Every control is 32 tall and square-cornered, in a row.
// While the app shows a preview of a new version, the bar says so beside the title, and offers Back, to the saved
// version (Discard), and Save. Otherwise Back undoes the last save, while there is one, and on a wide window the bar
// says how the app's sync went. Manage opens what is done less often: Sync now and Uninstall.
component AppBar
  props
    app: AppTile
    wide: bool
    keys: bool
    save: action
    discard: action
    undoSave: action
    syncNow: action
    uninstall: action
    uninstallError: string
  view
    row flex=1 min-width=0 align-items="center" gap="space.sm" testId="app-bar"
      if app.draft
        row gap="space.sm" align-items="center" flex-shrink=0 testId="preview-bar"
          row width=6 height=6 background-color="AccentColor" aria-hidden=true
          text "Preview" class=Label color="AccentColor"
      row flex=1 min-width=0 justify-content="flex-end"
        if wide and not app.draft and app.sync != "" and app.needs == ""
          text app.sync class=Small color=(app.sync.startsWith("Sync failing") ? "ink.danger" : "ink.muted")
            white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 testId="sync-bar"
      if app.draft
        BarSymbol(symbol="symbol:icon.back", label="Back to the saved version", press=discard(app.id),
          testId="preview-discard")
        button press=save(app.id) aria-keyshortcuts="Meta+S" testId="preview-save" position="relative" flex-shrink=0
          cursor="pointer"
          height=32 box-sizing="border-box" padding="0 space.ms" display="flex" align-items="center"
          border="1px solid AccentColor" background-color="AccentColor" color="ink.on-fill"
          :hover
            opacity=0.9
          text "Save" class=Control color="inherit"
          if keys
            KeyBadge(chord="Meta+S", at="end")
      else if app.undo != ""
        BarDialogSymbol(symbol="symbol:icon.back",
          label=(app.undo == "remove" ? "Undo the save: remove the app" : "Back to the version before the last save"),
          dialog=`undo-${app.id}`, testId="undo-save")
      BarDialogSymbol(symbol="symbol:icon.settings", label=`Manage ${app.name}`, dialog=`manage-${app.id}`,
        testId="app-manage")
    Confirm(id=`undo-${app.id}`, question="Undo the last save?",
      message=(app.undo == "remove" ? "This removes the app and its data." : app.undo == "data" ? "The app goes back to its previous version, and its data to how it was before that save: changes since are lost." : "The app goes back to its previous version. Its data stays."),
      label="Undo", confirm=undoSave(app.id), testId="undo")
    ManageApp(app=app, syncNow=syncNow, uninstallError=uninstallError)
    Confirm(id=`uninstall-${app.id}`, question=`Uninstall ${app.name}?`,
      message="Are you sure you want to delete the app and all its data?", label="Uninstall", confirm=uninstall(app.id),
      testId="uninstall")

// What is done with an app less often than using it, in a dialog in Confirm's look: what it is, how its sync went with
// Sync now, and Uninstall, which asks first.
component ManageApp
  props
    app: AppTile
    syncNow: action
    uninstallError: string
  view
    dialog id=`manage-${app.id}` aria-label=`Manage ${app.name}` width="min(26rem, calc(100vw - 32px))"
      box-sizing="border-box" padding=0 border="1px solid ink.strong" border-radius=0 background-color="surface.page"
      color="ink.strong" box-shadow="none" testId="manage"
      column gap="space.sm" padding="space.lg space.lg 0"
        text `Manage ${app.name}` class=Title role="heading" aria-level=2
        text app.description class=Body color="ink.muted"
      if app.sync != "" and app.needs == ""
        row align-items="center" gap="space.sm" margin="space.md space.lg 0" padding="space.sm 0"
          border-top="1px solid line.subtle" border-bottom="1px solid line.subtle"
          text app.sync class=Small color=(app.sync.startsWith("Sync failing") ? "ink.danger" : "ink.muted") flex=1
            min-width=0 overflow-wrap="anywhere" testId="sync-status"
          Button(press=syncNow(app.id), variant="quiet", disabled=(app.sync == "Syncing…"), testId="sync-now")
            text "Sync now"
      if uninstallError != ""
        column padding="space.md space.lg 0"
          ErrorNote(message=uninstallError, testId="uninstall-error")
      row justify-content="space-between" align-items="center" gap="space.sm" padding="space.md space.lg space.lg"
        DialogButton(dialog=`uninstall-${app.id}`, variant="quiet-danger", testId="uninstall")
          text "Uninstall"
        button commandfor=`manage-${app.id}` command="close" testId="manage-close" padding="space.sm space.ms"
          cursor="pointer"
          border="1px solid line.strong" border-radius=0 background-color="transparent" color="ink.strong"
          :hover
            background-color="surface.soft"
          text "Done" class=Label color="inherit"

// One tab in the bar along the bottom: its symbol over its name, and its keys over its corner while ⌘ is held.
component AppTab
  props
    prefix: string
    name: string
    label: string
    symbol: string
    chord: string
    selected: bool
    shown: bool
    keys: bool
    press: action
  view
    button role="tab" aria-controls=`panel-${name}` aria-selected=selected press=press(name)
      cursor="pointer"
      aria-keyshortcuts=chord aria-label=label title=label testId=`${prefix}tab-${name}` appearance="none"
      display=(shown ? "flex" : "none") flex-direction="column" align-items="center" justify-content="center"
      position="relative" box-sizing="border-box" flex="1 1 0" max-width="7rem" gap="space.xs" min-width=0 padding=0
      border="none" border-top=(selected ? "2px solid ink.strong" : "2px solid transparent")
      background-color="transparent" color=(selected ? "ink.strong" : "ink.muted")
      transition="background-color 120ms ease, color 120ms ease"
      :hover
        color="ink.strong"
        background-color="surface.soft"
      image symbol width=19 height=19 aria-hidden=true
      text label class=Label color="inherit" aria-hidden=true
      if keys and chord != ""
        KeyBadge(chord=chord, at="tab")

// The onboarding's last step: the first app. The person describes the GitHub app they want, and the imp builds it
// over Imp's GitHub app, which reads GitHub for it, while they watch; or they skip, and have Imp's as it ships.
// One thing to do here: connecting GitHub comes after, on the app's page, while the imp builds.
component FirstAppWizard
  props
    ask: string
    edit: action
    busy: bool
    error: string
    build: action
    skip: action
    still: bool
  view
    column gap="space.md" testId="first-app" animation=(still ? "none" : "rise 260ms ease-out both")
      WizardTitle(title="Build your first app", note="Say what you want to see. Your imp builds it while you watch.")
      row gap="space.ms" align-items="center" padding="space.ms 0" border-top="1px solid line.subtle"
        border-bottom="1px solid line.subtle"
        row width=44 height=44 min-width=44 align-items="center" justify-content="center" border="1px solid line.strong"
          box-sizing="border-box" aria-hidden=true
          image "symbol:icon.github" width=20 height=20
        column gap="space.xs" flex=1 min-width=0
          text "GitHub" class=Heading
          text "Imp reads your review requests, your pull requests, what's assigned to you and your notifications. Your app shows what you choose."
            class=Body color="ink.muted"
      textarea value=ask input=edit rows=4 aria-label="The app you want" testId="first-app-ask"
        padding="space.ms space.ms" border="1px solid line.strong" background-color="transparent" outline="none"
        resize="vertical" class=Lead color="ink.strong"
      if error != ""
        text error class=Body color="ink.danger" testId="first-app-error"
      WizardButton(label=(busy ? "Starting…" : "Build it"), press=build, testId="first-app-build", primary=true,
        disabled=(busy or ask.trim() == ""))
      WizardButton(label="Skip, use Imp's GitHub app", press=skip, testId="first-app-skip", primary=false, disabled=busy)
