// Imp's shell: onboarding first (a model account, a computer, then the first app), then the chat home and the installed apps, compiled into one
// plan. Every source goes to the host through the one data module in app.ts, which streams each resource live. Each
// app's resources and mutations live here, in the root, because Contract allows them only there; its screen is
// imported from apps/<id>/app.contract. Colours and type are app.forma's; the look is "Catalogue": white paper,
// black ink, engraved art, square corners, mono labels and one cobalt action.
//
// This file is the root: the routes, every resource, mutation and action, and the page around the screens. The screens
// are in files named as the app names them: chat, sidebar, routines, tricks, app-directory, apps (an installed app's
// tab and page), computer, and settings/<section>. host.contract holds the shapes of what the host answers, and look,
// parts and onboarding what the screens share. Contract refuses a file that uses one that uses it, so none of them
// uses this one. An Exact module a screen uses is named here too: scripts/link-exact.sh and the host's build
// (host/src/studio/wiring.ts) link only the modules this file names.
//
// The host writes each app's part between the `// <apps:…>` markers from the props of the app's `component Screen`
// (host/src/studio/wiring.ts); `node host/scripts/shell.ts` writes them for the apps in apps/. Do not edit between them.
// <apps:use>
use Screen as GithubScreen, Inbox as GithubInbox from "./apps/github/app.contract"
use Screen as TodosScreen, Todo as TodosTodo from "./apps/todos/app.contract"
// </apps:use>
use showNotification, closeNotification, setAppBadge, clearAppBadge, notificationStatus, requestNotificationPermission, notificationclick, NotificationStatus, NotificationEvent from "@exact/notifications"
use getUserMedia, stopTrack, MediaStream, MediaStreamTrack from "@exact/media-capture"
use startSpeechRecognition, stopSpeechRecognition, abortSpeechRecognition, speechRecognitionState, speechRecognitionStatus, SpeechRecognitionInfo, SpeechRecognitionState, SpeechRecognitionStatus from "@exact/speech-recognition"
use Label, pulse, Key, rise, Body, Control, Display, Heading, Lead, Mono, Title, Initial, Page from "./look.contract"
use Button, DeviceCode from "./controls.contract"
use SecretSettings, SecretAsk from "./settings/secrets.contract"
use MemorySettings from "./settings/memory.contract"
use GeneralSettings from "./settings/general.contract"
use ExperimentalSettings from "./settings/experimental.contract"
use ConnectionsSettings, McpServerSettings from "./settings/connections.contract"
use AssistantsSettings from "./settings/assistants.contract"
use AppTile, Memory, Secrets, Connection, Notice, Host, Account, ChatState, Build, Update, Reply from "./host.contract"
use repoPath, AppDirectory, directory from "./app-directory.contract"
use withSpoken, Transcript, Composer from "./chat.contract"
use KeyBadge, Initialled, Confirm, SettingsPage, RestartButton from "./parts.contract"
use HomeApps, Suggestions, computerMark from "./home.contract"
use RoutineList, RoutineBar from "./routines.contract"
use TrickList from "./tricks.contract"
use ComputerSettings, ComputerScreen, ComputerWizard, ScreenPreview from "./computer.contract"
use AppPage, AppBar, AppTab, FirstAppWizard from "./apps.contract"
use Sidebar from "./sidebar.contract"
use WizardTitle, WizardFold, KeyField, WizardButton from "./onboarding.contract"

font "Instrument Serif" = "assets/fonts/InstrumentSerif-Regular.ttf"
font "Pinyon Script" = "assets/fonts/PinyonScript-Regular.ttf"
font "Instrument Sans"
  400 700 = "assets/fonts/InstrumentSans.ttf"
  400 700 italic = "assets/fonts/InstrumentSans-Italic.ttf"
font "IBM Plex Mono"
  400 = "assets/fonts/IBMPlexMono-Regular.ttf"
  500 = "assets/fonts/IBMPlexMono-Medium.ttf"

routes nav
  tab chat "/"
  // <apps:tabs>
  tab github "/github"
  tab todos "/todos"
  // </apps:tabs>
  // The imp's computer: its screen, beside the chat on a wide window, as an app's page is.
  tab computer "/computer"
  // The imp's own pages, which the sidebar opens.
  tab routines "/routines"
  tab tricks "/tricks"
  tab directory "/directory"
  tab settings "/settings"

shape Media
  prefersReducedMotion: bool
  width: number
  pointer: string
  displayMode: string

shape Page
  hasFocus: bool
  frozen: bool

shape Time
  epochAtZero: number
  utcOffset: number

// What the data module made of files attached to a message (app.ts, `chatAttach`): an app file for each image, shrunk
// to what the model takes, and why any were left out ("" when none were).
shape Attached
  paths: string[]
  error: string

// <apps:version>
fn builtVersion(): string = "repo"
// </apps:version>
fn tabTitle(name: string, wide: bool, apps: AppTile[]): string = name == "chat" ? (wide ? "Chat" : "Imp") : tabLabel(name, apps)
// The chord that opens a tab: ⌘1 to ⌘9 for the apps and the computer in the bar's order, and ⌘, for Settings, as on a
// Mac. Any other tab has none (⌘N opens the chat).
fn tabChord(name: string, bar: string[]): string =
  name == "settings" ? "Meta+," : bar.indexOf(name) >= 0 and bar.indexOf(name) < 9 ? `Meta+${bar.indexOf(name) + 1}` : ""
fn capitalized(s: string): string = s == "" ? "" : `${s.slice(0, 1).toUpperCase()}${s.slice(1)}`
fn hourOf(ms: number, offset: number): number = floor(((ms + offset * 60000) % 86400000) / 3600000)
fn greeting(hour: number): string = hour < 5 ? "Good evening" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"
fn tabLabel(name: string, apps: AppTile[]): string =
  (name == "chat" ? "Chat" : name == "settings" ? "Settings" : name == "computer" ? "Computer" : name == "routines" ? "Routines"
    : name == "tricks" ? "Tricks" : name == "directory" ? "App directory" : match first(apps.filter(a => a.id == name)) { case some(a) => a.name, case none => capitalized(name) })
fn tabSymbol(name: string, apps: AppTile[]): string =
  name == "chat" ? "symbol:icon.messages" : name == "settings" ? "symbol:icon.settings" : name == "computer" ? "symbol:icon.computer" : match first(apps.filter(a => a.id == name)) { case some(a) => a.symbol, case none => "symbol:icon.layers" }
fn hasDraft(name: string, apps: AppTile[]): bool =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.draft, case none => false }
fn undoKind(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.undo, case none => "" }
fn readsOf(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.reads, case none => "" }
fn syncOf(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.sync, case none => "" }
fn needsOf(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.needs, case none => "" }
// The count a Settings tab carries: what is remembered, the secrets; "" for none.
fn settingsCount(section: string, memory: Memory, secrets: Secrets): string =
  (section == "memory" ? `${sum(memory.entries.map(m => m.facts.length + m.links.length))}`
    : section == "secrets" ? `${secrets.secrets.length}` : "")
// What the person asks for when they install an app from GitHub, in their own words. How the imp does it (clone,
// copy the app's folder into its workspace, preview) is the studio's to tell it (host/src/studio/tools.ts).
fn installAsk(repo: string): string = `Install the app from github.com/${repoPath(repo)} so I can try it.`
// The notice at a place in the list, or none (an empty one, from before every notice) past its end.
fn noticeAt(notices: Notice[], i: number): Notice =
  match notices.at(i) { case some(n) => n, case none => Notice(id="", kind="", title="", body="", conversation="", at=0) }
// A notice's notification: one per conversation, so a newer one replaces the last, and one for the keys asked for.
fn noticeTag(n: Notice): string = n.kind == "key" ? "key" : `conversation-${n.conversation}`
// The final results a recognition heard from the `from`th on, best guesses only.
fn heardSince(heard: SpeechRecognitionState, from: number): string =
  (heard.results.filter(r => r.index >= from).map(r => r.alternatives.slice(0, 1).map(a => a.transcript.trim()).join(""))
    .filter(t => t != "").join(" "))
// Why dictation stopped or did not start, from a start's failure or a recognition's error ("" for none worth saying:
// the person stopped it, or it heard nothing).
fn dictationTrouble(code: string): string =
  (code == "" or code == "aborted" or code == "no-speech" ? ""
    : code == "NotAllowedError" or code == "not-allowed" ? "Dictation needs the microphone. Allow it for this page and try again."
    : code == "audio-capture" or code == "NotReadableError" ? "No microphone could be opened for dictation."
    : code == "network" or code == "service-not-allowed" ? "The browser's speech service did not answer. Try again."
    : `Dictation stopped (${code}).`)

component App
  state draft = ""
  // What the last send carried, until the host takes it: a send that never reaches the host puts it back in the box.
  state unsent = ""
  // The images going with the next message, as app files (app.ts, `chatAttach`), and the last send's.
  state attachments: string[] = []
  state unsentImages: string[] = []
  // What a message the shell writes itself (a suggestion, an install, the first app) attaches: nothing.
  derive noImages = attachments.slice(0, 0)
  state scheme = "system" persist
  state now = 0
  // The sidebar's conversations past the latest three are folded until this opens them.
  state olderOpen = false
  // Archived chats are folded at the sidebar's foot until this opens them.
  state archivedOpen = false
  // On a narrow window the sidebar is a drawer over the chat.
  state drawer = false
  // The host's address in the Mac app ("" on the web, where the page's origin is the host). The Mac installer fills it
  // in; the onboarding asks for it when no host answers.
  state hostAddress = "" persist
  state hostDraft = ""
  // The onboarding's open section for the computer: "cloud", "own", "container" or none.
  state computerChoice = ""
  // Whether the onboarding's API key fold is open.
  state keyForm = false
  state keyBase = "https://api.openai.com/v1"
  state keyValue = ""
  state keyModel = ""
  // The onboarding's ask for the first app, and whether the imp is building it, from Build it until the app it
  // previews opens, which a relaunch into that preview keeps.
  state firstAsk = "Build me a GitHub app that shows only the pull requests waiting for my review, and the ones I opened that are waiting on a review."
  state firstBuild = false persist
  // An onboarding step the person went back to, though it is done: "model" or "computer"; "" for the step Imp is at.
  state onboardingBack = ""
  // The app the last install was for, and the one to open once the shell lists it.
  state added = ""
  state toOpen = ""
  // Settings' open section: "general", "computer", "memory", "secrets", "connections", "assistants" or "experimental".
  state settingsPane = "general"
  // Counts saved secrets: the Secrets section starts again, with an empty form, after each.
  state secretRound = 0
  // Bumped when an MCP server is added, so the form starts empty again.
  state serverRound = 0
  // Dictation into the composer: whether it is on, the browser's recognition once it has started, how many of its
  // final results are already in the draft, and why the last one stopped (a recognition's error).
  state dictating = false
  state recognitionId = ""
  state dictated = 0
  state dictationEnd = ""
  // The microphone's track dictation listens to where the recognizer takes only a track (the Mac app), "" for none.
  state micTrack = ""
  // ⌘ held on its own, before any other key (a chord): held for a moment, it shows each control's shortcut.
  state metaAlone = false
  state keysShown = false
  // The newest notice this page has taken in, by its `at`; -1 before the first. A page tells only what comes after:
  // opening Imp does not tell again what happened before.
  state noticedAt = -1
  // Imp opens on the home page, a new chat, not on the conversation last open (the host keeps that one open); opened on
  // an app's page on a wide window, on the chat beside that app. The chat stream opens once the host has moved to it,
  // so the last conversation never shows first.
  state landed = false
  resource page = exactPage() as shape Page
  resource speech = speechRecognitionStatus() as shape SpeechRecognitionStatus else empty()
  resource heard = speechRecognitionState(recognition=recognitionId) when recognitionId != "" as shape SpeechRecognitionState else empty()
  resource media = exactViewport() as shape Media
  resource time = exactTime() as shape Time
  resource alerts = notificationStatus() as shape NotificationStatus
  resource host = hostOrigin(hostAddress) as shape Host else empty()
  // Every stream to the host closes while the browser has frozen the page (`page.frozen`: a background tab, or a page
  // put in the back/forward cache), and opens again when it resumes. A frozen page with its streams open holds the
  // browser's connections to the host, so the page opened after it, another of the shell's routes, waits on the
  // splash for one.
  resource account = account() when host.origin != "" and not page.frozen as shape Account else empty()
  resource chat = chat() when signedIn and landed and not page.frozen as shape ChatState else empty()
  resource apps = apps() when signedIn and not page.frozen as shape AppTile[] else empty()
  resource build = build() when signedIn and not page.frozen as shape Build else empty()
  resource update = updateReady() as shape Update else empty()
  // Restart asks the updater to put the ready release in place and open it, then quits.
  mutation restarting as shape Reply then quitForUpdate
  mutation signInStarted as shape Reply
  mutation signInCancelled as shape Reply
  mutation keyUsed as shape Reply then afterKeyUsed
  mutation signedOut as shape Reply
  mutation modelChosen as shape Reply
  mutation sent as shape Reply then toEnd
  mutation attached as shape Attached queue then addAttached
  mutation stopped as shape Reply
  mutation chatChanged as shape Reply
  mutation openedHome as shape Reply then land
  mutation chatArchived as shape Reply queue
  mutation routineOpened as shape Reply
  mutation routineRan as shape Reply
  mutation routinePaused as shape Reply
  mutation routineDeleted as shape Reply
  mutation appSaved as shape Reply
  mutation appDiscarded as shape Reply
  mutation appUndone as shape Reply
  mutation appSynced as shape Reply
  mutation appInstalled as shape Reply then afterInstall
  mutation appUninstalled as shape Reply
  mutation computerSwitched as shape Reply then afterComputerChosen
  mutation computerRefreshed as shape Reply
  mutation computerRetried as shape Reply
  mutation computerKeySaved as shape Reply then afterComputerChosen
  mutation forgotten as shape Reply queue
  mutation secretSaved as shape Reply then afterSecretSaved
  mutation loginSaved as shape Reply then afterLoginSaved
  mutation secretDeleted as shape Reply queue
  mutation secretDismissed as shape Reply queue
  mutation githubConnected as shape Reply
  mutation githubCancelled as shape Reply
  mutation githubDisconnected as shape Reply
  mutation serverAdded as shape Reply then afterServerAdded
  mutation serverSignedIn as shape Reply queue
  mutation serverCancelled as shape Reply queue
  mutation serverRemoved as shape Reply queue
  mutation backupTurnedOn as shape Reply
  mutation backupTurnedOff as shape Reply
  mutation flagChosen as shape Reply queue
  mutation appShared as shape Reply queue
  mutation alertsAsked as shape NotificationStatus
  mutation listening as shape SpeechRecognitionInfo then listened
  mutation unheard as shape SpeechRecognitionInfo
  mutation micOpened as shape MediaStream then micReady
  mutation micClosed as shape MediaStreamTrack
  derive still = media.prefersReducedMotion
  // Wide enough for the three columns: the sidebar (the imp's pages, the apps and the conversations), the page, and
  // the chat beside every page but the chat's own, which takes that room itself. Narrower windows have a tab bar and
  // a drawer instead.
  derive wide = media.width >= 1280
  derive docked = wide and nav.tab != "chat"
  // The home page on a wide window: no bar over it, and the greeting, what to try and the apps over the composer.
  derive homeWide = wide and chat.messages.length == 0 and not chat.busy and chat.routine == ""
  // What the home page offers to try: the todos ones only while Todos is installed.
  derive asks = (apps.map(a => a.id).includes("todos") ? ["Add todo: Buy flowers", "What's on my todo list?"] : []).concat(["Build me an app that tracks my runs"])
  // The ⌘ chords are the app's in the Mac app (and an installed desktop app), where no browser takes them first: only
  // there does the screen hint at them.
  derive keyboard = media.pointer == "fine" and media.displayMode != "browser"
  derive keys = keyboard and keysShown and page.hasFocus
  // The apps the top bar lists: the installed ones this build has a screen (a tab) for.
  derive shownApps = apps.filter(a => nav.tabs.map(t => t.name).includes(a.id))
  // The apps the bar shows, in order: the ones the host lists (this build has a tab for every app it ships, and a
  // feature flag keeps some off the host), and the computer once there is one.
  derive appTabs = nav.tabs.map(t => t.name).filter(n => n == "computer" ? computer.status != "none" : apps.map(a => a.id).includes(n))
  // On a narrow window, where no sidebar is, the bar adds the chat and Settings.
  derive barTabs = wide ? appTabs : ["chat"].concat(appTabs).concat(["settings"])
  // A tab nothing shows, such as an app a flag keeps off, opened by its address: the host has nothing for it.
  derive offTab = signedIn and current(apps) and not (appTabs.includes(nav.tab)
    or ["chat", "settings", "routines", "tricks"].includes(nav.tab) or (nav.tab == "directory" and directoryOn))
  // What the chat beside the page is about: the open app or the computer, "" for the imp's own pages.
  derive sideSubject = nav.tab == "computer" ? "the computer" : match first(apps.filter(a => a.id == nav.tab)) { case some(a) => a.name, case none => "" }
  // The home page: the chat with nothing said yet.
  derive atHome = nav.tab == "chat" and chat.messages.length == 0 and not chat.busy and chat.routine == ""
  derive signedIn = account.status == "signedIn"
  derive signingIn = account.status == "starting" or account.status == "waiting"
  derive onKey = account.kind == "apiKey"
  // Onboarding's second step: a computer, until the imp has one or the person tries the chat without.
  derive needsComputer = signedIn and computer.status == "none"
  // Its third: the first app, until the person asks the imp to build it or skips it.
  derive needsFirstApp = signedIn and not needsComputer and account.introduceApps and not firstBuild
  // The app the imp built for the first app, once the shell lists it: the host had none before.
  derive builtApp = match appTabs.filter(n => n != "computer").at(0) { case some(n) => n, case none => "" }
  derive installError = ((failed(appInstalled) and not pending(appInstalled))
    ? "Your Imp didn't answer in time. Try again in a moment."
    : match appInstalled { case some(r) => r.error, case none => "" })
  // The onboarding's step on screen, 1 to 3: the one Imp is at, or an earlier one the person went back to.
  derive onboardingStep = onboardingBack == "model" ? 1 : onboardingBack == "computer" ? 2 : needsFirstApp ? 3 : signedIn ? 2 : 1
  derive uninstallError = match appUninstalled { case some(r) => r.error, case none => "" }
  // An onboarding section waiting on something done outside Imp (a computer set up with the setup prompt, a container
  // engine started) has the host look again every few seconds, so it shows up without a click.
  derive computerAwaited = (needsComputer and not pending(computerSwitched) and not pending(computerKeySaved)
    and ((computerChoice == "own" and computer.devices.filter(d => d.problem == "").length == 0)
    or (computerChoice == "container" and not computer.containerAvailable)))
  derive apiKeyError = match keyUsed { case some(r) => r.error, case none => "" }
  derive shown = time.epochAtZero + now
  derive salutation = `${greeting(hourOf(shown, time.utcOffset))}.`
  derive lastId = match chat.messages.at(-1) { case some(m) => m.id, case none => "" }
  derive sendLost = failed(sent) and not pending(sent)
  derive sendError = sendLost ? "Your imp couldn't be reached, so that wasn't sent. Send it again in a moment." : match sent { case some(r) => r.error, case none => "" }
  // Dictation: the browser's recognizer opens the microphone itself; the Mac app's (Apple's, on the device) listens to
  // a microphone track the app opens and stops when dictation ends. The words it is still unsure of show above the
  // field until they are final and join the draft.
  derive micDirect = speech.inputs.includes("microphone")
  derive canDictate = speech.available and speech.state != "denied" and (micDirect or speech.inputs.includes("track"))
  derive interimHeard = match heard.interim { case some(i) => i.alternatives.slice(0, 1).map(a => a.transcript).join("").trim(), case none => "" }
  derive dictationError = dictationTrouble(match failure(listening) { case some(f) => f.code, case none => dictationEnd })
  derive attachError = failed(attached) ? "That image couldn't be attached." : match attached { case some(a) => a.error, case none => "" }
  derive composerError = sendError != "" ? sendError : attachError != "" ? attachError : dictationError
  // A live stream that ended (the host restarted, the network dropped) is opened again.
  derive hostLost = match failure(host) { case some(f) => true, case none => false }
  derive accountLost = match failure(account) { case some(f) => true, case none => false }
  derive chatLost = match failure(chat) { case some(f) => true, case none => false }
  derive appsLost = match failure(apps) { case some(f) => true, case none => false }
  derive buildLost = match failure(build) { case some(f) => true, case none => false }
  // The host serves a newer build (an app was added, previewed, saved or undone): relaunch into it. Only where the host
  // served this shell: the Mac app relaunches into the build it carries, which would be stale again, forever.
  derive stale = host.served and build.id != "" and build.id != builtVersion()
  // A page the host did not serve (the Mac app) runs on the screens it carries: a preview there shows the new
  // version's data on the screen this build has, and the page says so.
  derive behind = not host.served and build.id != "" and build.id != builtVersion()
  // No host answers: none is known yet (a Mac app installed without the installer), or the saved one is unreachable.
  derive unreachable = hostLost or (accountLost and hostAddress != "")
  // Imp is opening: the host has not said whether it is set up yet, or it is and the chat has not arrived.
  derive opening = (not unreachable and (account.status == "" or account.status == "checking"
    or (signedIn and not needsComputer and chat.current == "")))
  derive computer = account.computer
  // The computer's screen above the composer while the imp uses the browser, on every page but the Computer tab, which
  // shows it already. Its frame connects to the screen only while it shows.
  derive previewing = chat.browsing and computer.status == "ready" and nav.tab != "computer"
  derive memory = account.memory
  derive tricks = account.tricks
  derive routines = account.routines
  // The app directory, while its feature flag is on.
  derive directoryOn = account.flags.filter(f => f.key == "app-directory" and f.on).length > 0
  derive secrets = account.secrets
  derive secretError = match secretSaved { case some(r) => r.error, case none => "" }
  derive serverError = match serverAdded { case some(r) => r.error, case none => "" }
  derive serverRemoveError = match serverRemoved { case some(r) => r.error, case none => "" }
  derive loginError = match loginSaved { case some(r) => r.error, case none => "" }
  derive secretDeleteError = match secretDeleted { case some(r) => r.error, case none => "" }
  derive backup = account.backup
  // GitHub, the one connection there is so far.
  derive github = match first(account.connections.filter(c => c.id == "github")) {
    case some(c) => c, case none => Connection(id="github", label="GitHub", status="off", code="", url="", login="", error="") }
  derive switchError = match computerSwitched { case some(r) => r.error, case none => "" }
  derive keyError = match computerKeySaved { case some(r) => r.error, case none => "" }
  // Notifications: what the host noticed since this page last looked, shown while no Imp window is in front, and
  // what waits on the person (routines with a run they have not opened, keys the imp asked for) on the app's badge.
  derive newest = noticeAt(account.notices, 0)
  derive canNotify = alerts.available and alerts.state == "granted"
  derive waiting = routines.filter(r => r.unread).length + secrets.requests.length
  // What the imp asked for in the open chat: its card shows there, and every other chat leaves it alone.
  derive asked = secrets.requests.filter(q => q.conversation != "" and q.conversation == chat.current)

  // A new build (a preview, above all) loads at once, not at the next reconnect: until it does, the page shows the
  // draft's bar over the screen of the version before.
  task relaunchStale when stale
    after(1, relaunchNow)
  task appearance mount
    after(1, applyScheme)
  task heal mount
    every(3000, reconnect)
  task clock mount
    every(60000, tick)
  task watchComputer when computerAwaited
    every(5000, refreshDevices)
  task foldDictation when recognitionId != "" and heard.id == recognitionId key=heard.finalCount
    change(foldHeard)
  task endDictation when dictating and recognitionId != "" and heard.id == recognitionId and heard.state == "ended"
    after(1, dictationEnded)
  // A refused start (no microphone, permission denied) runs no `then`.
  task dictationRefused when failed(listening) key=true
    change(dictationOff)
  task micRefused when failed(micOpened) key=true
    change(dictationOff)
  task putBack when sendLost and (unsent != "" or unsentImages.length > 0)
    after(1, restoreUnsent)
  task revealKeys when keyboard and metaAlone and not keysShown
    after(400, showKeys)
  // A key let go while another window has the focus sends no keyup.
  task releaseKeys when (metaAlone or keysShown) and not page.hasFocus
    after(1, hideKeys)
  task announce when signedIn key=newest.at
    change(announceNotices)
  task badge when signedIn and alerts.badge key=waiting
    change(showWaiting)
  task leaveOffTab when offTab
    after(1, toChat)
  // Opening Imp asks the host for the chat it opens on beside the account stream, not after it. A host that refuses still lets
  // the chat open, on the conversation it has.
  task openHome when host.origin != "" key=host.origin
    change(startHome)
  task homeRefused when failed(openedHome) key=true
    change(land)
  task openAdded when toOpen != "" and appTabs.includes(toOpen)
    after(1, showAdded)
  task openBuilt when firstBuild and builtApp != ""
    after(1, showBuilt)
  // Beside an app sits the latest chat started beside it, or a new chat until there is one, whichever conversation
  // was open before: the host keeps which app each chat is about, so a reload shows the same one.
  task openBeside when landed and docked and apps.map(a => a.id).includes(nav.tab) key=nav.tab
    change(showBeside)

  action applyScheme
    setScheme(scheme)
  // Every key, wherever the focus is. ⌘ pressed on its own starts the wait for the hints; any other key ends it,
  // and the hints already shown stay while ⌘ does.
  action keyDown(k: string, e: KeyboardEvent)
    metaAlone = k == "Meta" and not e.shiftKey and not e.ctrlKey and not e.altKey
    keysShown = keysShown and e.metaKey
    // ⌘L, by the key under it whatever the layout types there: no button holds it, since the message box is the
    // target and it is not a button.
    if e.metaKey and not e.shiftKey and not e.ctrlKey and not e.altKey and e.code == "KeyL"
      preventDefault()
      focusComposer()
  // Into the message box on the screen: the chat's beside an open app, else the chat tab's, which this opens.
  action focusComposer
    if docked
      focus("side-composer")
    else
      drawer = false
      nav = select(nav, "chat")
      focus("composer")
  action keyUp(k: string, e: KeyboardEvent)
    if not e.metaKey
      hideKeys()
  action showKeys
    keysShown = metaAlone
  action hideKeys
    metaAlone = false
    keysShown = false
  action tick
    now = performanceNow()
    refresh update
  action restartToUpdate
    send restarting = updateRestart()
  action quitForUpdate
    if match restarting { case some(r) => r.ok, case none => false }
      close()
  action restoreUnsent
    if draft.trim() == "" and attachments.length == 0
      draft = unsent
      attachments = unsentImages
    unsent = ""
    unsentImages = []
  // Files attached to the next message: the data module makes an image of each, up to four in all.
  action attach(paths: string[])
    if paths.length > 0
      send attached = chatAttach(paths, 4 - attachments.length, shown)
  action addAttached
    match attached
      case some(a)
        attachments = attachments.concat(a.paths).slice(0, 4)
      case none
        attachments = attachments
  action detach(path: string)
    attachments = attachments.filter(p => p != path)
  action relaunchNow
    relaunch()
  action reconnect
    if hostLost
      refresh host
    if accountLost
      refresh account
    if chatLost
      refresh chat
    if appsLost
      refresh apps
    if buildLost
      refresh build
    if stale
      relaunch()
    // <apps:refresh>
    if githubReadInboxLost
      refresh githubReadInbox
    if todosReadListLost
      refresh todosReadList
    // </apps:refresh>
  action pick(name: string)
    nav = select(nav, name)
  // Settings, open at one of its sections.
  action openSettings(section: string)
    settingsPane = section
    nav = select(nav, "settings")
  action toChat
    nav = select(nav, "chat")
  action startHome
    if not pending(openedHome)
      send openedHome = chatBeside(wide ? nav.tab : "")
  action land
    landed = true
  action follow(url: string)
    nav = go(nav, url)
  // Step 1's two ways in are folds, and one is open at a time: opening ChatGPT's starts its sign-in, folding it
  // cancels that, and opening the key's cancels a sign-in under way.
  action foldChatGPT
    if signingIn
      send signInCancelled = accountCancel()
    else
      keyForm = false
      onboardingBack = ""
      send signInStarted = accountSignIn()
  action toggleKeyForm
    if not keyForm and signingIn
      send signInCancelled = accountCancel()
    keyForm = not keyForm
  action editKeyBase(v: string)
    keyBase = v
  action editKeyValue(v: string)
    keyValue = v
  action editKeyModel(v: string)
    keyModel = v
  action useKey
    if not pending(keyUsed)
      send keyUsed = accountUseKey(keyBase, keyValue, keyModel)
  // A key the host took is not kept in the page.
  action afterKeyUsed
    if match keyUsed { case some(r) => r.ok, case none => false }
      keyValue = ""
      keyForm = false
      onboardingBack = ""
  action askSignOut
    showModal("confirm-signout")
  action signOut
    send signedOut = accountSignOut()
  action chooseModel(id: string)
    send modelChosen = accountChooseModel(id)
  action copyCode
    copyText(account.code)
  action setAppearance(value: string)
    scheme = value
    setScheme(value)
  action edit(v: string)
    draft = v
  // Sending while dictating sends the words heard so far, the unsure ones too, and ends the dictation.
  action post(where: string)
    let message = withSpoken(draft, interimHeard).trim()
    if (message != "" or attachments.length > 0) and not pending(sent) and not pending(attached)
      send sent = chatSend(message, where == "side-" ? nav.tab : "", attachments)
      unsent = message
      unsentImages = attachments
      draft = ""
      attachments = []
      if dictating
        hush()
    if where == "side-"
      focus("side-composer")
    else
      focus("composer")
  // The microphone button: starts dictation, or stops it, which lets the recognizer finish the words it is on.
  action dictate
    if not dictating
      dictating = true
      recognitionId = ""
      dictationEnd = ""
      if micDirect
        send listening = startSpeechRecognition(microphone=true, continuous=true, interimResults=true)
      else
        send micOpened = getUserMedia(audio=true)
    else if recognitionId == ""
      hush()
    else if heard.state != "stopping"
      send unheard = stopSpeechRecognition(recognition=recognitionId)
  // Ends dictation at once, dropping the words not yet final. A start still in flight is superseded, so its
  // recognition is aborted when it answers.
  action hush
    if recognitionId == ""
      send listening = abortSpeechRecognition(recognition="")
      if not micDirect
        send micOpened = getUserMedia(audio=false)
    else
      send unheard = abortSpeechRecognition(recognition=recognitionId)
    dictating = false
    recognitionId = ""
    closeMic()
  // The microphone opened for dictation: the recognizer listens to its track, unless dictation stopped meanwhile.
  action micReady
    match micOpened
      case some(m)
        let track = match m.tracks.at(0) { case some(t) => t.id, case none => "" }
        if dictating and track != ""
          micTrack = track
          send listening = startSpeechRecognition(track=track, continuous=true, interimResults=true)
        else if track != ""
          send micClosed = stopTrack(track=track)
      case none
        micTrack = ""
  action closeMic
    if micTrack != ""
      send micClosed = stopTrack(track=micTrack)
    micTrack = ""
  action listened
    match listening
      case some(r)
        recognitionId = r.id
        dictated = 0
        if r.id == ""
          dictating = false
          closeMic()
      case none
        dictating = false
        closeMic()
  action dictationOff
    dictating = false
    closeMic()
  action foldHeard
    draft = withSpoken(draft, heardSince(heard, dictated))
    dictated = heard.finalCount
  // The recognition ended: the person stopped it, it heard silence for a while, or it failed. Its last words join
  // the draft.
  action dictationEnded
    foldHeard()
    dictationEnd = match heard.error { case some(e) => e, case none => "" }
    dictating = false
    recognitionId = ""
    closeMic()
  action suggest(text: string)
    if not pending(sent)
      send sent = chatSend(text, "", noImages)
      unsent = text
  action startApp
    draft = "Build me an app that "
    focus("composer")
  action stop
    send stopped = chatStop()
  action newChat
    drawer = false
    nav = select(nav, "chat")
    // A new chat starts empty: what was typed for the last one stays behind with it.
    draft = ""
    send chatChanged = chatNew()
    focus("composer")
  // Archive, beside a chat in the sidebar: the host takes it out of the list, and moves an open one to a new chat.
  action archiveChat(id: string)
    send chatArchived = chatArchive(id)
  action restoreChat(id: string)
    send chatArchived = chatRestore(id)
  action showBeside
    send chatChanged = chatBeside(nav.tab)
  action showChat(id: string)
    drawer = false
    nav = select(nav, "chat")
    if id != chat.current
      send chatChanged = chatShow(id)
    seen(id)
  // A routine's conversation, which shows what each run found and takes the person's reply.
  action showRoutine(id: string)
    drawer = false
    nav = select(nav, "chat")
    send routineOpened = routinesOpen(id)
    seen(id)
  // A conversation the person opened: its notification has nothing more to tell.
  action seen(id: string)
    if canNotify
      closeNotification(tag=`conversation-${id}`)
  // New notices, while no Imp window is in front: the person is elsewhere. One answer can bring two, such as a key
  // the imp asked for and the reply that followed it; up to three are shown, the oldest first.
  action announceNotices
    if noticedAt >= 0 and canNotify and not page.hasFocus
      notify(noticeAt(account.notices, 2))
      notify(noticeAt(account.notices, 1))
      notify(noticeAt(account.notices, 0))
    noticedAt = newest.at
  action notify(n: Notice)
    if n.at > noticedAt
      showNotification(title=n.title, body=n.body, tag=noticeTag(n), data=`${n.kind}:${n.conversation}`)
  // A notification clicked: its conversation opens, the chat that asked for a key, or Settings' secrets for an old request.
  action openNotice(tag: string, e: NotificationEvent)
    let about = match e.data { case some(d) => d, case none => "" }
    if about.startsWith("routine:")
      showRoutine(about.slice(8))
    else if about.startsWith("reply:")
      showChat(about.slice(6))
    else if about.startsWith("key:") and about.length > 4
      showChat(about.slice(4))
    else if about.startsWith("key:")
      openSettings("secrets")
  action showWaiting
    if waiting > 0
      setAppBadge(contents=waiting)
    else
      clearAppBadge()
  action allowNotifications
    send alertsAsked = requestNotificationPermission()
  action runRoutine(id: string)
    send routineRan = routinesRun(id)
  action pauseRoutine(id: string, paused: bool)
    send routinePaused = routinesPause(id, paused)
  action askDeleteRoutine
    showModal("confirm-routine-delete")
  action deleteRoutine
    send routineDeleted = routinesDelete(chat.current)
  action openRoutines
    drawer = false
    nav = select(nav, "routines")
  // A routine asked for from the Routines page: the message starts with a schedule, and the person adds the rest.
  action askRoutine
    into("Every weekday at 8, ")
  action openTricks
    drawer = false
    nav = select(nav, "tricks")
  // A trick asked for in the open conversation: its name starts the message, and the person adds what it asks for.
  action useTrick(title: string)
    into(`${title}: `)
  // A message started for the person: in the chat beside the page, or on a narrow window the chat's own page.
  action into(text: string)
    draft = text
    if docked
      focus("side-composer")
    else
      nav = select(nav, "chat")
      focus("composer")
  action openDirectory
    drawer = false
    nav = select(nav, "directory")
  // An app from the directory, or a link to one: the imp brings it in as a preview, in the open conversation.
  action installApp(repo: string)
    if not pending(sent)
      nav = select(nav, "chat")
      send sent = chatSend(installAsk(repo), "", noImages)
      unsent = ""
  action toggleOlder
    olderOpen = not olderOpen
  action toggleArchived
    archivedOpen = not archivedOpen
  action toggleDrawer
    drawer = not drawer
  action toEnd
    unsent = ""
    if docked
      scrollIntoView("side-transcript", lastId, block="end")
    else
      scrollIntoView("transcript", lastId, block="end")
  // The wordmark: back to the home page, a new chat with its greeting, unless the open one is still empty.
  action goHome
    drawer = false
    nav = select(nav, "chat")
    if chat.messages.length > 0 or chat.routine != ""
      draft = ""
      send chatChanged = chatNew()
  action editHost(v: string)
    hostDraft = v
  action connect
    if hostDraft.trim() != ""
      hostAddress = hostDraft.trim().includes("://") ? hostDraft.trim() : `https://${hostDraft.trim()}`
      refresh account
  action saveApp(id: string)
    send appSaved = appsSave(id)
  action discardApp(id: string)
    send appDiscarded = appsDiscard(id)
  action undoApp(id: string)
    send appUndone = appsUndo(id)
  action syncApp(id: string)
    send appSynced = appsSync(id)
  // An app Imp ships, from the onboarding or the app directory: the host installs it.
  action addApp(id: string)
    if not pending(appInstalled)
      added = id
      send appInstalled = appsInstall(id)
  // The first app: the person's ask to the imp, which builds a new app from scratch while they watch in the chat, or
  // Imp's GitHub app as it ships.
  action buildFirstApp
    if firstAsk.trim() != "" and not pending(sent)
      firstBuild = true
      nav = select(nav, "chat")
      send sent = chatSend(firstAsk.trim(), "", noImages)
  action skipFirstApp
    addApp("github")
  action editFirstAsk(v: string)
    firstAsk = v
  // An installed app opens once the shell lists it.
  action afterInstall
    if match appInstalled { case some(r) => r.ok, case none => false }
      toOpen = added
  // The app the imp built for the first app opens once its preview is in the shell, with the chat it was built in
  // beside it.
  action showBuilt
    toOpen = builtApp
    firstBuild = false
  action showAdded
    nav = select(nav, toOpen)
    toOpen = ""
  action uninstallApp(id: string)
    send appUninstalled = appsUninstall(id)
  // <apps:members>
  resource githubReadInbox = githubInbox() when signedIn and nav.tab == "github" and not page.frozen as shape GithubInbox else empty()
  derive githubReadInboxLost = match failure(githubReadInbox) { case some(f) => true, case none => false }
  mutation githubWroteDone as shape Reply queue
  action githubDoDone(arg1: string)
    send githubWroteDone = githubDone(arg1)
  mutation githubWroteSnooze as shape Reply queue
  action githubDoSnooze(arg1: string, arg2: number)
    send githubWroteSnooze = githubSnooze(arg1, arg2)
  mutation githubWroteRestore as shape Reply queue
  action githubDoRestore(arg1: string)
    send githubWroteRestore = githubRestore(arg1)
  resource todosReadList = todosList() when signedIn and nav.tab == "todos" and not page.frozen as shape TodosTodo[] else empty()
  derive todosReadListLost = match failure(todosReadList) { case some(f) => true, case none => false }
  mutation todosWroteAdd as shape Reply queue
  action todosDoAdd(arg1: string)
    send todosWroteAdd = todosAdd(arg1)
  mutation todosWroteSetDone as shape Reply queue
  action todosDoSetDone(arg1: string, arg2: bool)
    send todosWroteSetDone = todosSetDone(arg1, arg2)
  mutation todosWroteRename as shape Reply queue
  action todosDoRename(arg1: string, arg2: string)
    send todosWroteRename = todosRename(arg1, arg2)
  mutation todosWroteRemove as shape Reply queue
  action todosDoRemove(arg1: string)
    send todosWroteRemove = todosRemove(arg1)
  // </apps:members>
  action useContainer
    send computerSwitched = computerUseContainer()
  action useCloud(size: string)
    send computerSwitched = computerUseCloud(size)
  action useOwn(device: string)
    if not (computer.kind == "own" and computer.device == device)
      send computerSwitched = computerUseOwn(device)
  action afterComputerChosen
    if match computerSwitched { case some(r) => r.ok, case none => false }
      onboardingBack = ""
    if match computerKeySaved { case some(r) => r.ok, case none => false }
      onboardingBack = ""
  // Back to the onboarding's step before the one on screen, and on again to where Imp is.
  action onboardingStepBack
    onboardingBack = onboardingStep == 3 ? "computer" : "model"
  action onboardingContinue
    onboardingBack = ""
  action toggleComputerChoice(next: string)
    computerChoice = computerChoice == next ? "" : next
  action refreshDevices
    send computerRefreshed = computerRefresh()
  action setCloudKey(key: string)
    send computerKeySaved = computerSetCloudKey(key)
  action retryComputer
    send computerRetried = computerRetry()
  // The computer's screen in a window of its own, which the host serves: on the web a new tab, in the apps the default
  // browser. It takes the app's appearance along. The Computer tab shows the same page.
  action openScreen
    openURL(`${host.origin}/computer/screen?scheme=${scheme}`)
  action copySetupPrompt
    copyText(computer.setupPrompt)
  action forget(entry: string, fact: string)
    send forgotten = memoryForget(entry, fact)
  action saveSecret(name: string, service: string, value: string, hosts: string, header: string, prefix: string, envName: string)
    if not pending(secretSaved)
      send secretSaved = secretsPut(name, service, value, hosts, header, prefix, envName)
  // A saved secret closes its form: the next one starts empty.
  action afterSecretSaved
    if match secretSaved { case some(r) => r.ok, case none => false }
      secretRound = secretRound + 1
  action saveLogin(name: string, site: string, username: string, password: string, otp: string)
    if not pending(loginSaved)
      send loginSaved = secretsPutLogin(name, site, username, password, otp)
  action afterLoginSaved
    if match loginSaved { case some(r) => r.ok, case none => false }
      secretRound = secretRound + 1
  action deleteSecret(name: string)
    send secretDeleted = secretsDelete(name)
  action dismissSecret(id: string)
    send secretDismissed = secretsDismiss(id)
  action connectGithub
    send githubConnected = connectionsConnect()
  action cancelGithub
    send githubCancelled = connectionsCancel()
  action disconnectGithub
    send githubDisconnected = connectionsDisconnect()
  action copyGithubCode
    copyText(github.code)
  action addServer(name: string, url: string, key: string)
    if not pending(serverAdded)
      send serverAdded = connectionsAddServer(name, url, key)
  action afterServerAdded
    if match serverAdded { case some(r) => r.ok, case none => false }
      serverRound = serverRound + 1
  // The sign-in comes back to the address this page reaches the host at.
  action signInServer(id: string)
    send serverSignedIn = connectionsSignInServer(id, host.origin)
  action cancelServer(id: string)
    send serverCancelled = connectionsCancelServer(id)
  action removeServer(id: string)
    send serverRemoved = connectionsRemoveServer(id)
  action turnOnBackup
    send backupTurnedOn = backupTurnOn()
  action turnOffBackup
    send backupTurnedOff = backupTurnOff()
  action chooseFlag(key: string, on: bool)
    send flagChosen = flagsChoose(key, on)
  action shareApp(id: string, on: bool)
    send appShared = assistantsShare(id, on)
  action copyMcpUrl
    copyText(`${host.origin}/mcp`)

  view
    main navigationKey=`${top(nav).id}` navigate=follow key=keyDown keyup=keyUp notificationclick=openNotice testId="app" width="100%" height="100%"
      display="flex" flex-direction="column" position="relative" viewport-fit="cover" interactive-widget="resizes-content"
      background-color="surface.page"
      color="ink.strong" class=Page
      // While the host has not said yet whether Imp is set up, or the home page has not arrived: the mark alone, so
      // neither the onboarding nor the last conversation flashes first.
      if opening
        row flex=1 align-items="center" justify-content="center" gap="space.md" role="status" aria-label="Opening Imp"
          testId="opening" animation=(still ? "none" : "rise 400ms ease-out both")
          image "symbol:icon.imp" width=44 height=44 aria-hidden=true
            animation=(still ? "none" : "pulse 1.6s ease-in-out infinite")
          text aria-hidden=true class=Display
            text "I" class=Initial margin-right="0.04em"
            text "mp"
      else if signedIn and not needsComputer and not needsFirstApp
        // The routes. On a wide window they sit between the sidebar and, beside every page but the chat's, the chat.
        // They, the sidebar and the chat start below the window's top inset: on the Mac the page covers the title bar,
        // and the window's toolbar there would hide each column's bar.
        column position="absolute" left=(wide ? "measure.sidebar" : "0px") bottom="0px" top="env(safe-area-inset-top)" right=(docked ? "measure.chat" : "0px")
          for t in nav.tabs key=t.name
            column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
              for e in t.stack key=e.id
                column navigationKey=`${e.id}` navigationScroll=(e.name == "chat" ? "transcript" : e.name == "settings" ? "settings-list" : ["routines", "tricks", "directory"].includes(e.name) ? `${e.name}-list` : `${e.name}-screen`)
                  position="absolute" inset=0 display="flex" flex-direction="column" box-sizing="border-box"
                  padding-bottom=(wide ? "0" : "calc(3.5rem + env(safe-area-inset-bottom))")
                  // On a wide window every page's header is the same bar, as tall as the sidebar's and the chat
                  // column's, its title at the left: switching pages moves nothing. The home page has none there:
                  // its greeting is its title.
                  header display=(homeWide and e.name == "chat" ? "none" : "flex") justify-content="center" padding=(wide ? "0 space.lg" : "0 space.md")
                    border-bottom="1px solid line.subtle" background-color="surface.page"
                    row width="100%" max-width=(wide ? "none" : "measure.page") align-items="center" gap="space.ms"
                      height=(wide ? "measure.bar" : "auto") box-sizing="border-box" padding=(wide ? "0" : "space.ms 0 space.ms")
                      if ["chat", "routines", "tricks", "directory"].includes(e.name) and not wide
                        button press=toggleDrawer aria-label="Conversations, routines and tricks" aria-expanded=drawer
                          cursor="pointer"
                          aria-keyshortcuts="Control+Meta+S" testId="drawer-toggle" appearance="none" width=32 height=32
                          padding=0 display="flex" align-items="center" justify-content="center"
                          border="1px solid line.strong" background-color="transparent" color="ink.strong" position="relative"
                          image "symbol:icon.menu" width=16 height=16
                          if keys
                            KeyBadge(chord="Control+Meta+S", at="end")
                        image "symbol:icon.imp" width=26 height=26 aria-hidden=true
                      Initialled(word=(e.name == "chat" and chat.routine != "" ? chat.routine : tabTitle(e.name, wide, apps)), size=(wide ? "1.75rem" : "1.5rem"), heading=1)
                      // An app's page has one bar: its controls sit in the header, beside its title.
                      for a in apps.filter(a => a.id == e.name) key=a.id
                        AppBar(app=a, wide=wide, keys=keys, save=saveApp, discard=discardApp, undoSave=undoApp,
                          syncNow=syncApp, uninstall=uninstallApp, uninstallError=uninstallError)
                      if not apps.map(a => a.id).includes(e.name)
                        row flex=1
                      if e.name == "chat" and chat.busy
                        row gap="space.sm" align-items="center" testId="busy"
                          row width=6 height=6 background-color="AccentColor" aria-hidden=true
                            animation=(still ? "none" : "pulse 1.2s ease-in-out infinite")
                          text "Imp at work" class=Label color="ink.strong"
                      else if not wide and not apps.map(a => a.id).includes(e.name)
                        text formatDate(shown, time.utcOffset, "medium") class=Label
                      // New chat from any page; on a wide window the sidebar has it.
                      if not wide
                        button press=newChat aria-label="New chat" aria-keyshortcuts="Meta+N" testId=`new-chat-${e.name}`
                          cursor="pointer"
                          appearance="none" width=32 height=32 padding=0 display="flex" align-items="center"
                          justify-content="center" border="1px solid line.strong" background-color="transparent"
                          color="ink.strong" position="relative"
                          :hover
                            background-color="surface.soft"
                          image "symbol:icon.compose" width=15 height=15
                          if keys
                            KeyBadge(chord="Meta+N", at="end")
                  if e.name == "routines"
                    RoutineList(routines=routines, open=showRoutine, ask=askRoutine)
                  else if e.name == "tricks"
                    TrickList(tricks=tricks, use=useTrick)
                  else if e.name == "directory"
                    AppDirectory(entries=directory(), installed=apps, sending=pending(sent),
                      install=installApp, add=addApp, adding=pending(appInstalled), open=pick)
                  else if e.name == "chat"
                    for r in routines.filter(r => r.id == chat.current) key=r.id
                      RoutineBar(routine=r, busy=(pending(routineRan) or pending(routinePaused) or pending(routineDeleted)),
                        run=runRoutine, pause=pauseRoutine, remove=askDeleteRoutine, keys=keys)
                    Confirm(id="confirm-routine-delete", question="Delete this routine?",
                      message="It stops running, and its conversation goes with it.", label="Delete",
                      confirm=deleteRoutine, testId="routine-delete")
                    if homeWide
                      // Home on a wide window: the day and the computer over an ink rule, the greeting, what to try
                      // and the apps, in the chat's column above the composer at the foot, which stays where the
                      // chat has it, so sending the first message moves nothing.
                      scroll id="home-scroll" flex=1 min-height=0
                        row justify-content="center" padding="space.xl space.md"
                          column width="100%" max-width="measure.page" gap="space.ms" testId="home"
                            row align-items="center" gap="space.ms" padding-bottom="space.sm" border-bottom="1px solid ink.strong"
                              text formatDate(shown, time.utcOffset, "medium") class=Label flex=1
                              if computer.status != "none"
                                row align-items="center" gap="space.sm" testId="home-computer"
                                  row width=6 height=6 aria-hidden=true
                                    background-color=computerMark(computer)
                                  text computer.name class=Label
                            column gap="space.ms" padding-top="space.lg"
                              Initialled(word=salutation, size="4.75rem", heading=1)
                              text "Ask for anything. Your imp uses your apps, works on a computer of its own, and builds new apps for you."
                                color="ink.muted" class=Lead max-width="measure.note"
                            column gap="space.xxl" padding-top="space.lg"
                              Suggestions(asks=asks, disabled=pending(sent), send=suggest)
                              HomeApps(apps=apps, computer=computer, tile=true, level=2, open=pick, build=startApp)
                    else if chat.messages.length == 0 and not chat.busy and chat.routine == ""
                      // Home on a narrow window: a greeting, the apps, and what to try, over the composer.
                      scroll id="home-scroll" flex=1 min-height=0
                        column max-width="48.5rem" margin="0 auto" padding="space.lg space.md space.lg" gap="space.lg" box-sizing="border-box"
                          width="100%" testId="home"
                          column gap="space.ms"
                            Initialled(word=salutation, size="2.5rem", heading=2)
                            text "Ask for anything. Your imp uses your apps, works on a computer of its own, and builds new apps for you."
                              color="ink.muted" class=Lead max-width="measure.note"
                          HomeApps(apps=apps, computer=computer, tile=false, level=3, open=pick, build=startApp)
                          column gap="space.sm"
                            text "Try" class=Label
                            Suggestions(asks=asks, disabled=pending(sent), send=suggest)
                    else
                      Transcript(prefix="", compact=false, messages=chat.messages, lastId=lastId, still=still, origin=host.origin)
                    // What the imp asked for, where the person pastes it: the value goes to the vault, not the conversation.
                    if asked.length > 0
                      row justify-content="center" padding="0 space.md"
                        column width="100%" max-width="measure.page" gap="space.sm"
                          for q, k in asked key=q.id
                            SecretAsk(request=q, prefix="", index=k, saving=(pending(secretSaved) or pending(loginSaved)),
                              error=(q.service == "login" ? loginError : secretError), save=saveSecret, saveLogin=saveLogin, dismiss=dismissSecret,
                              github=github, githubBusy=pending(githubConnected), connectGithub=connectGithub, cancelGithub=cancelGithub, copyGithubCode=copyGithubCode)
                    if previewing and nav.tab == "chat"
                      ScreenPreview(src=`${host.origin}/computer/screen?embed&view&scheme=${scheme}`, open=pick("computer"),
                        compact=false, still=still)
                    Composer(prefix="", placeholder=(chat.routine == "" ? "Ask your imp" : `Reply to ${chat.routine}`), compact=false, draft=draft, busy=chat.busy,
                      sending=pending(sent), stopping=pending(stopped), error=composerError, edit=edit, post=post, stop=stop,
                      canDictate=canDictate, dictating=dictating, heard=interimHeard, dictate=dictate, keys=keys,
                      model=account.model, models=account.models, chooseModel=chooseModel,
                      attachments=attachments, attaching=pending(attached), attach=attach, detach=detach)
                  else if e.name == "settings"
                    scroll id="settings-list" flex=1 min-height=0
                      column max-width="48.5rem" margin="0 auto" padding="space.md space.md space.xl" gap="space.lg" box-sizing="border-box" width="100%"
                        // Settings' sections, one at a time.
                        row role="group" aria-label="Settings sections" gap="space.ms" overflow-x="auto"
                          border-bottom="1px solid line.subtle" testId="settings-sections"
                          for s in ["general", "computer", "memory", "secrets", "connections", "assistants", "experimental"] key=s
                            button press=openSettings(s) aria-pressed=(settingsPane == s) testId=`settings-pane-${s}`
                              cursor="pointer"
                              appearance="none" display="flex" align-items="baseline" padding="space.sm 0" margin-bottom="-1px" border="none"
                              border-bottom=(settingsPane == s ? "2px solid ink.strong" : "2px solid transparent")
                              background-color="transparent" color=(settingsPane == s ? "ink.strong" : "ink.muted")
                              class=Label
                              white-space="nowrap"
                              :hover
                                color="ink.strong"
                              text capitalized(s)
                              if settingsCount(s, memory, secrets) != ""
                                text settingsCount(s, memory, secrets) color="ink.faint" margin-left="space.xs"
                                  testId=`settings-count-${s}`
                        if settingsPane == "computer"
                          ComputerSettings(computer=computer, switching=pending(computerSwitched) or pending(computerKeySaved),
                            switchError=(keyError != "" ? keyError : switchError), setCloudKey=setCloudKey,
                            refreshing=pending(computerRefreshed), useContainer=useContainer, useCloud=useCloud, useOwn=useOwn, refresh=refreshDevices,
                            retry=retryComputer, openScreen=pick("computer"), copyPrompt=copySetupPrompt)
                        else if settingsPane == "memory"
                          MemorySettings(memory=memory, forget=forget)
                        else if settingsPane == "secrets"
                          for r in [secretRound] key=`${r}`
                            SecretSettings(secrets=secrets, saving=(pending(secretSaved) or pending(loginSaved)), error=secretError,
                              loginError=loginError, deleteError=secretDeleteError, save=saveSecret, saveLogin=saveLogin,
                              remove=deleteSecret, dismiss=dismissSecret)
                        else if settingsPane == "connections"
                          SettingsPage(intro="The accounts and services your imp reaches for you, and where your apps' code is kept.",
                            testId="connections-page")
                            ConnectionsSettings(github=github, backup=backup,
                              busy=(pending(githubConnected) or pending(githubDisconnected) or pending(backupTurnedOn) or pending(backupTurnedOff)),
                              connect=connectGithub, cancel=cancelGithub, disconnect=disconnectGithub, copyCode=copyGithubCode,
                              turnOn=turnOnBackup, turnOff=turnOffBackup)
                            for r in [serverRound] key=`${r}`
                              McpServerSettings(servers=account.mcpServers, adding=pending(serverAdded), error=serverError,
                                removeError=serverRemoveError, add=addServer, signIn=signInServer, cancel=cancelServer,
                                remove=removeServer)
                        else if settingsPane == "assistants"
                          AssistantsSettings(apps=account.assistants, url=`${host.origin}/mcp`, copyUrl=copyMcpUrl, share=shareApp)
                        else if settingsPane == "experimental"
                          ExperimentalSettings(flags=account.flags, choose=chooseFlag)
                        else
                          GeneralSettings(account=account, onKey=onKey, scheme=scheme, setAppearance=setAppearance, alerts=alerts,
                            asking=pending(alertsAsked), allow=allowNotifications, signingOut=pending(signedOut), signOut=askSignOut)
                    Confirm(id="confirm-signout", question=(onKey ? "Remove the API key?" : "Sign out of ChatGPT?"),
                      message="Your imp stops until you sign in again. Your chats and apps stay.", label="Sign out",
                      confirm=signOut, testId="signout")
                  if e.name == "computer"
                    ComputerScreen(computer=computer, src=`${host.origin}/computer/screen?embed&scheme=${scheme}`,
                      shown=(nav.tab == "computer"), openTab=openScreen, setUp=openSettings("computer"))
                  // <apps:screens>
                  if e.name == "github"
                    AppPage(id="github", name=tabLabel("github", apps), draft=hasDraft("github", apps), reads=readsOf("github", apps), behind=behind, origin=host.origin, needs=needsOf("github", apps), openSettings=openSettings, github=github, githubBusy=pending(githubConnected), connectGithub=connectGithub, cancelGithub=cancelGithub, copyGithubCode=copyGithubCode)
                      GithubScreen(inbox=githubReadInbox, done=githubDoDone, snooze=githubDoSnooze, restore=githubDoRestore)
                  if e.name == "todos"
                    AppPage(id="todos", name=tabLabel("todos", apps), draft=hasDraft("todos", apps), reads=readsOf("todos", apps), behind=behind, origin=host.origin, needs=needsOf("todos", apps), openSettings=openSettings, github=github, githubBusy=pending(githubConnected), connectGithub=connectGithub, cancelGithub=cancelGithub, copyGithubCode=copyGithubCode)
                      TodosScreen(list=todosReadList, add=todosDoAdd, setDone=todosDoSetDone, rename=todosDoRename, remove=todosDoRemove)
                  // </apps:screens>
        // The tabs: on a wide window the sidebar's apps, with Settings at its foot; on a narrow one a bar along the
        // bottom, Settings with them. Every tab stays in a tablist, hidden while nothing shows it: a tab left out
        // unlinks its panel, which then shows over every page.
        if wide
          aside position="absolute" top="env(safe-area-inset-top)" left=0 bottom=0 width="measure.sidebar" box-sizing="border-box"
            display="flex" flex-direction="column" border-right="1px solid line.subtle" background-color="surface.soft"
            aria-label="Apps, conversations, routines and settings"
            // The wordmark, in a bar as tall as the page's: home.
            row height="measure.bar" min-height="measure.bar" box-sizing="border-box" align-items="center" padding="0 space.md"
              border-bottom="1px solid line.subtle"
              button press=goHome aria-label="Imp, home" testId="home-logo" appearance="none" display="flex"
                cursor="pointer"
                align-items="center" gap="space.sm" padding="space.xs space.xs" margin-left="-4px" border="none"
                background-color="transparent" color="ink.strong"
                :hover
                  background-color="line.subtle"
                image "symbol:icon.imp" width=26 height=26 aria-hidden=true
                text aria-hidden=true class=Title
                  text "I" class=Initial margin-right="0.04em"
                  text "mp"
            Sidebar(prefix="", conversations=chat.conversations, current=chat.current, tab=nav.tab, atHome=atHome, home=goHome, tricks=tricks.length,
              routines=routines, olderOpen=olderOpen, newChat=newChat, show=showChat, archive=archiveChat, touch=(media.pointer == "coarse"),
                archived=chat.archived, archivedOpen=archivedOpen, toggleArchived=toggleArchived, restore=restoreChat, openRoutines=openRoutines,
              openTricks=openTricks, openDirectory=openDirectory, toggleOlder=toggleOlder, keyboard=keyboard,
              directory=directoryOn, still=still)
              // The apps, and the computer once there is one. The chat's, Settings' and the imp's pages' tabs stay
              // here, hidden, for their panels: the sidebar's own rows open them.
              column gap="space.xxs" padding="0 space.sm space.sm"
                if appTabs.length > 0
                  text "Apps" class=Label padding="space.sm space.ms space.xs"
                column role="tablist" aria-label="Apps" aria-orientation="vertical" appearance="none" testId="tabs"
                  gap="space.xxs" background-color="transparent" border="none"
                  for t in nav.tabs key=t.name
                    AppTab(prefix=(t.name == "settings" ? "bar-" : ""), name=t.name, label=tabLabel(t.name, apps),
                      symbol=tabSymbol(t.name, apps), chord=(t.name == "settings" ? "" : tabChord(t.name, appTabs)),
                      selected=(nav.tab == t.name), shown=barTabs.includes(t.name), keys=keys, side=true,
                      draft=hasDraft(t.name, apps), press=pick)
            // The sidebar's foot: a ready release of the Mac app above Settings, which opens like a button and shows
            // no open state.
            column box-sizing="border-box" justify-content="center" gap="space.xs" padding="space.sm space.sm"
              border-top="1px solid line.subtle"
              if update.version != ""
                RestartButton(version=update.version, busy=pending(restarting), press=restartToUpdate,
                  testId="update-restart")
              button press=pick("settings") aria-keyshortcuts="Meta+,"
                cursor="pointer"
                testId="tab-settings" appearance="none" display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm"
                border="none" text-align="start" color="ink.strong" border-left="2px solid transparent"
                background-color="transparent"
                :hover
                  background-color="line.subtle"
                image "symbol:icon.settings" width=16 height=16 aria-hidden=true
                text "Settings" class=Body flex=1
                if keys
                  text "⌘," class=Key aria-hidden=true testId="keys-Meta+,"
        else
          row role="tablist" aria-label="Apps" appearance="none" testId="tabs" position="absolute" left=0 right=0 bottom=0
            box-sizing="border-box" height="calc(3.5rem + env(safe-area-inset-bottom))"
            padding="0 0 env(safe-area-inset-bottom)" justify-content="center" align-items="stretch"
            background-color="surface.page" border-top="1px solid line.subtle"
            for t in nav.tabs key=t.name
              AppTab(prefix="", name=t.name, label=tabLabel(t.name, apps), symbol=tabSymbol(t.name, apps),
                chord=tabChord(t.name, appTabs), selected=(nav.tab == t.name),
                shown=barTabs.includes(t.name), keys=keys, side=false, draft=false, press=pick)
        // The chat, beside the open page on a wide window, tinted as the sidebar is: the same conversation, told what
        // the person is looking at. The chat's own page has none beside it, and takes its room.
        if docked
          aside position="absolute" top="env(safe-area-inset-top)" right=0 bottom=0 width="measure.chat" box-sizing="border-box"
            display="flex" flex-direction="column" border-left="1px solid line.subtle" background-color="surface.soft"
            aria-label="Chat" testId="chat-panel"
            row align-items="center" gap="space.sm" padding="0 space.sm 0 space.md" height="measure.bar" min-height="measure.bar" box-sizing="border-box"
              border-bottom="1px solid line.subtle"
              text "Chat" class=Label color="ink.strong" role="heading" aria-level=2
              if chat.busy
                row width=6 height=6 background-color="AccentColor" aria-label="Imp at work" testId="side-busy"
                  animation=(still ? "none" : "pulse 1.2s ease-in-out infinite")
              row flex=1
              button press=pick("chat") aria-label="Open the full chat" testId="chat-expand" appearance="none"
                cursor="pointer"
                width=32 height=32 padding=0 display="flex" align-items="center" justify-content="center"
                border="none" background-color="transparent" color="ink.muted"
                :hover
                  background-color="line.subtle"
                image "symbol:icon.expand" width=15 height=15
            if chat.messages.length == 0 and not chat.busy
              column flex=1 min-height=0 justify-content="flex-end" padding="space.lg space.md" gap="space.sm" testId="side-empty"
                Initialled(word=(sideSubject == "" ? "Ask your imp." : `Ask about ${sideSubject}.`), size="1.75rem", heading=3)
                text (nav.tab == "computer" ? "Ask your imp to do something on it, and watch it work."
                  : sideSubject != "" ? "Your imp can read it, change it, and build on it while you watch."
                  : "The conversation you have open, beside whatever page you are on.")
                  font-style="italic" color="ink.muted"
            else
              Transcript(prefix="side-", compact=true, messages=chat.messages, lastId=lastId, still=still, origin=host.origin)
            // What the imp asked for, where the person pastes it: the value goes to the vault, not the conversation.
            if asked.length > 0
              row justify-content="center" padding="0 space.ms"
                column width="100%" max-width="measure.page" gap="space.sm"
                  for q, k in asked key=q.id
                    SecretAsk(request=q, prefix="side-", index=k, saving=(pending(secretSaved) or pending(loginSaved)),
                      error=(q.service == "login" ? loginError : secretError), save=saveSecret, saveLogin=saveLogin, dismiss=dismissSecret,
                      github=github, githubBusy=pending(githubConnected), connectGithub=connectGithub, cancelGithub=cancelGithub, copyGithubCode=copyGithubCode)
            if previewing
              ScreenPreview(src=`${host.origin}/computer/screen?embed&view&scheme=${scheme}`, open=pick("computer"),
                compact=true, still=still)
            Composer(prefix="side-", placeholder=(sideSubject == "" ? "Ask your imp" : `Ask about ${sideSubject}`), compact=true, draft=draft, busy=chat.busy,
              sending=pending(sent), stopping=pending(stopped), error=composerError, edit=edit, post=post, stop=stop,
              canDictate=canDictate, dictating=dictating, heard=interimHeard, dictate=dictate, keys=keys,
              model=account.model, models=account.models, chooseModel=chooseModel,
                      attachments=attachments, attaching=pending(attached), attach=attach, detach=detach)
        // On a narrow window the sidebar opens as a drawer over everything.
        if drawer and not wide
          row position="absolute" inset=0 testId="drawer"
            aside width="17rem" max-width="85%" box-sizing="border-box" display="flex" flex-direction="column"
              padding-top="env(safe-area-inset-top)" background-color="surface.soft" border-right="1px solid line.strong"
              aria-label="Conversations, routines and tricks"
              Sidebar(prefix="drawer-", conversations=chat.conversations, current=chat.current, tab=nav.tab, atHome=atHome, home=goHome,
                tricks=tricks.length, routines=routines, olderOpen=olderOpen, newChat=newChat, show=showChat, archive=archiveChat, touch=(media.pointer == "coarse"),
                archived=chat.archived, archivedOpen=archivedOpen, toggleArchived=toggleArchived, restore=restoreChat,
                openRoutines=openRoutines, openTricks=openTricks, openDirectory=openDirectory, toggleOlder=toggleOlder,
                keyboard=keyboard, directory=directoryOn, still=still)
              // A narrow window's drawer has the sidebar's foot too: the ready release (Settings is in the tab bar).
              if update.version != ""
                column padding="space.sm space.sm" border-top="1px solid line.subtle"
                  RestartButton(version=update.version, busy=pending(restarting), press=restartToUpdate,
                    testId="drawer-update-restart")
            button press=toggleDrawer aria-label="Close" aria-keyshortcuts="Escape" testId="drawer-close" appearance="none"
              cursor="pointer"
              flex=1 border="none"
              background-color="ink.strong" opacity=0.25
      else
        // Onboarding, a wizard: one question a screen, a model first and then a computer.
        scroll flex=1 min-height=0
          column min-height="100%" box-sizing="border-box" padding="space.xl space.lg space.xl" gap="space.lg" max-width="measure.form" margin="0 auto"
            justify-content="center" testId="onboarding"
            row align-items="center" gap="space.sm" padding-bottom="space.ms" border-bottom="1px solid ink.strong"
              image "symbol:icon.imp" width=32 height=32 aria-hidden=true
              Initialled(word="Imp", size="2rem", heading=1)
              row flex=1
              if not unreachable
                if onboardingStep > 1 and not pending(appInstalled)
                  button press=onboardingStepBack aria-label="Back to the previous step" testId="onboarding-back"
                    appearance="none" cursor="pointer" display="flex" align-items="center" gap="space.xs"
                    padding="space.xs space.sm" border="none" background-color="transparent" color="ink.muted" class=Label
                    :hover
                      color="ink.strong"
                      background-color="surface.soft"
                    image "symbol:icon.back" width=12 height=12 aria-hidden=true
                    text "Back"
                text `${onboardingStep} / 3` class=Label testId="onboarding-step"
            if unreachable
              column gap="space.ms" testId="host-connect" animation=(still ? "none" : "rise 260ms ease-out both")
                WizardTitle(title=(hostAddress == "" ? "Connect to your Imp" : "Your Imp isn't answering"),
                  note=(hostAddress == "" ? "Its address on your tailnet." : `Nothing answered at ${hostAddress}.`))
                row align-items="center" gap="space.sm" padding="space.xs space.xs space.xs space.ms" border="1px solid line.strong"
                  input value=hostDraft input=editHost submit=connect placeholder="imp.your-tailnet.ts.net"
                    aria-label="Host address" testId="host-address" flex=1 min-width=0 padding="space.sm 0" border="none"
                    background-color="transparent" outline="none" class=Mono
                    color="ink.strong" autocapitalize="none" autocorrect="off" spellcheck=false
                  Button(press=connect, variant="primary", disabled=(hostDraft.trim() == ""), testId="host-connect-button")
                    text "Connect"
            else if needsFirstApp and onboardingBack == ""
              FirstAppWizard(ask=firstAsk, edit=editFirstAsk, busy=(pending(appInstalled) or pending(sent)), error=installError,
                build=buildFirstApp, skip=skipFirstApp, still=still)
            else if signedIn and onboardingBack != "model"
              ComputerWizard(computer=computer, switching=pending(computerSwitched) or pending(computerKeySaved),
                error=(keyError != "" ? keyError : switchError),
                useContainer=useContainer, setCloudKey=setCloudKey, useOwn=useOwn,
                copyPrompt=copySetupPrompt, choice=computerChoice, toggle=toggleComputerChoice,
                still=still)
              if not needsComputer
                WizardButton(label=`Keep ${computer.name}`, press=onboardingContinue, testId="onboarding-continue",
                  primary=false, disabled=(pending(computerSwitched) or pending(computerKeySaved)))
            else
              column gap="space.ms" animation=(still ? "none" : "rise 260ms ease-out both")
                image "assets/art/workshop.jpg" alt="An engraving of a workshop: a person at a desk among machines"
                  width="100%" height="auto" aspect-ratio="2 / 1" max-height="13rem" object-fit="cover"
                  border="1px solid line.subtle" box-sizing="border-box"
                WizardTitle(title="Connect a model", note="Your imp thinks with it.")
                if account.status == "failed"
                  text account.error color="ink.danger" class=Body testId="signin-error"
                WizardFold(label="Continue with ChatGPT", press=foldChatGPT, testId="signin", primary=(not signingIn),
                  open=signingIn, disabled=(pending(signInStarted) or pending(signInCancelled)))
                  if account.status == "waiting"
                    DeviceCode(code=account.code, url=account.url, site="ChatGPT", copy=copyCode, prefix="signin-")
                  else
                    row gap="space.sm" align-items="center"
                      progress aria-label="Connecting"
                      text "Connecting…" font-style="italic" color="ink.muted"
                WizardFold(label="Use an API key", press=toggleKeyForm, testId="key-open", primary=false, open=keyForm,
                  disabled=false)
                  column gap="space.ms" testId="key-form"
                    KeyField(label="API address", value=keyBase, edit=editKeyBase, secret=false,
                      placeholder="https://api.openai.com/v1", testId="key-base")
                    KeyField(label="API key", value=keyValue, edit=editKeyValue, secret=true, placeholder="sk-…",
                      testId="key-value")
                    KeyField(label="Model", value=keyModel, edit=editKeyModel, secret=false, placeholder="gpt-5",
                      testId="key-model")
                    if apiKeyError != "" and not pending(keyUsed)
                      text apiKeyError color="ink.danger" class=Body testId="key-error"
                    WizardButton(label=(pending(keyUsed) ? "Checking…" : "Connect"), press=useKey, testId="key-use",
                      primary=true, disabled=(pending(keyUsed) or keyBase.trim() == "" or keyValue.trim() == "" or keyModel.trim() == ""))
                if signedIn
                  WizardButton(label="Keep the model you have", press=onboardingContinue, testId="onboarding-continue",
                    primary=false, disabled=pending(keyUsed))

