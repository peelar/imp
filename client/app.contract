// Imp's shell: onboarding first (a model account, then a computer), then the chat home and the installed apps, compiled into one
// plan. Every source goes to the host through the one data module in app.ts, which streams each resource live. Each
// app's resources and mutations live here, in the root, because Contract allows them only there; its screen is
// imported from apps/<id>/app.contract. Colours and type are app.tamber's; the look is "Catalogue": white paper,
// black ink, engraved art, square corners, mono labels and one cobalt action.
//
// The host writes each app's part between the `// <apps:…>` markers from the props of the app's `component Screen`
// (host/src/studio/shell.ts); `node host/scripts/shell.ts` writes them for the apps in apps/. Do not edit between them.
// <apps:use>
use Screen as GithubScreen, Inbox as GithubInbox from "./apps/github/app.contract"
use Screen as TodosScreen, Todo as TodosTodo from "./apps/todos/app.contract"
// </apps:use>
use showNotification, closeNotification, setAppBadge, clearAppBadge, notificationStatus, requestNotificationPermission, notificationclick, NotificationStatus, NotificationEvent from "@exact/notifications"
use startSpeechRecognition, stopSpeechRecognition, abortSpeechRecognition, speechRecognitionState, speechRecognitionStatus, SpeechRecognitionInfo, SpeechRecognitionState, SpeechRecognitionStatus from "@exact/speech-recognition"

font "Instrument Serif" = "assets/fonts/InstrumentSerif-Regular.ttf"
font "Pinyon Script" = "assets/fonts/PinyonScript-Regular.ttf"
font "Newsreader"
  200 800 = "assets/fonts/Newsreader.ttf"
  200 800 italic = "assets/fonts/Newsreader-Italic.ttf"
font "IBM Plex Mono"
  400 = "assets/fonts/IBMPlexMono-Regular.ttf"
  500 = "assets/fonts/IBMPlexMono-Medium.ttf"

routes nav
  tab chat "/"
  // <apps:tabs>
  tab github "/github"
  tab todos "/todos"
  // </apps:tabs>
  // The imp's computer: its screen, beside the chat on a wide window, as an app's page is.
  tab computer "/computer"
  tab settings "/settings"

// Where the host answers: the page's own origin on the web, API_BASE_URL in a native build.
shape Host
  origin: string

// The model account the agent runs on: a ChatGPT plan, or a key for an OpenAI-compatible API. `status` is
// "checking", "signedOut", "starting", "waiting" (for the person to enter `code` at `url`), "signedIn", or "failed"
// (with `error`). `kind` is "chatgpt" or "apiKey" once signed in; a key's API is at `baseUrl` and runs `model`.
shape Account
  status: string
  code: string
  url: string
  error: string
  email: string
  plan: string
  kind: string
  baseUrl: string
  model: string
  // The agent's computer, what the imp remembers and the owner's secrets ride on the account's stream: a browser opens
  // at most six connections to a host over HTTP/1.1, and a seventh request (a mutation) would wait for one of the
  // shell's streams to end.
  computer: Computer
  memory: Memory
  secrets: Secrets
  backup: Backup
  tricks: Trick[]
  routines: Routine[]
  notices: Notice[]

// A row of the transcript: "user", "assistant" (Markdown), "activity" (a tool call, in words) or "error".
shape ChatMessage
  id: string
  role: string
  text: string
  title: string
  detail: string
  icon: string
  failed: bool

// While the assistant writes, its partial answer is the last message, with id "live".
// A conversation in the sidebar, named by its first message.
shape ChatSummary
  id: string
  title: string

// The open conversation (`current`, with its rows in `messages`) and every one with something said in it, the most
// recently written in first. `routine` names the routine whose conversation is open ("" for a chat); the routines'
// conversations are not in `conversations`.
shape ChatState
  messages: ChatMessage[]
  busy: bool
  current: string
  routine: string
  conversations: ChatSummary[]

// An installed app. `cover` is its engraving in the client's assets ("" for none), `symbol` its fallback icon.
// `draft` is true while the app shows a preview of a new version; `undo` says what undoing its last save does: ""
// (nothing to undo), "keep" (the data stays), "data" (the data goes back to before that save) or "remove" (the save
// made the app, so undoing removes it). `reads` says what the version shown reads from outside, such as "Reads
// api.github.com with your github key, every 15 min." ("" for nothing), and `sync` how its live version's sync went,
// such as "Synced 3 min ago" or "Syncing…" ("" for an app without a sync).
shape AppTile
  id: string
  name: string
  description: string
  symbol: string
  cover: string
  draft: bool
  undo: string
  reads: string
  sync: string

// The web build the host serves now. A page from an older build relaunches to load it.
shape Build
  id: string

// The agent's computer. `kind` is "container" (this machine: a container on the host's machine, which
// `containerAvailable` says can run, or `containerProblem` why not), "cloud" (Imp cloud, an E2B sandbox of `size`),
// "own" (`device` on the tailnet), "dev" (fixed by a development host) or "none"; `status` is "none", "starting", "ready" or "failed" (with `error`).
shape ComputerSize
  id: string
  label: string

// A Linux computer on the tailnet, with why it cannot be the agent's yet ("" when it can).
shape ComputerDevice
  id: string
  name: string
  problem: string

shape Computer
  kind: string
  status: string
  error: string
  name: string
  size: string
  device: string
  containerAvailable: bool
  containerProblem: string
  cloudAvailable: bool
  sizes: ComputerSize[]
  devices: ComputerDevice[]
  tailnetError: string
  setupPrompt: string

// What the imp remembers, one entry per person or thing, as Settings lists it. `kind` is "" for the imp and its person.
shape MemoryEntry
  id: string
  title: string
  kind: string
  facts: string[]
  links: string[]

// The memory system (`name`), where it keeps what it knows, and everything it knows.
shape Memory
  name: string
  location: string
  entries: MemoryEntry[]

// A service the owner can add a key for: the hosts its key goes to, and the variables the imp reads it from ("$NAME, …").
shape SecretService
  id: string
  label: string
  hosts: string
  env: string

// A secret, without its value, which the host never sends back. `kind` is "key" (an API key; `standIn` is what the
// imp's computer holds instead) or "login" (a website's, for `site` as `username`). `detail` says what it is for.
shape Secret
  name: string
  kind: string
  service: string
  label: string
  hosts: string
  env: string
  standIn: string
  site: string
  username: string
  detail: string
  updated: string
  lastUsed: string

// A secret the imp asked for (request_secret), which the owner adds or dismisses.
shape SecretRequest
  id: string
  name: string
  service: string
  why: string
  host: string

// One use of a secret: which request it went on, or the sign-in it typed, and how it went ("200", "typed", "failed").
shape SecretUse
  id: string
  secret: string
  what: string
  result: string
  failed: bool
  when: string

// The owner's secrets. `status` is "starting" (the vault is being set up), "ready" or "failed" (with `error`).
shape Secrets
  status: string
  error: string
  secrets: Secret[]
  requests: SecretRequest[]
  uses: SecretUse[]
  services: SecretService[]

// Where the apps' code is kept: every version in a history on the host (`git` is false when the host has no git to
// keep it), and on GitHub once connected. `status` is GitHub's: "off", "starting", "waiting" (for the person to enter
// `code` at `url`) or "on" (pushing to `repo`, which has the newest version when `synced`).
shape Backup
  git: bool
  status: string
  code: string
  url: string
  repo: string
  error: string
  versions: number
  synced: bool

// A browser task the imp recorded once and runs again without the page (agent-browser's saved flow): what it does,
// on which site, and what it asks for each time.
shape Trick
  name: string
  title: string
  site: string
  params: string[]

// An app in the directory, kept in a GitHub repository (`repo`, its link). `symbol` is its icon.
shape DirectoryApp
  id: string
  name: string
  description: string
  repo: string
  symbol: string

// What the imp does on a schedule, in a conversation of its own (`id` is that conversation's). `when` is the schedule
// in words; `next` and `last` are times on the routine's own clock ("" for none). `unread` says a run ended since the
// person last opened it, `running` that one runs now, and `asked` that the person asked for one, which waits until the
// imp is free.
shape Routine
  id: string
  name: string
  when: string
  instruction: string
  next: string
  last: string
  failed: bool
  paused: bool
  unread: bool
  running: bool
  asked: bool

// Something the person is told while they are away (host/src/notices/notices.ts), the newest first. `kind` is
// "routine" (a run ended with something to say), "key" (the imp asks for a key or login) or "reply" (the imp finished
// replying); `conversation` is the one it opens ("" for a key, which Settings takes). `at` grows with every notice.
shape Notice
  id: string
  kind: string
  title: string
  body: string
  conversation: string
  at: number

shape Reply
  ok: bool
  error: string

shape Media
  prefersReducedMotion: bool
  width: number
  pointer: string
  displayMode: string

shape Page
  hasFocus: bool

shape Time
  epochAtZero: number
  utcOffset: number

// The catalogue's small capitals: mono, upper case, spaced.
style Label
  font-family = "family.mono"
  font-size = "0.6875rem"
  font-weight = 500
  letter-spacing = "0.12em"
  text-transform = "uppercase"
  color = "ink.muted"

// A shortcut's keys, as a keycap: the labels' mono in a hairline box.
style Key
  font-family = "family.mono"
  font-size = "0.6875rem"
  font-weight = 500
  line-height = 1.4
  white-space = "nowrap"
  color = "ink.muted"
  padding = "0 5px"
  border = "1px solid line.strong"
  background-color = "surface.page"

style Rule
  height = 1
  background-color = "line.subtle"

keyframes rise
  from opacity=0 translate="0px 6px"
keyframes pulse
  0% opacity=0.25
  50% opacity=1
  100% opacity=0.25

// <apps:version>
fn builtVersion(): string = "repo"
// </apps:version>
fn tabTitle(name: string, wide: bool, apps: AppTile[]): string = name == "chat" ? (wide ? "Chat" : "Imp") : tabLabel(name, apps)
// The chord that opens a tab: ⌘1 for the chat, then the apps in order up to ⌘9, and ⌘, for Settings, as on a Mac.
fn tabChord(name: string, i: number): string = name == "settings" ? "Meta+," : i < 9 ? `Meta+${i + 1}` : ""
// A chord as the Mac writes it: "Control+Meta+S" is ⌃⌘S.
fn keysOf(chord: string): string =
  chord.replaceAll("Control+", "⌃").replaceAll("Alt+", "⌥").replaceAll("Shift+", "⇧").replaceAll("Meta+", "⌘")
fn capitalized(s: string): string = s == "" ? "" : `${s.slice(0, 1).toUpperCase()}${s.slice(1)}`
fn initial(email: string): string = email == "" ? "?" : email.slice(0, 1).toUpperCase()
fn localPart(email: string): string = email.includes("@") ? email.slice(0, email.indexOf("@")) : email
fn givenName(email: string): string =
  capitalized(localPart(email).includes(".") ? localPart(email).slice(0, localPart(email).indexOf(".")) : localPart(email))
fn hourOf(ms: number, offset: number): number = floor(((ms + offset * 60000) % 86400000) / 3600000)
fn greeting(hour: number): string = hour < 5 ? "Good evening" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"
fn tabLabel(name: string, apps: AppTile[]): string =
  name == "chat" ? "Chat" : name == "settings" ? "Settings" : name == "computer" ? "Computer" : match first(apps.filter(a => a.id == name)) { case some(a) => a.name, case none => capitalized(name) }
fn tabSymbol(name: string, apps: AppTile[]): string =
  name == "chat" ? "symbol:messages" : name == "settings" ? "symbol:settings" : name == "computer" ? "symbol:icon.computer" : match first(apps.filter(a => a.id == name)) { case some(a) => a.symbol, case none => "symbol:layers" }
fn tabCover(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.cover, case none => "" }
fn hasDraft(name: string, apps: AppTile[]): bool =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.draft, case none => false }
fn undoKind(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.undo, case none => "" }
fn readsOf(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.reads, case none => "" }
fn syncOf(name: string, apps: AppTile[]): string =
  match first(apps.filter(a => a.id == name)) { case some(a) => a.sync, case none => "" }
fn numbered(n: number): string = n < 10 ? `0${n}` : `${n}`
// A memory entry's title inside a sentence: the person's own entry is "You", which reads "you" there.
fn aboutTitle(title: string): string = title == "You" ? "you" : title
// A secret as the person knows it: a known service's own name ("GitHub" for the key named github), else its name.
fn shownName(x: Secret): string = x.name == x.service ? x.label : x.name
fn secretLabel(name: string, secrets: Secret[]): string =
  match first(secrets.filter(x => x.name == name)) { case some(x) => shownName(x), case none => name }
fn paneTitle(pane: string): string = pane == "tricks" ? "Tricks" : "App directory"
// A link to a GitHub repository, such as github.com/owner/app, as its path ("owner/app"), or "" for any other text.
fn repoPath(link: string): string =
  link.includes(" ") ? "" : link.startsWith("https://github.com/") ? link.slice(19) : link.startsWith("github.com/") ? link.slice(11) : ""
fn repoLink(link: string): string = repoPath(link).split("/").filter(p => p != "").length >= 2 ? `https://github.com/${repoPath(link)}` : ""
// What the person asks for when they install an app from GitHub, in their own words. How the imp does it (clone,
// copy the app's folder into its workspace, preview) is the studio's to tell it (host/src/studio/tools.ts).
fn installAsk(repo: string): string = `Install the app from github.com/${repoPath(repo)} so I can try it.`
// The directory's apps. Mock entries for now, except Todos, which this repository ships: the rest name repositories
// that do not exist yet, so the imp cannot install them.
fn directory(): DirectoryApp[] = [
  DirectoryApp(id="todos", name="Todos", description="A list of things to do. Your imp can read and change it.",
    repo="https://github.com/peelar/imp/tree/main/client/apps/todos", symbol="symbol:checkmark"),
  DirectoryApp(id="habits", name="Habits", description="A streak for each habit, ticked off once a day.",
    repo="https://github.com/imp-apps/habits", symbol="symbol:star"),
  DirectoryApp(id="reading", name="Reading list", description="Books and articles to read, with a note on each one you finish.",
    repo="https://github.com/imp-apps/reading", symbol="symbol:book"),
  DirectoryApp(id="runs", name="Runs", description="Distance and pace for every run, and how the month adds up.",
    repo="https://github.com/marta/imp-runs", symbol="symbol:chart"),
  DirectoryApp(id="places", name="Places", description="Places to go, each pinned with who told you about it.",
    repo="https://github.com/imp-apps/places", symbol="symbol:pin"),
  DirectoryApp(id="people", name="People", description="Who you met, where, and what to ask them next time.",
    repo="https://github.com/kuba/imp-people", symbol="symbol:people"),
  DirectoryApp(id="journal", name="Journal", description="A line a day. Your imp can write it for you from your chats.",
    repo="https://github.com/imp-apps/journal", symbol="symbol:pencil")]
// The notice at a place in the list, or none (an empty one, from before every notice) past its end.
fn noticeAt(notices: Notice[], i: number): Notice =
  match notices.at(i) { case some(n) => n, case none => Notice(id="", kind="", title="", body="", conversation="", at=0) }
// A notice's notification: one per conversation, so a newer one replaces the last, and one for the keys asked for.
fn noticeTag(n: Notice): string = n.kind == "key" ? "key" : `conversation-${n.conversation}`
fn routineStatus(r: Routine): string =
  r.running ? "Running now" : r.asked ? "Starting soon" : r.paused ? "Paused" : r.next == "" ? "Not scheduled" : `Next ${r.next}`
fn routineLast(r: Routine): string = r.last == "" ? "Not run yet" : r.failed ? `Last run failed ${r.last}` : `Last ran ${r.last}`
fn computerStatus(status: string): string =
  status == "ready" ? "Ready" : status == "starting" ? "Starting…" : status == "failed" ? "Not reachable" : "Not chosen yet"
// Dictated words added to the end of a draft, a space between them.
fn withSpoken(draft: string, spoken: string): string =
  spoken.trim() == "" ? draft : draft == "" or draft.endsWith(" ") or draft.endsWith("\n") ? `${draft}${spoken.trim()}` : `${draft} ${spoken.trim()}`
// The final results a recognition heard from the `from`th on, best guesses only.
fn heardSince(heard: SpeechRecognitionState, from: number): string =
  (heard.results.filter(r => r.index >= from).map(r => r.alternatives.slice(0, 1).map(a => a.transcript.trim()).join(""))
    .filter(t => t != "").join(" "))
// Why dictation stopped or did not start, from a start's failure or a recognition's error ("" for none worth saying:
// the person stopped it, or it heard nothing).
fn dictationTrouble(code: string): string =
  (code == "" or code == "aborted" or code == "no-speech" ? ""
    : code == "NotAllowedError" or code == "not-allowed" ? "Dictation needs the microphone. Allow it for this page and try again."
    : code == "audio-capture" or code == "NotReadableError" ? "No microphone could be opened for dictation."
    : code == "network" or code == "service-not-allowed" ? "The browser's speech service did not answer. Try again."
    : `Dictation stopped (${code}).`)

component App
  state draft = ""
  // What the last send carried, until the host takes it: a send that never reaches the host puts it back in the box.
  state unsent = ""
  state scheme = "system" persist
  state now = 0
  // On a wide window the chat moves to a panel on the right while an app is open; this hides or shows that panel.
  state chatDocked = true persist
  // What the chat tab shows: "chat" (the open conversation), "tricks" (what the imp learned in the browser) or
  // "directory" (apps to install).
  state pane = "chat"
  // The sidebar's conversations past the latest three are folded until this opens them.
  state olderOpen = false
  // On a narrow window the sidebar is a drawer over the chat.
  state drawer = false
  // The host's address in the Mac app ("" on the web, where the page's origin is the host). The Mac installer fills it
  // in; the onboarding asks for it when no host answers.
  state hostAddress = "" persist
  state hostDraft = ""
  // The onboarding's open section for the computer: "cloud", "own", "container" or none.
  state computerChoice = ""
  // Whether the onboarding's API key fold is open.
  state keyForm = false
  state keyBase = "https://api.openai.com/v1"
  state keyValue = ""
  state keyModel = ""
  // Counts saved secrets: the Secrets section starts again, with an empty form, after each.
  state secretRound = 0
  // Dictation into the composer: whether it is on, the browser's recognition once it has started, how many of its
  // final results are already in the draft, and why the last one stopped (a recognition's error).
  state dictating = false
  state recognitionId = ""
  state dictated = 0
  state dictationEnd = ""
  // ⌘ held on its own, before any other key (a chord): held for a moment, it shows each control's shortcut.
  state metaAlone = false
  state keysShown = false
  // The newest notice this page has taken in, by its `at`; -1 before the first. A page tells only what comes after:
  // opening Imp does not tell again what happened before.
  state noticedAt = -1
  resource page = exactPage() as shape Page
  resource speech = speechRecognitionStatus() as shape SpeechRecognitionStatus else empty()
  resource heard = speechRecognitionState(recognition=recognitionId) when recognitionId != "" as shape SpeechRecognitionState else empty()
  resource media = exactViewport() as shape Media
  resource time = exactTime() as shape Time
  resource alerts = notificationStatus() as shape NotificationStatus
  resource host = hostOrigin(hostAddress) as shape Host else empty()
  resource account = account() when host.origin != "" as shape Account else empty()
  resource chat = chat() when signedIn as shape ChatState else empty()
  resource apps = apps() when signedIn as shape AppTile[] else empty()
  resource build = build() when signedIn as shape Build else empty()
  mutation signInStarted as shape Reply
  mutation signInCancelled as shape Reply
  mutation keyUsed as shape Reply then afterKeyUsed
  mutation signedOut as shape Reply
  mutation sent as shape Reply then toEnd
  mutation stopped as shape Reply
  mutation chatChanged as shape Reply
  mutation routineOpened as shape Reply
  mutation routineRan as shape Reply
  mutation routinePaused as shape Reply
  mutation routineDeleted as shape Reply
  mutation appSaved as shape Reply
  mutation appDiscarded as shape Reply
  mutation appUndone as shape Reply
  mutation appSynced as shape Reply
  mutation computerSwitched as shape Reply
  mutation computerRefreshed as shape Reply
  mutation computerRetried as shape Reply
  mutation computerKeySaved as shape Reply
  mutation forgotten as shape Reply queue
  mutation secretSaved as shape Reply then afterSecretSaved
  mutation loginSaved as shape Reply then afterLoginSaved
  mutation secretDeleted as shape Reply queue
  mutation secretDismissed as shape Reply queue
  mutation backupStarted as shape Reply
  mutation backupCancelled as shape Reply
  mutation backupDisconnected as shape Reply
  mutation alertsAsked as shape NotificationStatus
  mutation listening as shape SpeechRecognitionInfo then listened
  mutation unheard as shape SpeechRecognitionInfo
  derive still = media.prefersReducedMotion
  // Wide enough for the top bar of apps and the chat beside an app; narrower windows keep the tab bar.
  derive wide = media.width >= 960
  derive onApp = nav.tab != "chat" and nav.tab != "settings"
  derive docked = wide and onApp and chatDocked
  // The ⌘ chords are the app's in the Mac app (and an installed desktop app), where no browser takes them first: only
  // there does the screen hint at them.
  derive keyboard = media.pointer == "fine" and media.displayMode != "browser"
  derive keys = keyboard and keysShown and page.hasFocus
  // Beside the chat on a wide window: the conversations and the tricks.
  derive sidebar = wide and nav.tab == "chat"
  // The apps the top bar lists: the installed ones this build has a screen (a tab) for.
  derive shownApps = apps.filter(a => nav.tabs.map(t => t.name).includes(a.id))
  derive openAppName = nav.tab == "computer" ? "the computer" : match first(apps.filter(a => a.id == nav.tab)) { case some(a) => a.name, case none => "this app" }
  derive signedIn = account.status == "signedIn"
  derive signingIn = account.status == "starting" or account.status == "waiting"
  derive onKey = account.kind == "apiKey"
  // Onboarding's second step: a computer, until the imp has one or the person tries the chat without.
  derive needsComputer = signedIn and computer.status == "none"
  // An onboarding section waiting on something done outside Imp (a computer set up with the setup prompt, a container
  // engine started) has the host look again every few seconds, so it shows up without a click.
  derive computerAwaited = (needsComputer and not pending(computerSwitched) and not pending(computerKeySaved)
    and ((computerChoice == "own" and computer.devices.filter(d => d.problem == "").length == 0)
    or (computerChoice == "container" and not computer.containerAvailable)))
  derive apiKeyError = match keyUsed { case some(r) => r.error, case none => "" }
  derive shown = time.epochAtZero + now
  derive salutation = account.email == "" ? `${greeting(hourOf(shown, time.utcOffset))}.` : `${greeting(hourOf(shown, time.utcOffset))}, ${givenName(account.email)}.`
  derive lastId = match chat.messages.at(-1) { case some(m) => m.id, case none => "" }
  derive sendLost = failed(sent) and not pending(sent)
  derive sendError = sendLost ? "Your imp couldn't be reached, so that wasn't sent. Send it again in a moment." : match sent { case some(r) => r.error, case none => "" }
  // Dictation takes the microphone through the browser's own recognizer (the Mac app's takes only a track, so it
  // offers none). The words it is still unsure of show above the field until they are final and join the draft.
  derive canDictate = speech.available and speech.state != "denied" and speech.inputs.includes("microphone")
  derive interimHeard = match heard.interim { case some(i) => i.alternatives.slice(0, 1).map(a => a.transcript).join("").trim(), case none => "" }
  derive dictationError = dictationTrouble(match failure(listening) { case some(f) => f.code, case none => dictationEnd })
  derive composerError = sendError != "" ? sendError : dictationError
  // A live stream that ended (the host restarted, the network dropped) is opened again.
  derive hostLost = match failure(host) { case some(f) => true, case none => false }
  derive accountLost = match failure(account) { case some(f) => true, case none => false }
  derive chatLost = match failure(chat) { case some(f) => true, case none => false }
  derive appsLost = match failure(apps) { case some(f) => true, case none => false }
  derive buildLost = match failure(build) { case some(f) => true, case none => false }
  // The host serves a newer build (an app was added, previewed, saved or undone): relaunch into it.
  derive stale = build.id != "" and build.id != builtVersion()
  // No host answers: none is known yet (a Mac app installed without the installer), or the saved one is unreachable.
  derive unreachable = hostLost or (accountLost and hostAddress != "")
  derive computer = account.computer
  derive memory = account.memory
  derive tricks = account.tricks
  derive routines = account.routines
  derive secrets = account.secrets
  derive secretError = match secretSaved { case some(r) => r.error, case none => "" }
  derive loginError = match loginSaved { case some(r) => r.error, case none => "" }
  derive secretDeleteError = match secretDeleted { case some(r) => r.error, case none => "" }
  derive backup = account.backup
  derive switchError = match computerSwitched { case some(r) => r.error, case none => "" }
  derive keyError = match computerKeySaved { case some(r) => r.error, case none => "" }
  // Notifications: what the host noticed since this page last looked, shown while no Imp window is in front, and
  // what waits on the person (routines with a run they have not opened, keys the imp asked for) on the app's badge.
  derive newest = noticeAt(account.notices, 0)
  derive canNotify = alerts.available and alerts.state == "granted"
  derive waiting = routines.filter(r => r.unread).length + secrets.requests.length

  task appearance mount
    after(1, applyScheme)
  task heal mount
    every(3000, reconnect)
  task clock mount
    every(60000, tick)
  task watchComputer when computerAwaited
    every(5000, refreshDevices)
  task foldDictation when recognitionId != "" and heard.id == recognitionId key=heard.finalCount
    change(foldHeard)
  task endDictation when dictating and recognitionId != "" and heard.id == recognitionId and heard.state == "ended"
    after(1, dictationEnded)
  // A refused start (no microphone, permission denied) runs no `then`.
  task dictationRefused when failed(listening) key=true
    change(dictationOff)
  task putBack when sendLost and unsent != ""
    after(1, restoreUnsent)
  task revealKeys when keyboard and metaAlone and not keysShown
    after(400, showKeys)
  // A key let go while another window has the focus sends no keyup.
  task releaseKeys when (metaAlone or keysShown) and not page.hasFocus
    after(1, hideKeys)
  task announce when signedIn key=newest.at
    change(announceNotices)
  task badge when signedIn and alerts.badge key=waiting
    change(showWaiting)

  action applyScheme
    setScheme(scheme)
  // Every key, wherever the focus is. ⌘ pressed on its own starts the wait for the hints; any other key ends it,
  // and the hints already shown stay while ⌘ does.
  action keyDown(k: string, e: KeyboardEvent)
    metaAlone = k == "Meta" and not e.shiftKey and not e.ctrlKey and not e.altKey
    keysShown = keysShown and e.metaKey
    // ⌘L, by the key under it whatever the layout types there: no button holds it, since the message box is the
    // target and it is not a button.
    if e.metaKey and not e.shiftKey and not e.ctrlKey and not e.altKey and e.code == "KeyL"
      preventDefault()
      focusComposer()
  // Into the message box on the screen: the chat's beside an open app, else the chat tab's, which this opens.
  action focusComposer
    if docked
      focus("side-composer")
    else
      pane = "chat"
      drawer = false
      nav = select(nav, "chat")
      focus("composer")
  action keyUp(k: string, e: KeyboardEvent)
    if not e.metaKey
      hideKeys()
  action showKeys
    keysShown = metaAlone
  action hideKeys
    metaAlone = false
    keysShown = false
  action tick
    now = performanceNow()
  action restoreUnsent
    if draft.trim() == ""
      draft = unsent
    unsent = ""
  action reconnect
    if hostLost
      refresh host
    if accountLost
      refresh account
    if chatLost
      refresh chat
    if appsLost
      refresh apps
    if buildLost
      refresh build
    if stale
      relaunch()
    // <apps:refresh>
    if githubReadInboxLost
      refresh githubReadInbox
    if todosReadListLost
      refresh todosReadList
    // </apps:refresh>
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  // Step 1's two ways in are folds, and one is open at a time: opening ChatGPT's starts its sign-in, folding it
  // cancels that, and opening the key's cancels a sign-in under way.
  action foldChatGPT
    if signingIn
      send signInCancelled = accountCancel()
    else
      keyForm = false
      send signInStarted = accountSignIn()
  action toggleKeyForm
    if not keyForm and signingIn
      send signInCancelled = accountCancel()
    keyForm = not keyForm
  action editKeyBase(v: string)
    keyBase = v
  action editKeyValue(v: string)
    keyValue = v
  action editKeyModel(v: string)
    keyModel = v
  action useKey
    if not pending(keyUsed)
      send keyUsed = accountUseKey(keyBase, keyValue, keyModel)
  // A key the host took is not kept in the page.
  action afterKeyUsed
    if match keyUsed { case some(r) => r.ok, case none => false }
      keyValue = ""
      keyForm = false
  action askSignOut
    showModal("confirm-signout")
  action signOut
    send signedOut = accountSignOut()
  action copyCode
    copyText(account.code)
  action setAppearance(value: string)
    scheme = value
    setScheme(value)
  action edit(v: string)
    draft = v
  // Sending while dictating sends the words heard so far, the unsure ones too, and ends the dictation.
  action post(where: string)
    let message = withSpoken(draft, interimHeard).trim()
    if message != "" and not pending(sent)
      send sent = chatSend(message, where == "side-" ? nav.tab : "")
      unsent = message
      draft = ""
      if dictating
        hush()
    if where == "side-"
      focus("side-composer")
    else
      focus("composer")
  // The microphone button: starts dictation, or stops it, which lets the recognizer finish the words it is on.
  action dictate
    if not dictating
      dictating = true
      recognitionId = ""
      dictationEnd = ""
      send listening = startSpeechRecognition(microphone=true, continuous=true, interimResults=true)
    else if recognitionId == ""
      hush()
    else if heard.state != "stopping"
      send unheard = stopSpeechRecognition(recognition=recognitionId)
  // Ends dictation at once, dropping the words not yet final. A start still in flight is superseded, so its
  // recognition is aborted when it answers.
  action hush
    if recognitionId == ""
      send listening = abortSpeechRecognition(recognition="")
    else
      send unheard = abortSpeechRecognition(recognition=recognitionId)
    dictating = false
    recognitionId = ""
  action listened
    match listening
      case some(r)
        recognitionId = r.id
        dictated = 0
        if r.id == ""
          dictating = false
      case none
        dictating = false
  action dictationOff
    dictating = false
  action foldHeard
    draft = withSpoken(draft, heardSince(heard, dictated))
    dictated = heard.finalCount
  // The recognition ended: the person stopped it, it heard silence for a while, or it failed. Its last words join
  // the draft.
  action dictationEnded
    foldHeard()
    dictationEnd = match heard.error { case some(e) => e, case none => "" }
    dictating = false
    recognitionId = ""
  action suggest(text: string)
    if not pending(sent)
      send sent = chatSend(text, "")
      unsent = text
  action startApp
    draft = "Build me an app that "
    focus("composer")
  action stop
    send stopped = chatStop()
  action newChat
    pane = "chat"
    drawer = false
    nav = select(nav, "chat")
    // A new chat starts empty: what was typed for the last one stays behind with it.
    draft = ""
    send chatChanged = chatNew()
    focus("composer")
  action showChat(id: string)
    pane = "chat"
    drawer = false
    nav = select(nav, "chat")
    if id != chat.current
      send chatChanged = chatShow(id)
    seen(id)
  // A routine's conversation, which shows what each run found and takes the person's reply.
  action showRoutine(id: string)
    pane = "chat"
    drawer = false
    nav = select(nav, "chat")
    send routineOpened = routinesOpen(id)
    seen(id)
  // A conversation the person opened: its notification has nothing more to tell.
  action seen(id: string)
    if canNotify
      closeNotification(tag=`conversation-${id}`)
  // New notices, while no Imp window is in front: the person is elsewhere. One answer can bring two, such as a key
  // the imp asked for and the reply that followed it; up to three are shown, the oldest first.
  action announceNotices
    if noticedAt >= 0 and canNotify and not page.hasFocus
      notify(noticeAt(account.notices, 2))
      notify(noticeAt(account.notices, 1))
      notify(noticeAt(account.notices, 0))
    noticedAt = newest.at
  action notify(n: Notice)
    if n.at > noticedAt
      showNotification(title=n.title, body=n.body, tag=noticeTag(n), data=`${n.kind}:${n.conversation}`)
  // A notification clicked: its conversation opens, or Settings for a key the imp asked for.
  action openNotice(tag: string, e: NotificationEvent)
    let about = match e.data { case some(d) => d, case none => "" }
    if about.startsWith("routine:")
      showRoutine(about.slice(8))
    else if about.startsWith("reply:")
      showChat(about.slice(6))
    else if about.startsWith("key:")
      pick("settings")
  action showWaiting
    if waiting > 0
      setAppBadge(contents=waiting)
    else
      clearAppBadge()
  action allowNotifications
    send alertsAsked = requestNotificationPermission()
  action runRoutine(id: string)
    send routineRan = routinesRun(id)
  action pauseRoutine(id: string, paused: bool)
    send routinePaused = routinesPause(id, paused)
  action askDeleteRoutine
    showModal("confirm-routine-delete")
  action deleteRoutine
    send routineDeleted = routinesDelete(chat.current)
  action openTricks
    pane = "tricks"
    drawer = false
    nav = select(nav, "chat")
  // A trick asked for in the open conversation: its name starts the message, and the person adds what it asks for.
  action useTrick(title: string)
    pane = "chat"
    draft = `${title}: `
    focus("composer")
  action openDirectory
    pane = "directory"
    drawer = false
    nav = select(nav, "chat")
  // An app from the directory, or a link to one: the imp brings it in as a preview, in the open conversation.
  action installApp(repo: string)
    if not pending(sent)
      pane = "chat"
      send sent = chatSend(installAsk(repo), "")
      unsent = ""
  action toggleOlder
    olderOpen = not olderOpen
  action toggleDrawer
    drawer = not drawer
  action toEnd
    unsent = ""
    if docked
      scrollIntoView("side-transcript", lastId, block="end")
    else
      scrollIntoView("transcript", lastId, block="end")
  action toggleDock
    chatDocked = not chatDocked
  action editHost(v: string)
    hostDraft = v
  action connect
    if hostDraft.trim() != ""
      hostAddress = hostDraft.trim().includes("://") ? hostDraft.trim() : `https://${hostDraft.trim()}`
      refresh account
  action saveApp(id: string)
    send appSaved = appsSave(id)
  action discardApp(id: string)
    send appDiscarded = appsDiscard(id)
  action undoApp(id: string)
    send appUndone = appsUndo(id)
  action syncApp(id: string)
    send appSynced = appsSync(id)
  // <apps:members>
  resource githubReadInbox = githubInbox() when signedIn and nav.tab == "github" as shape GithubInbox else empty()
  derive githubReadInboxLost = match failure(githubReadInbox) { case some(f) => true, case none => false }
  mutation githubWroteDone as shape Reply queue
  action githubDoDone(arg1: string)
    send githubWroteDone = githubDone(arg1)
  mutation githubWroteSnooze as shape Reply queue
  action githubDoSnooze(arg1: string, arg2: number)
    send githubWroteSnooze = githubSnooze(arg1, arg2)
  mutation githubWroteRestore as shape Reply queue
  action githubDoRestore(arg1: string)
    send githubWroteRestore = githubRestore(arg1)
  resource todosReadList = todosList() when signedIn and nav.tab == "todos" as shape TodosTodo[] else empty()
  derive todosReadListLost = match failure(todosReadList) { case some(f) => true, case none => false }
  mutation todosWroteAdd as shape Reply queue
  action todosDoAdd(arg1: string)
    send todosWroteAdd = todosAdd(arg1)
  mutation todosWroteSetDone as shape Reply queue
  action todosDoSetDone(arg1: string, arg2: bool)
    send todosWroteSetDone = todosSetDone(arg1, arg2)
  mutation todosWroteRename as shape Reply queue
  action todosDoRename(arg1: string, arg2: string)
    send todosWroteRename = todosRename(arg1, arg2)
  mutation todosWroteRemove as shape Reply queue
  action todosDoRemove(arg1: string)
    send todosWroteRemove = todosRemove(arg1)
  // </apps:members>
  action useContainer
    send computerSwitched = computerUseContainer()
  action useCloud(size: string)
    send computerSwitched = computerUseCloud(size)
  action useOwn(device: string)
    if not (computer.kind == "own" and computer.device == device)
      send computerSwitched = computerUseOwn(device)
  action toggleComputerChoice(next: string)
    computerChoice = computerChoice == next ? "" : next
  action refreshDevices
    send computerRefreshed = computerRefresh()
  action setCloudKey(key: string)
    send computerKeySaved = computerSetCloudKey(key)
  action retryComputer
    send computerRetried = computerRetry()
  // The computer's screen in a window of its own, which the host serves: on the web a new tab, in the apps the default
  // browser. It takes the app's appearance along. The Computer tab shows the same page.
  action openScreen
    openURL(`${host.origin}/computer/screen?scheme=${scheme}`)
  action copySetupPrompt
    copyText(computer.setupPrompt)
  action forget(entry: string, fact: string)
    send forgotten = memoryForget(entry, fact)
  action saveSecret(name: string, service: string, value: string, hosts: string, header: string, prefix: string, envName: string)
    if not pending(secretSaved)
      send secretSaved = secretsPut(name, service, value, hosts, header, prefix, envName)
  // A saved secret closes its form: the next one starts empty.
  action afterSecretSaved
    if match secretSaved { case some(r) => r.ok, case none => false }
      secretRound = secretRound + 1
  action saveLogin(name: string, site: string, username: string, password: string, otp: string)
    if not pending(loginSaved)
      send loginSaved = secretsPutLogin(name, site, username, password, otp)
  action afterLoginSaved
    if match loginSaved { case some(r) => r.ok, case none => false }
      secretRound = secretRound + 1
  action deleteSecret(name: string)
    send secretDeleted = secretsDelete(name)
  action dismissSecret(id: string)
    send secretDismissed = secretsDismiss(id)
  action connectBackup
    send backupStarted = backupConnect()
  action cancelBackup
    send backupCancelled = backupCancel()
  action disconnectBackup
    send backupDisconnected = backupDisconnect()
  action copyBackupCode
    copyText(backup.code)

  view
    main navigationKey=`${top(nav).id}` navigate=follow key=keyDown keyup=keyUp notificationclick=openNotice testId="app" width="100%" height="100%"
      display="flex" flex-direction="column" position="relative" viewport-fit="cover" interactive-widget="resizes-content"
      background-color="surface.page"
      color="ink.strong" font-family="family.text"
      if signedIn and not needsComputer
        // The routes. On a wide window they sit under the top bar, and beside the chat panel while an app is open.
        column position="absolute" left=(sidebar ? "16rem" : "0px") bottom=0 top=(wide ? "3.25rem" : "0px") right=(docked ? "26rem" : "0px")
          for t in nav.tabs key=t.name
            column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
              for e in t.stack key=e.id
                column navigationKey=`${e.id}` navigationScroll=(e.name == "chat" ? "transcript" : e.name == "settings" ? "settings-list" : `${e.name}-screen`)
                  position="absolute" inset=0 display="flex" flex-direction="column" box-sizing="border-box"
                  padding-bottom=(wide ? "4.75rem" : "calc(3.5rem + env(safe-area-inset-bottom))")
                  // Under the top bar the page's header is its title, with no rule of its own.
                  header display="flex" justify-content="center" padding="0 20px"
                    border-bottom=(wide ? "none" : "1px solid line.subtle") background-color="surface.page"
                    row width="100%" max-width="46rem" align-items="center" gap=12 padding=(wide ? "22px 0 0" : "12px 0 11px")
                      if e.name == "chat" and not wide
                        button press=toggleDrawer aria-label="Conversations, routines and tricks" aria-expanded=drawer
                          aria-keyshortcuts="Control+Meta+S" testId="drawer-toggle" appearance="none" width=32 height=32
                          padding=0 display="flex" align-items="center" justify-content="center"
                          border="1px solid line.strong" background-color="transparent" color="ink.strong" position="relative"
                          image "symbol:menu" width=16 height=16
                          if keys
                            KeyBadge(chord="Control+Meta+S", at="end")
                        image "symbol:icon.imp" width=26 height=26 aria-hidden=true
                      Initialled(word=(e.name == "chat" and pane != "chat" ? paneTitle(pane) : e.name == "chat" and chat.routine != "" ? chat.routine : tabTitle(e.name, wide, apps)), size="1.5rem", heading=1)
                      row flex=1
                      if e.name == "chat" and chat.busy
                        row gap=8 align-items="center" testId="busy"
                          row width=6 height=6 background-color="AccentColor" aria-hidden=true
                            animation=(still ? "none" : "pulse 1.2s ease-in-out infinite")
                          text "Imp at work" class=Label color="ink.strong"
                      else if not wide
                        text formatDate(shown, time.utcOffset, "medium") class=Label
                      if wide and e.name != "chat" and e.name != "settings"
                        // Named for what it does, as the View menu's item for it is.
                        button press=toggleDock aria-label=(chatDocked ? "Hide chat" : "Show chat")
                          aria-keyshortcuts="Control+Meta+C" testId="dock-toggle" appearance="none" display="flex"
                          align-items="center" gap=7 padding="7px 10px" border="1px solid line.strong" position="relative"
                          background-color=(chatDocked ? "ink.strong" : "transparent")
                          color=(chatDocked ? "surface.page" : "ink.strong")
                          image "symbol:icon.panel" width=14 height=14 aria-hidden=true
                          text "Chat" class=Label color="inherit"
                          if keys
                            KeyBadge(chord="Control+Meta+C", at="end")
                      // New chat from any page; beside the chat on a wide window the sidebar has it.
                      if not sidebar
                        button press=newChat aria-label="New chat" aria-keyshortcuts="Meta+N" testId=`new-chat-${e.name}`
                          appearance="none" width=32 height=32 padding=0 display="flex" align-items="center"
                          justify-content="center" border="1px solid line.strong" background-color="transparent"
                          color="ink.strong" position="relative"
                          :hover
                            background-color="surface.soft"
                          image "symbol:compose" width=15 height=15
                          if keys
                            KeyBadge(chord="Meta+N", at="end")
                  if e.name == "chat" and pane == "tricks"
                    TrickList(tricks=tricks, use=useTrick)
                  else if e.name == "chat" and pane == "directory"
                    AppDirectory(entries=directory(), installed=apps, sending=pending(sent),
                      install=installApp, open=pick)
                  else if e.name == "chat"
                    for r in routines.filter(r => r.id == chat.current) key=r.id
                      RoutineBar(routine=r, busy=(pending(routineRan) or pending(routinePaused) or pending(routineDeleted)),
                        run=runRoutine, pause=pauseRoutine, remove=askDeleteRoutine, keys=keys)
                    dialog id="confirm-routine-delete" role="alertdialog" aria-label="Delete this routine?"
                      text "It stops running, and its conversation goes with it."
                      button commandfor="confirm-routine-delete" command="close" testId="routine-delete-cancel"
                        text "Cancel"
                      button press=deleteRoutine commandfor="confirm-routine-delete" command="close" destructive=true
                        testId="routine-delete-confirm"
                        text "Delete"
                    if chat.messages.length == 0 and not chat.busy and chat.routine == ""
                      // Home with nothing said yet: a greeting, the apps, what to try, and the workshop.
                      scroll id="home-scroll" flex=1 min-height=0
                        column max-width="48.5rem" margin="0 auto" padding="28px 20px 28px" gap=28 box-sizing="border-box"
                          width="100%" testId="home"
                          column gap=12
                            Initialled(word=salutation, size="2.5rem", heading=2)
                            text "Ask for anything. Your imp uses your apps, works on a computer of its own, and builds new apps for you."
                              color="ink.muted" font-size="1.0625rem" line-height=1.5 max-width="34rem"
                          column
                            row align-items="baseline" justify-content="space-between" padding-bottom=10
                              border-bottom="1px solid ink.strong"
                              text "Your apps" class=Label color="ink.strong" role="heading" aria-level=3
                              text `No. ${numbered(apps.length + (computer.status == "none" ? 0 : 1))}` class=Label
                            for a in apps key=a.id
                              button press=pick(a.id) display="flex" align-items="center" gap=14 padding="14px 0"
                                background-color="transparent" border="none" border-bottom="1px solid line.subtle"
                                text-align="start" color="ink.strong" testId=`app-${a.id}`
                                transition="background-color 120ms ease"
                                :hover
                                  background-color="surface.soft"
                                if a.cover != ""
                                  image a.cover alt="" width=44 height=44 min-width=44 object-fit="cover"
                                    border="1px solid line.subtle" box-sizing="border-box"
                                else
                                  row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                                    border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                                    image a.symbol width=18 height=18
                                column gap=2 flex=1 min-width=0
                                  text a.name font-family="family.display" font-size="1.375rem" line-height=1.1
                                  text a.description font-size="0.9375rem" color="ink.muted" line-clamp=1
                                text "→" font-family="family.mono" color="ink.muted" aria-hidden=true padding-right=4
                            // The imp's computer, as an app: its screen, to watch the imp work or take over.
                            if computer.status != "none"
                              button press=pick("computer") display="flex" align-items="center" gap=14 padding="14px 0"
                                background-color="transparent" border="none" border-bottom="1px solid line.subtle"
                                text-align="start" color="ink.strong" testId="app-computer"
                                transition="background-color 120ms ease"
                                :hover
                                  background-color="surface.soft"
                                row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                                  border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                                  image (computer.kind == "cloud" ? "symbol:icon.cloud" : "symbol:icon.computer") width=18 height=18
                                column gap=2 flex=1 min-width=0
                                  text "Computer" font-family="family.display" font-size="1.375rem" line-height=1.1
                                  text `${computer.name}. Watch your imp work, or take over.` font-size="0.9375rem"
                                    color="ink.muted" line-clamp=1
                                text "→" font-family="family.mono" color="ink.muted" aria-hidden=true padding-right=4
                            button press=startApp display="flex" align-items="center" gap=14 padding="14px 0"
                              background-color="transparent" border="none" border-bottom="1px solid line.subtle"
                              text-align="start" color="ink.strong" testId="app-new"
                              transition="background-color 120ms ease"
                              :hover
                                background-color="surface.soft"
                              row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                                border="1px dashed line.strong" box-sizing="border-box" aria-hidden=true color="ink.muted"
                                image "symbol:add" width=18 height=18
                              column gap=2 flex=1 min-width=0
                                text "Build a new app" font-family="family.display" font-size="1.375rem" line-height=1.1
                                text "Describe it in a sentence. It stays here." font-size="0.9375rem" color="ink.muted"
                              text "+" font-family="family.mono" color="ink.muted" aria-hidden=true padding-right=4
                          column gap=10
                            text "Try" class=Label
                            row flex-wrap="wrap" gap=8
                              for s in ["Add todo: Buy flowers", "What's on my todo list?", "Build me an app that tracks my runs"] key=s
                                button press=suggest(s) disabled=pending(sent) padding="8px 12px"
                                  background-color="transparent" border="1px solid line.strong" color="ink.strong"
                                  font-size="0.9375rem" transition="border-color 120ms ease, background-color 120ms ease"
                                  testId=`suggest-${s.length}`
                                  :hover
                                    border-color="ink.strong"
                                    background-color="surface.soft"
                                  text s
                          // The workshop closes the page, under what the person came for.
                          column gap=8
                            image "assets/art/workshop.jpg" alt="An engraving of a workshop: a person at a desk among machines"
                              width="100%" height="auto" aspect-ratio="2 / 1" max-height="17rem" object-fit="cover" border="1px solid line.subtle"
                              box-sizing="border-box"
                            text "Fig. 1 — The workshop, where your apps are made." font-style="italic" font-size="0.875rem"
                              color="ink.muted"
                    else
                      Transcript(prefix="", compact=false, messages=chat.messages, lastId=lastId, still=still)
                    Composer(prefix="", placeholder=(chat.routine == "" ? "Ask your imp" : `Reply to ${chat.routine}`), compact=false, draft=draft, busy=chat.busy,
                      sending=pending(sent), stopping=pending(stopped), error=composerError, edit=edit, post=post, stop=stop,
                      canDictate=canDictate, dictating=dictating, heard=interimHeard, dictate=dictate, keys=keys)
                  else if e.name == "settings"
                    scroll id="settings-list" flex=1 min-height=0
                      column max-width="48.5rem" margin="0 auto" padding="28px 20px 32px" gap=32 box-sizing="border-box" width="100%"
                        if onKey
                          column
                            row padding-bottom=10 border-bottom="1px solid ink.strong"
                              text "API key" class=Label color="ink.strong" role="heading" aria-level=2
                            column gap=4 padding="16px 0" border-bottom="1px solid line.subtle"
                              text account.model font-family="family.display" font-size="1.375rem"
                                line-height=1.15 overflow-wrap="anywhere" testId="account-model"
                              text account.baseUrl font-family="family.mono" font-size="0.75rem" color="ink.muted" overflow-wrap="anywhere"
                                testId="account-base"
                            text "Your imp runs on this key. Its provider bills what it uses." font-size="0.9375rem"
                              color="ink.muted" padding-top=10
                        else
                          column
                            row padding-bottom=10 border-bottom="1px solid ink.strong"
                              text "ChatGPT account" class=Label color="ink.strong" role="heading" aria-level=2
                            row gap=14 align-items="center" padding="16px 0" border-bottom="1px solid line.subtle"
                              text initial(account.email) width="2.75rem" height="2.75rem" min-width="2.75rem"
                                text-align="center" line-height="2.75rem" font-family="family.script" font-size="1.75rem"
                                border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                              column flex=1 min-width=0 gap=4 align-items="flex-start"
                                text (account.email == "" ? "ChatGPT account" : account.email) font-family="family.display"
                                  font-size="1.375rem" line-height=1.15 overflow-wrap="anywhere" testId="account-email"
                                if account.plan != ""
                                  text capitalized(account.plan) class=Label testId="account-plan"
                            text "Your imp runs on this plan. Nothing is billed separately." font-size="0.9375rem"
                              color="ink.muted" padding-top=10
                        ComputerSettings(computer=computer, switching=pending(computerSwitched) or pending(computerKeySaved),
                          switchError=(keyError != "" ? keyError : switchError), setCloudKey=setCloudKey,
                          refreshing=pending(computerRefreshed), useContainer=useContainer, useCloud=useCloud, useOwn=useOwn, refresh=refreshDevices,
                          retry=retryComputer, openScreen=pick("computer"), copyPrompt=copySetupPrompt)
                        MemorySettings(memory=memory, forget=forget)
                        for r in [secretRound] key=`${r}`
                          SecretSettings(secrets=secrets, saving=(pending(secretSaved) or pending(loginSaved)), error=secretError,
                            loginError=loginError, deleteError=secretDeleteError, save=saveSecret, saveLogin=saveLogin,
                            remove=deleteSecret, dismiss=dismissSecret)
                        NotificationSettings(alerts=alerts, asking=pending(alertsAsked), allow=allowNotifications)
                        BackupSettings(backup=backup, busy=(pending(backupStarted) or pending(backupDisconnected)),
                          connect=connectBackup, cancel=cancelBackup, disconnect=disconnectBackup, copyCode=copyBackupCode)
                        column
                          row padding-bottom=10 border-bottom="1px solid ink.strong"
                            text "Appearance" class=Label color="ink.strong" role="heading" aria-level=2
                          row role="radiogroup" aria-label="Appearance" padding-top=14 gap=0
                            for s, i in ["system", "light", "dark"] key=s
                              button role="radio" aria-checked=(scheme == s) press=setAppearance(s) flex=1 testId=`scheme-${s}`
                                padding="10px 0" border="1px solid line.strong" margin-left=(i == 0 ? "0px" : "-1px")
                                background-color=(scheme == s ? "ink.strong" : "transparent")
                                color=(scheme == s ? "surface.page" : "ink.strong")
                                font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                                text capitalized(s)
                        column
                          button press=askSignOut disabled=pending(signedOut) testId="signout" display="flex" align-items="center"
                            gap=10 padding="14px 0" color="-exact-system-red" background-color="transparent" border="none"
                            border-top="1px solid line.subtle" border-bottom="1px solid line.subtle" text-align="start"
                            :hover
                              background-color="danger.soft"
                            image "symbol:sign-out" width=16 height=16
                            text "Sign out" class=Label color="-exact-system-red"
                    dialog id="confirm-signout" role="alertdialog" aria-label=(onKey ? "Remove the API key?" : "Sign out of ChatGPT?")
                      text "Your imp stops until you sign in again. Your chats and apps stay."
                      button commandfor="confirm-signout" command="close" testId="signout-cancel"
                        text "Cancel"
                      button press=signOut commandfor="confirm-signout" command="close" destructive=true testId="signout-confirm"
                        text "Sign out"
                  if e.name == "computer"
                    ComputerScreen(computer=computer, src=`${host.origin}/computer/screen?embed&scheme=${scheme}`,
                      shown=(nav.tab == "computer"), openTab=openScreen, setUp=pick("settings"))
                  // <apps:screens>
                  if e.name == "github"
                    AppPage(id="github", draft=hasDraft("github", apps), undo=undoKind("github", apps), reads=readsOf("github", apps), sync=syncOf("github", apps), save=saveApp, discard=discardApp, undoSave=undoApp, syncNow=syncApp, keys=keys)
                      GithubScreen(inbox=githubReadInbox, done=githubDoDone, snooze=githubDoSnooze, restore=githubDoRestore)
                  if e.name == "todos"
                    AppPage(id="todos", draft=hasDraft("todos", apps), undo=undoKind("todos", apps), reads=readsOf("todos", apps), sync=syncOf("todos", apps), save=saveApp, discard=discardApp, undoSave=undoApp, syncNow=syncApp, keys=keys)
                      TodosScreen(list=todosReadList, add=todosDoAdd, setDone=todosDoSetDone, rename=todosDoRename, remove=todosDoRemove)
                  // </apps:screens>
        // The conversations and the tricks, beside the chat on a wide window.
        if sidebar
          aside position="absolute" top="3.25rem" left=0 bottom=0 width="16rem" box-sizing="border-box"
            display="flex" flex-direction="column" border-right="1px solid line.subtle" background-color="surface.page"
            aria-label="Conversations, routines and tricks"
            Sidebar(prefix="", conversations=chat.conversations, current=chat.current, pane=pane, tricks=tricks.length,
              routines=routines, olderOpen=olderOpen, newChat=newChat, show=showChat, openRoutine=showRoutine,
              openTricks=openTricks, openDirectory=openDirectory, toggleOlder=toggleOlder, keyboard=keyboard)
        // The chat, beside the open app on a wide window: the same conversation, told what the person is looking at.
        if docked
          aside position="absolute" top="3.25rem" right=0 bottom=0 width="26rem" box-sizing="border-box"
            display="flex" flex-direction="column" border-left="1px solid line.subtle" background-color="surface.page"
            aria-label="Chat" testId="chat-panel"
            row align-items="center" gap=10 padding="0 10px 0 18px" height="3.25rem" box-sizing="border-box"
              border-bottom="1px solid line.subtle"
              text "Chat" class=Label color="ink.strong" role="heading" aria-level=2
              if chat.busy
                row width=6 height=6 background-color="AccentColor" aria-label="Imp at work" testId="side-busy"
                  animation=(still ? "none" : "pulse 1.2s ease-in-out infinite")
              row flex=1
              button press=pick("chat") aria-label="Open the full chat" testId="chat-expand" appearance="none"
                width=32 height=32 padding=0 display="flex" align-items="center" justify-content="center"
                border="none" background-color="transparent" color="ink.muted"
                :hover
                  background-color="surface.soft"
                image "symbol:icon.expand" width=15 height=15
              button press=toggleDock aria-label="Hide chat" testId="chat-hide" appearance="none"
                width=32 height=32 padding=0 display="flex" align-items="center" justify-content="center"
                border="none" background-color="transparent" color="ink.muted"
                :hover
                  background-color="surface.soft"
                image "symbol:close" width=15 height=15
            if chat.messages.length == 0 and not chat.busy
              column flex=1 min-height=0 justify-content="flex-end" padding="24px 18px" gap=8 testId="side-empty"
                Initialled(word=`Ask about ${openAppName}.`, size="1.75rem", heading=3)
                text (nav.tab == "computer" ? "Ask your imp to do something on it, and watch it work." : "Your imp can read it, change it, and build on it while you watch.")
                  font-style="italic" color="ink.muted"
            else
              Transcript(prefix="side-", compact=true, messages=chat.messages, lastId=lastId, still=still)
            Composer(prefix="side-", placeholder=`Ask about ${openAppName}`, compact=true, draft=draft, busy=chat.busy,
              sending=pending(sent), stopping=pending(stopped), error=composerError, edit=edit, post=post, stop=stop,
              canDictate=canDictate, dictating=dictating, heard=interimHeard, dictate=dictate, keys=keys)
        // The apps, drawn: on a wide window a dock floating over the bottom of the page (Chat, each app's cover, and
        // Settings at the end; the open one shows its name), on a phone a bar of symbols along the bottom.
        row role="tablist" appearance="none" testId="tabs" position="absolute" box-sizing="border-box"
          left=(wide ? (docked ? "calc((100% - 26rem) / 2)" : sidebar ? "calc(16rem + (100% - 16rem) / 2)" : "50%") : "0px") right=(wide ? "auto" : "0px")
          translate=(wide ? "-50% 0" : "0 0") bottom=(wide ? "16px" : "0px")
          height=(wide ? "auto" : "calc(3.5rem + env(safe-area-inset-bottom))")
          padding=(wide ? "5px" : "0 0 env(safe-area-inset-bottom)") gap=(wide ? 4 : 0)
          align-items=(wide ? "center" : "stretch") background-color="surface.page"
          border=(wide ? "1px solid line.strong" : "none") border-top=(wide ? "1px solid line.strong" : "1px solid line.subtle")
          box-shadow=(wide ? "0 10px 28px -12px rgba(0, 0, 0, 0.35)" : "none")
          // Every tab stays in the tablist, the Computer tab hidden until there is a computer: a tab left out unlinks
          // its panel, which then shows over every page.
          for t, i in nav.tabs key=t.name
            button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=pick(t.name)
              aria-keyshortcuts=tabChord(t.name, i) aria-label=tabLabel(t.name, apps) title=tabLabel(t.name, apps)
              testId=`tab-${t.name}` appearance="none"
              display=(t.name == "computer" and computer.status == "none" ? "none" : "flex")
              align-items="center" justify-content="center" position="relative"
              flex-direction=(wide ? "row" : "column") flex=(wide ? "0 0 auto" : "1 1 0") gap=(wide ? 9 : 4)
              height=(wide ? "2.75rem" : "auto") min-width=(wide ? "2.75rem" : "0px") box-sizing="border-box"
              padding=(wide ? (nav.tab == t.name ? "0 14px 0 4px" : "0") : "0")
              margin-left=(wide and t.name == "settings" ? "6px" : "0px")
              margin-right=(wide and t.name == "chat" ? "6px" : "0px")
              background-color=(wide and nav.tab == t.name ? "surface.soft" : "transparent")
              border=(wide ? (nav.tab == t.name ? "1px solid ink.strong" : "1px solid transparent") : "none")
              border-top=(wide ? (nav.tab == t.name ? "1px solid ink.strong" : "1px solid transparent") : (nav.tab == t.name ? "2px solid ink.strong" : "2px solid transparent"))
              color=(nav.tab == t.name ? "ink.strong" : "ink.muted") transition="background-color 120ms ease, color 120ms ease"
              :hover
                color="ink.strong"
              if wide and tabCover(t.name, apps) != ""
                image tabCover(t.name, apps) alt="" width=34 height=34 min-width=34 object-fit="cover"
                  border="1px solid line.subtle" box-sizing="border-box"
              else if wide
                row width=34 height=34 min-width=34 align-items="center" justify-content="center" box-sizing="border-box"
                  border=(nav.tab == t.name ? "1px solid transparent" : "1px solid line.strong") aria-hidden=true
                  image tabSymbol(t.name, apps) width=16 height=16
              else
                image tabSymbol(t.name, apps) width=19 height=19 aria-hidden=true
              if wide and nav.tab == t.name
                text tabLabel(t.name, apps) font-family="family.display" font-size="1.25rem" white-space="nowrap"
                  aria-hidden=true
              else if not wide
                text tabLabel(t.name, apps) font-family="family.mono" font-size="0.625rem" font-weight=500
                  letter-spacing="0.1em" text-transform="uppercase" aria-hidden=true
              if keys and tabChord(t.name, i) != ""
                KeyBadge(chord=tabChord(t.name, i), at=(wide ? "end" : "tab"))
        // On a narrow window the sidebar opens as a drawer over everything.
        if drawer and not wide
          row position="absolute" inset=0 testId="drawer"
            aside width="17rem" max-width="85%" box-sizing="border-box" display="flex" flex-direction="column"
              padding-top="env(safe-area-inset-top)" background-color="surface.page" border-right="1px solid line.strong"
              aria-label="Conversations, routines and tricks"
              Sidebar(prefix="drawer-", conversations=chat.conversations, current=chat.current, pane=pane,
                tricks=tricks.length, routines=routines, olderOpen=olderOpen, newChat=newChat, show=showChat,
                openRoutine=showRoutine, openTricks=openTricks, openDirectory=openDirectory, toggleOlder=toggleOlder,
                keyboard=keyboard)
            button press=toggleDrawer aria-label="Close" aria-keyshortcuts="Escape" testId="drawer-close" appearance="none"
              flex=1 border="none"
              background-color="ink.strong" opacity=0.25
        // The masthead above everything on a wide window: the wordmark and the day.
        if wide
          row position="absolute" top=0 left=0 right=0 height="3.25rem" box-sizing="border-box" align-items="center"
            padding="0 20px" border-bottom="1px solid line.subtle" background-color="surface.page"
            row gap=9 align-items="center"
              image "symbol:icon.imp" width=26 height=26 aria-hidden=true
              text aria-label="Imp" font-family="family.display" font-size="1.625rem" line-height=1.05
                text "I" font-family="family.script" font-size="1.18em" line-height=0.8 margin-right="0.04em"
                text "mp"
            row flex=1
            text formatDate(shown, time.utcOffset, "medium") class=Label
      else
        // Onboarding, a wizard: one question a screen, a model first and then a computer.
        scroll flex=1 min-height=0
          column min-height="100%" box-sizing="border-box" padding="36px 24px 40px" gap=28 max-width="28rem" margin="0 auto"
            justify-content="center" testId="onboarding"
            row align-items="center" gap=10 padding-bottom=12 border-bottom="1px solid ink.strong"
              image "symbol:icon.imp" width=32 height=32 aria-hidden=true
              Initialled(word="Imp", size="2rem", heading=1)
              row flex=1
              if not unreachable
                text (signedIn ? "2 / 2" : "1 / 2") class=Label testId="onboarding-step"
            if unreachable
              column gap=14 testId="host-connect" animation=(still ? "none" : "rise 260ms ease-out both")
                WizardTitle(title=(hostAddress == "" ? "Connect to your Imp" : "Your Imp isn't answering"),
                  note=(hostAddress == "" ? "Its address on your tailnet." : `Nothing answered at ${hostAddress}.`))
                row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
                  input value=hostDraft input=editHost submit=connect placeholder="imp.your-tailnet.ts.net"
                    aria-label="Host address" testId="host-address" flex=1 min-width=0 padding="9px 0" border="none"
                    background-color="transparent" outline="none" font-family="family.mono" font-size="0.9375rem"
                    color="ink.strong" autocapitalize="none" autocorrect="off" spellcheck=false
                  button press=connect disabled=(hostDraft.trim() == "") testId="host-connect-button" padding="10px 14px"
                    border="none" background-color="AccentColor" color="ink.on-fill" font-family="family.mono"
                    font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                    :disabled
                      background-color="surface.soft"
                      color="ink.faint"
                    text "Connect"
            else if signedIn
              ComputerWizard(computer=computer, switching=pending(computerSwitched) or pending(computerKeySaved),
                error=(keyError != "" ? keyError : switchError),
                useContainer=useContainer, setCloudKey=setCloudKey, useOwn=useOwn,
                copyPrompt=copySetupPrompt, choice=computerChoice, toggle=toggleComputerChoice,
                still=still)
            else if account.status == "checking" or account.status == ""
              row gap=10 align-items="center" padding="24px 0" testId="signin-starting"
                progress aria-label="Loading"
                text "Connecting…" font-style="italic" color="ink.muted"
            else
              column gap=14 animation=(still ? "none" : "rise 260ms ease-out both")
                image "assets/art/workshop.jpg" alt="An engraving of a workshop: a person at a desk among machines"
                  width="100%" height="auto" aspect-ratio="2 / 1" max-height="13rem" object-fit="cover"
                  border="1px solid line.subtle" box-sizing="border-box"
                WizardTitle(title="Connect a model", note="Your imp thinks with it.")
                if account.status == "failed"
                  text account.error color="-exact-system-red" font-size="0.9375rem" testId="signin-error"
                WizardFold(label="Continue with ChatGPT", press=foldChatGPT, testId="signin", primary=(not signingIn),
                  open=signingIn, disabled=(pending(signInStarted) or pending(signInCancelled)))
                  if account.status == "waiting"
                    column gap=12 testId="signin-waiting"
                      row align-items="center" gap=8 padding="6px 6px 6px 16px" border="1px solid line.strong"
                        text account.code flex=1 font-family="family.mono" font-size="1.5rem" font-weight=500
                          letter-spacing="0.18em" user-select="all" testId="signin-code"
                        button press=copyCode testId="signin-copy" display="flex" align-items="center" gap=6
                          padding="9px 12px" border="1px solid line.strong" background-color="transparent"
                          color="ink.strong" font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em"
                          text-transform="uppercase"
                          :hover
                            background-color="surface.soft"
                          image "symbol:copy" width=13 height=13 aria-hidden=true
                          text "Copy"
                      link href=account.url testId="signin-open" display="flex" align-items="center"
                        justify-content="center" gap=8 padding="13px 16px" background-color="AccentColor"
                        color="ink.on-fill" font-family="family.mono" font-size="0.8125rem" letter-spacing="0.1em"
                        text-transform="uppercase" text-decoration-line="none"
                        text "Open ChatGPT"
                        image "symbol:open-app" width=14 height=14 aria-hidden=true
                  row gap=10 align-items="center"
                    progress aria-label=(account.status == "waiting" ? "Waiting for approval" : "Connecting")
                    text (account.status == "waiting" ? "Waiting for approval…" : "Connecting…") font-style="italic"
                      color="ink.muted"
                WizardFold(label="Use an API key", press=toggleKeyForm, testId="key-open", primary=false, open=keyForm,
                  disabled=false)
                  column gap=14 testId="key-form"
                    KeyField(label="API address", value=keyBase, edit=editKeyBase, secret=false,
                      placeholder="https://api.openai.com/v1", testId="key-base")
                    KeyField(label="API key", value=keyValue, edit=editKeyValue, secret=true, placeholder="sk-…",
                      testId="key-value")
                    KeyField(label="Model", value=keyModel, edit=editKeyModel, secret=false, placeholder="gpt-5",
                      testId="key-model")
                    if apiKeyError != "" and not pending(keyUsed)
                      text apiKeyError color="-exact-system-red" font-size="0.9375rem" testId="key-error"
                    WizardButton(label=(pending(keyUsed) ? "Checking…" : "Connect"), press=useKey, testId="key-use",
                      primary=true, disabled=(pending(keyUsed) or keyBase.trim() == "" or keyValue.trim() == "" or keyModel.trim() == ""))

// The owner's secrets in Settings: the API keys the imp uses on its computer without seeing them, and the logins the
// host types into its Chrome; a form to add either (a value is never shown again once saved), what the imp asked for,
// and its latest uses. A login's form uses `hosts` for its site and `value` for its password.
component SecretSettings
  props
    secrets: Secrets
    saving: bool
    error: string
    loginError: string
    deleteError: string
    save: action
    saveLogin: action
    remove: action
    dismiss: action
  state adding = ""
  state name = ""
  state value = ""
  state hosts = ""
  state header = ""
  state prefix = ""
  state envName = ""
  state username = ""
  state otp = ""
  // The secret Delete asks about.
  state deleting = ""
  derive replacing = secrets.secrets.filter(x => x.name == name).length > 0
  derive login = adding == "login"
  derive formLabel = match first(secrets.services.filter(x => x.id == adding)) { case some(x) => x.label, case none => "Other" }
  derive ready = login ? (hosts.trim() != "" and username.trim() != "" and (value != "" or replacing)) : (value.trim() != "" and name.trim() != "")
  derive formError = login ? loginError : error
  action pick(service: string)
    adding = service
    name = (service == "other" or service == "login") ? "" : service
  action ask(service: string, wanted: string, host: string)
    adding = service
    name = wanted
    hosts = host
  action replace(service: string, secret: string, site: string, user: string)
    adding = service
    name = secret
    hosts = site
    username = user
  action cancel
    adding = ""
    name = ""
    value = ""
    hosts = ""
    username = ""
    otp = ""
  action editName(v: string)
    name = v
  action editValue(v: string)
    value = v
  action editHosts(v: string)
    hosts = v
  action editHeader(v: string)
    header = v
  action editPrefix(v: string)
    prefix = v
  action editEnv(v: string)
    envName = v
  action editUsername(v: string)
    username = v
  action editOtp(v: string)
    otp = v
  action askRemove(secret: string)
    deleting = secret
    showModal("confirm-secret-delete")
  action confirmRemove
    remove(deleting)
    deleting = ""
  action submit
    if ready and not saving
      if login
        saveLogin(name.trim(), hosts, username, value, otp)
      else
        save(name.trim(), adding, value.trim(), hosts, header, prefix, envName)
  view
    column testId="secrets"
      row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
        text "Secrets" class=Label color="ink.strong" role="heading" aria-level=2
        text `No. ${numbered(secrets.secrets.length)}` class=Label
      text "API keys and logins your imp uses without ever seeing them. Its computer gets a stand-in for each key, and your host swaps in the real one only on requests to that key's sites. A login is typed only into the site it belongs to."
        font-size="0.9375rem" color="ink.muted" line-height=1.45 padding-top=10
      if secrets.status == "failed"
        row gap=8 align-items="flex-start" padding="10px 14px" margin-top=12 background-color="danger.soft"
          border-left="2px solid -exact-system-red"
          image "symbol:alert" color="-exact-system-red" width=16 height=16 aria-hidden=true
          text secrets.error font-size="0.9375rem" flex=1 min-width=0 overflow-wrap="anywhere" testId="secrets-error"
      for q, k in secrets.requests key=q.id
        row gap=12 align-items="center" padding="12px 14px" margin-top=12 border="1px solid line.strong" testId=`secret-request-${k}`
          column flex=1 min-width=0 gap=2
            text `Your imp asks for ${q.name}` font-size="1.0625rem" overflow-wrap="anywhere"
            text q.why font-size="0.875rem" color="ink.muted" font-style="italic" overflow-wrap="anywhere"
          button press=ask(q.service, q.name, q.host) testId=`secret-request-add-${k}` padding="8px 12px" border="none"
            background-color="AccentColor" color="ink.on-fill" font-family="family.mono" font-size="0.75rem"
            letter-spacing="0.1em" text-transform="uppercase"
            text "Add"
          button press=dismiss(q.id) aria-label=`Dismiss the request for ${q.name}` testId=`secret-request-dismiss-${k}`
            appearance="none" width=28 height=28 padding=0 display="flex" align-items="center" justify-content="center"
            border="none" background-color="transparent" color="ink.faint"
            :hover
              color="ink.strong"
            image "symbol:close" width=11 height=11
      column border-top="1px solid line.subtle" margin-top=14
        if secrets.secrets.length == 0
          text (secrets.status == "starting" ? "Opening the vault…" : "No secrets yet.") font-style="italic" color="ink.muted"
            padding="12px 0" border-bottom="1px solid line.subtle" testId="secrets-empty"
        for x, i in secrets.secrets key=x.name
          row gap=12 align-items="center" padding="12px 0" border-bottom="1px solid line.subtle" testId=`secret-${i}`
            image (x.kind == "login" ? "symbol:person" : "symbol:lock") width=16 height=16 aria-hidden=true
            column flex=1 min-width=0 gap=2
              text shownName(x) font-size="1.0625rem" overflow-wrap="anywhere" testId=`secret-name-${i}`
              text x.detail font-family="family.mono" font-size="0.75rem" color="ink.muted" overflow-wrap="anywhere"
                testId=`secret-detail-${i}`
              text (x.lastUsed == "" ? `Added ${x.updated}, not used yet` : `Used ${x.lastUsed}`) font-size="0.8125rem"
                color="ink.faint" testId=`secret-used-${i}`
            button press=replace(x.service, x.name, x.site, x.username) aria-label=`Replace ${shownName(x)}`
              testId=`secret-replace-${i}` appearance="none" padding="4px 0"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                color="ink.strong"
              text "Replace" class=Label color="inherit"
            button press=askRemove(x.name) aria-label=`Delete ${shownName(x)}` testId=`secret-delete-${i}` appearance="none"
              padding="4px 0" border="none" background-color="transparent" color="ink.muted"
              :hover
                color="-exact-system-red"
              text "Delete" class=Label color="inherit"
      dialog id="confirm-secret-delete" role="alertdialog" aria-label=`Delete ${secretLabel(deleting, secrets.secrets)}?`
        text "Your imp can no longer use it, and its value can't be brought back. Add it again to use it."
        button commandfor="confirm-secret-delete" command="close" testId="secret-delete-cancel"
          text "Cancel"
        button press=confirmRemove commandfor="confirm-secret-delete" command="close" destructive=true
          testId="secret-delete-confirm"
          text "Delete"
      if deleteError != ""
        text deleteError color="-exact-system-red" font-size="0.9375rem" padding-top=10 testId="secret-delete-error"
      if adding == ""
        column gap=10 padding-top=16
          text "Add a secret" font-family="family.display" font-size="1.25rem" role="heading" aria-level=3
          row flex-wrap="wrap" gap=8
            for v in secrets.services key=v.id
              button press=pick(v.id) testId=`secret-add-${v.id}` padding="8px 12px" border="1px solid line.strong"
                background-color="transparent" color="ink.strong" font-family="family.mono" font-size="0.75rem"
                letter-spacing="0.1em" text-transform="uppercase"
                :hover
                  background-color="surface.soft"
                text v.label
            button press=pick("other") testId="secret-add-other" padding="8px 12px" border="1px solid line.strong"
              background-color="transparent" color="ink.strong" font-family="family.mono" font-size="0.75rem"
              letter-spacing="0.1em" text-transform="uppercase"
              :hover
                background-color="surface.soft"
              text "Other"
            button press=pick("login") testId="secret-add-login" padding="8px 12px" border="1px solid line.strong"
              background-color="transparent" color="ink.strong" font-family="family.mono" font-size="0.75rem"
              letter-spacing="0.1em" text-transform="uppercase"
              :hover
                background-color="surface.soft"
              text "Login"
      else
        column gap=10 padding-top=16 testId="secret-form"
          text (replacing ? `Replace ${secretLabel(name, secrets.secrets)}` : login ? "Add a login" : adding == "other" ? "Add a key for another service" : `Add your ${formLabel} key`)
            font-family="family.display" font-size="1.25rem"
            role="heading" aria-level=3
          // Why the last save was refused, read before the fields it is about.
          if formError != "" and not saving
            text formError color="-exact-system-red" font-size="0.9375rem" testId="secret-error"
          if adding == "other" and not replacing
            column gap=8
              input value=name input=editName placeholder="Name, such as weather" aria-label="Name" testId="secret-name"
                padding="9px 14px" border="1px solid line.strong" background-color="transparent" font-size="0.9375rem"
                color="ink.strong"
              input value=hosts input=editHosts placeholder="Hosts, such as api.example.com" aria-label="Hosts"
                testId="secret-hosts" padding="9px 14px" border="1px solid line.strong" background-color="transparent"
                font-family="family.mono" font-size="0.875rem" color="ink.strong"
              row gap=8
                input value=header input=editHeader placeholder="Header, such as Authorization" aria-label="Header"
                  testId="secret-header" flex=1 min-width=0 padding="9px 14px" border="1px solid line.strong"
                  background-color="transparent" font-family="family.mono" font-size="0.875rem" color="ink.strong"
                input value=prefix input=editPrefix placeholder="Before the key, such as Bearer" aria-label="Before the key"
                  testId="secret-prefix" flex=1 min-width=0 padding="9px 14px" border="1px solid line.strong"
                  background-color="transparent" font-family="family.mono" font-size="0.875rem" color="ink.strong"
              input value=envName input=editEnv placeholder="Variable, such as WEATHER_API_KEY" aria-label="Variable"
                testId="secret-env" padding="9px 14px" border="1px solid line.strong" background-color="transparent"
                font-family="family.mono" font-size="0.875rem" color="ink.strong"
          if login
            column gap=8
              input value=hosts input=editHosts placeholder="Site, such as github.com" aria-label="Site" testId="secret-site"
                padding="9px 14px" border="1px solid line.strong" background-color="transparent" font-family="family.mono"
                font-size="0.875rem" color="ink.strong"
              input value=username input=editUsername placeholder="Username or email" aria-label="Username"
                testId="secret-username" padding="9px 14px" border="1px solid line.strong" background-color="transparent"
                font-size="0.9375rem" color="ink.strong"
              input type="password" value=value input=editValue submit=submit
                placeholder=(replacing ? "Password: leave empty to keep it" : "Password") aria-label="Password"
                testId="secret-value" padding="9px 14px" border="1px solid line.strong" background-color="transparent"
                font-family="family.mono" font-size="0.875rem" color="ink.strong"
              input type="password" value=otp input=editOtp submit=submit
                placeholder=(replacing ? "One-time-code key: leave empty to keep it" : "One-time-code key (optional)")
                aria-label="One-time-code key" testId="secret-otp" padding="9px 14px" border="1px solid line.strong"
                background-color="transparent" font-family="family.mono" font-size="0.875rem" color="ink.strong"
            text "Your host types it only into a page on this site, when your imp asks to sign in. For one-time codes, paste the otpauth:// link or the key the site shows when you set up an authenticator app."
              font-size="0.875rem" color="ink.muted" line-height=1.45
          else
            match first(secrets.services.filter(v => v.id == adding))
              case some(v)
                text `Goes on requests to ${v.hosts}. Your imp reads it as ${v.env}.` font-size="0.875rem" color="ink.muted"
                  line-height=1.45
              case none
                text "The key goes in the Authorization header unless you name another. If the service wants a word before the key, such as Bearer, write it in Before the key."
                  font-size="0.875rem" color="ink.muted" line-height=1.45
          if login
            button press=submit disabled=(not ready or saving) testId="secret-save" align-self="flex-start"
              padding="9px 14px" border="none" background-color="AccentColor" color="ink.on-fill" font-family="family.mono"
              font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
              :disabled
                background-color="surface.soft"
                color="ink.faint"
              text (saving ? "Saving" : "Save")
          else
            row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
              input type="password" value=value input=editValue submit=submit
                placeholder="Paste the key" aria-label="Key" testId="secret-value" flex=1 min-width=0 padding="8px 0" border="none"
                background-color="transparent" outline="none" font-family="family.mono" font-size="0.875rem" color="ink.strong"
              button press=submit disabled=(not ready or saving) testId="secret-save"
                padding="9px 14px" border="none" background-color="AccentColor" color="ink.on-fill" font-family="family.mono"
                font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                :disabled
                  background-color="surface.soft"
                  color="ink.faint"
                text (saving ? "Saving" : "Save")
          button press=cancel testId="secret-cancel" align-self="flex-start" padding="6px 0" border="none"
            background-color="transparent" color="ink.muted"
            :hover
              color="ink.strong"
            text "Cancel" class=Label color="inherit"
      if secrets.uses.length > 0
        column gap=4 padding-top=18
          text "Recent use" class=Label
          for u, j in secrets.uses key=u.id
            row gap=10 align-items="baseline" testId=`secret-use-${j}`
              text u.secret font-size="0.875rem" min-width="5rem"
              text u.what font-family="family.mono" font-size="0.75rem" color="ink.muted" flex=1 min-width=0
                overflow-wrap="anywhere"
              text u.result font-family="family.mono" font-size="0.75rem"
                color=(u.failed ? "-exact-system-red" : "ink.muted")
              text u.when font-size="0.75rem" color="ink.faint"

// The left sidebar: a new chat, the imp's tricks, the app directory, its routines, the three latest conversations and,
// folded under them, the rest.
component Sidebar
  props
    prefix: string
    conversations: ChatSummary[]
    current: string
    pane: string
    tricks: number
    routines: Routine[]
    olderOpen: bool
    newChat: action
    show: action
    openRoutine: action
    openTricks: action
    openDirectory: action
    toggleOlder: action
    keyboard: bool
  view
    column flex=1 min-height=0 testId=`${prefix}sidebar`
      column gap=2 padding="14px 10px 12px" border-bottom="1px solid line.subtle"
        // Beside the chat on a wide window ⌘N is this button's; on a narrow one, the page header's (under the drawer).
        button press=newChat aria-keyshortcuts=(prefix == "" ? "Meta+N" : "") testId=`${prefix}chat-new`
          appearance="none" display="flex" align-items="center" gap=10 padding="9px 10px" border="none"
          background-color="transparent" color="ink.strong" text-align="start"
          :hover
            background-color="surface.soft"
          image "symbol:compose" width=15 height=15 aria-hidden=true
          text "New chat" font-size="0.9375rem" flex=1
          if keyboard
            text "⌘N" class=Key border-color="line.subtle" testId=`${prefix}chat-new-keys` aria-hidden=true
        button press=openTricks aria-pressed=(pane == "tricks") testId=`${prefix}tricks-entry` appearance="none"
          display="flex" align-items="center" gap=10 padding="9px 10px" border="none" text-align="start"
          background-color=(pane == "tricks" ? "surface.soft" : "transparent") color="ink.strong"
          :hover
            background-color="surface.soft"
          image "symbol:sparkles" width=15 height=15 aria-hidden=true
          text "Tricks" font-size="0.9375rem" flex=1
          text `${tricks}` class=Label testId=`${prefix}tricks-count`
        button press=openDirectory aria-pressed=(pane == "directory") testId=`${prefix}directory-entry` appearance="none"
          display="flex" align-items="center" gap=10 padding="9px 10px" border="none" text-align="start"
          background-color=(pane == "directory" ? "surface.soft" : "transparent") color="ink.strong"
          :hover
            background-color="surface.soft"
          image "symbol:layers" width=15 height=15 aria-hidden=true
          text "App directory" font-size="0.9375rem" flex=1
      scroll flex=1 min-height=0
        column gap=2 padding="14px 10px 20px"
          text "Routines" class=Label padding="0 10px 6px"
          if routines.length == 0
            text "None yet. Ask your imp to do something on a schedule." font-size="0.875rem" font-style="italic"
              color="ink.muted" padding="4px 10px" testId=`${prefix}routines-empty`
          for r, i in routines key=r.id
            RoutineEntry(prefix=prefix, index=i, routine=r, selected=(pane == "chat" and r.id == current), open=openRoutine)
          text "Recent" class=Label padding="16px 10px 6px"
          if conversations.length == 0
            text "Nothing said yet." font-size="0.875rem" font-style="italic" color="ink.muted" padding="4px 10px"
          for c, i in conversations.slice(0, 3) key=c.id
            ChatEntry(prefix=prefix, index=i, id=c.id, title=c.title, selected=(pane == "chat" and c.id == current), show=show)
          if conversations.length > 3
            button press=toggleOlder aria-expanded=olderOpen testId=`${prefix}conversations-older` appearance="none"
              display="flex" align-items="center" gap=8 padding="9px 10px" margin-top=4 border="none"
              background-color="transparent" color="ink.muted" text-align="start"
              :hover
                color="ink.strong"
              text (olderOpen ? "−" : "+") font-family="family.mono" width=12 aria-hidden=true
              text (olderOpen ? "Hide older" : `Older (${conversations.length - 3})`) class=Label color="inherit"
            if olderOpen
              for c, i in conversations.slice(3) key=c.id
                ChatEntry(prefix=prefix, index=(i + 3), id=c.id, title=c.title, selected=(pane == "chat" and c.id == current), show=show)

// One conversation in the sidebar, by its first message.
component ChatEntry
  props
    prefix: string
    index: number
    id: string
    title: string
    selected: bool
    show: action
  view
    button press=show(id) aria-pressed=selected testId=`${prefix}conversation-${index}` appearance="none" display="flex"
      padding="8px 10px" border="none" text-align="start" color="ink.strong" min-width=0
      background-color=(selected ? "surface.soft" : "transparent")
      :hover
        background-color="surface.soft"
      text title font-size="0.9375rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// A routine in the sidebar: its name, its schedule, and a mark while it runs (cobalt) or has a run the person has not
// read (ink).
component RoutineEntry
  props
    prefix: string
    index: number
    routine: Routine
    selected: bool
    open: action
  view
    button press=open(routine.id) aria-pressed=selected testId=`${prefix}routine-${index}` appearance="none" display="flex"
      align-items="center" gap=10 padding="8px 10px" border="none" text-align="start" color="ink.strong" min-width=0
      background-color=(selected ? "surface.soft" : "transparent")
      :hover
        background-color="surface.soft"
      image "symbol:repeat" width=15 height=15 aria-hidden=true
      column flex=1 min-width=0 gap=1
        text routine.name font-size="0.9375rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          testId=`${prefix}routine-name-${index}`
        text (routine.paused ? "Paused" : routine.when) font-family="family.mono" font-size="0.6875rem"
          color="ink.muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      if routine.running
        row width=7 height=7 min-width=7 background-color="AccentColor" aria-label="Running"
          testId=`${prefix}routine-running-${index}`
      else if routine.unread
        row width=7 height=7 min-width=7 background-color="ink.strong" aria-label="New run"
          testId=`${prefix}routine-unread-${index}`

// Above an open routine's conversation: when it runs, what it does, how its last run went, and the person's controls.
component RoutineBar
  props
    routine: Routine
    busy: bool
    run: action
    pause: action
    remove: action
    keys: bool
  view
    row justify-content="center" padding="0 20px" border-bottom="1px solid line.subtle" testId="routine-bar"
      column width="100%" max-width="46rem" gap=8 padding="14px 0"
        row align-items="baseline" gap=10 flex-wrap="wrap"
          text "Routine" class=Label color="ink.strong"
          text routine.when font-family="family.display" font-size="1.25rem" line-height=1.15 testId="routine-when"
          row flex=1
          text routineStatus(routine) class=Label testId="routine-status"
        text routine.instruction font-size="0.9375rem" color="ink.muted" line-height=1.45 testId="routine-instruction"
        row align-items="center" gap=8 flex-wrap="wrap"
          text routineLast(routine) font-size="0.875rem" color=(routine.failed ? "-exact-system-red" : "ink.muted")
            flex=1 min-width="10rem" testId="routine-last"
          row gap=8
            button press=run(routine.id) disabled=(busy or routine.running or routine.asked) aria-keyshortcuts="Meta+R"
              testId="routine-run" display="flex" align-items="center" gap=7 padding="7px 10px"
              border="1px solid ink.strong" background-color="ink.strong" color="surface.page" position="relative"
              image "symbol:play" width=12 height=12 aria-hidden=true
              text "Run now" class=Label color="inherit"
              if keys
                KeyBadge(chord="Meta+R", at="end")
            button press=pause(routine.id, not routine.paused) disabled=busy testId="routine-pause" padding="7px 10px"
              border="1px solid line.strong" background-color="transparent" color="ink.strong"
              :hover
                background-color="surface.soft"
              text (routine.paused ? "Resume" : "Pause") class=Label color="inherit"
            button press=remove disabled=busy testId="routine-delete" padding="7px 10px" border="1px solid line.strong"
              background-color="transparent" color="-exact-system-red"
              :hover
                background-color="danger.soft"
              text "Delete" class=Label color="inherit"

// The imp's tricks: what each does, on which site, and what it asks for. One asked for starts a message.
component TrickList
  props
    tricks: Trick[]
    use: action
  view
    scroll id="tricks-list" flex=1 min-height=0
      column max-width="48.5rem" margin="0 auto" padding="28px 20px 32px" gap=18 box-sizing="border-box" width="100%"
        testId="tricks"
        text "What your imp learned to do in a browser. It repeats a trick in seconds instead of clicking through the site again. Pick one to ask for it."
          color="ink.muted" font-size="1.0625rem" line-height=1.5 max-width="34rem"
        column
          row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
            text "Your tricks" class=Label color="ink.strong" role="heading" aria-level=2
            text `No. ${numbered(tricks.length)}` class=Label
          if tricks.length == 0
            text "None yet. When your imp does something in the browser you may ask for again, it keeps it here."
              font-size="0.9375rem" font-style="italic" color="ink.muted" padding="14px 0" testId="tricks-empty"
          for k, i in tricks key=k.name
            button press=use(k.title) testId=`trick-${i}` display="flex" align-items="center" gap=14 padding="14px 0"
              background-color="transparent" border="none" border-bottom="1px solid line.subtle" text-align="start"
              color="ink.strong" transition="background-color 120ms ease"
              :hover
                background-color="surface.soft"
              row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                image "symbol:sparkles" width=18 height=18
              column gap=2 flex=1 min-width=0
                text k.title font-family="family.display" font-size="1.375rem" line-height=1.1 testId=`trick-title-${i}`
                text (k.params.length == 0 ? k.site : `${k.site} · asks for the ${k.params.join(" and the ")}`) font-size="0.9375rem"
                  color="ink.muted" line-clamp=1
              text "→" font-family="family.mono" color="ink.muted" aria-hidden=true padding-right=4

// The app directory: a link to any app on GitHub, and apps others built, each installed by the imp as a preview to try
// before keeping it. An app already installed opens instead.
component AppDirectory
  props
    entries: DirectoryApp[]
    // The apps installed now: one of them opens instead, and shows its own cover.
    installed: AppTile[]
    sending: bool
    install: action
    open: action
  state link = ""
  derive repo = repoLink(link.trim())
  action editLink(v: string)
    link = v
  action installLink
    if repo != "" and not sending
      install(repo)
      link = ""
  view
    scroll id="directory-list" flex=1 min-height=0
      column max-width="48.5rem" margin="0 auto" padding="28px 20px 32px" gap=28 box-sizing="border-box" width="100%"
        testId="directory"
        text "Apps other people built for their imps. Pick one, or paste a link to one on GitHub: your imp brings it in as a preview, and you keep it if you like it."
          color="ink.muted" font-size="1.0625rem" line-height=1.5 max-width="34rem"
        column gap=12
          row padding-bottom=10 border-bottom="1px solid ink.strong"
            text "From a link" class=Label color="ink.strong" role="heading" aria-level=2
          row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
            input value=link input=editLink submit=installLink placeholder="github.com/owner/app" aria-label="Link to an app on GitHub"
              testId="directory-link" flex=1 min-width=0 padding="9px 0" border="none" background-color="transparent"
              outline="none" font-family="family.mono" font-size="0.9375rem" color="ink.strong" autocapitalize="none"
              autocorrect="off" spellcheck=false
            button press=installLink disabled=(repo == "" or sending) testId="directory-link-install" padding="10px 14px"
              border="none" background-color="AccentColor" color="ink.on-fill" font-family="family.mono"
              font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
              :disabled
                background-color="surface.soft"
                color="ink.faint"
              text "Install"
          if link.trim() != "" and repo == ""
            text "That isn't a link to a GitHub repository. It looks like github.com/owner/app." font-size="0.875rem"
              color="-exact-system-red" testId="directory-link-error"
        column
          row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
            text "In the directory" class=Label color="ink.strong" role="heading" aria-level=2
            text `No. ${numbered(entries.length)}` class=Label
          for a in entries key=a.id
            row align-items="center" gap=14 padding="14px 0" border-bottom="1px solid line.subtle" testId=`directory-${a.id}`
              match first(installed.filter(x => x.id == a.id and x.cover != ""))
                case some(x)
                  image x.cover alt="" width=44 height=44 min-width=44 object-fit="cover"
                    border="1px solid line.subtle" box-sizing="border-box"
                case none
                  row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                    border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                    image a.symbol width=18 height=18
              column gap=2 flex=1 min-width=0
                text a.name font-family="family.display" font-size="1.375rem" line-height=1.1 testId=`directory-name-${a.id}`
                text a.description font-size="0.9375rem" color="ink.muted" line-height=1.4
                text `${repoPath(a.repo)}` font-family="family.mono" font-size="0.75rem" color="ink.faint"
                  white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              if installed.map(x => x.id).includes(a.id)
                button press=open(a.id) aria-label=`Open ${a.name}` testId=`directory-open-${a.id}` padding="8px 12px"
                  border="1px solid line.strong" background-color="transparent" color="ink.strong" font-family="family.mono"
                  font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                  :hover
                    background-color="surface.soft"
                  text "Open"
              else
                button press=install(a.repo) disabled=sending aria-label=`Install ${a.name}` testId=`directory-install-${a.id}`
                  padding="8px 12px" border="1px solid AccentColor" background-color="transparent" color="AccentColor"
                  font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                  :hover
                    background-color="Highlight"
                  :disabled
                    border-color="line.subtle"
                    color="ink.faint"
                  text "Install"

// What the imp remembers, in Settings: who it is, who its person is, and everything else it learned, each fact with
// a way to forget it.
component MemorySettings
  props
    memory: Memory
    forget: action
  // The entry Forget asks about, by its id and title.
  state forgetting = ""
  state forgettingTitle = ""
  action askForget(entry: string, title: string)
    forgetting = entry
    forgettingTitle = title
    showModal("confirm-memory-forget")
  action confirmForget
    forget(forgetting, "")
    forgetting = ""
  view
    column testId="memory"
      row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
        text "Memory" class=Label color="ink.strong" role="heading" aria-level=2
        text `No. ${numbered(sum(memory.entries.map(m => m.facts.length + m.links.length)))}` class=Label
      if memory.entries.length == 0
        text "Nothing yet. Your imp remembers what it learns as you talk: your name, the people and things in your life, how you like things done."
          font-size="0.9375rem" color="ink.muted" line-height=1.45 padding="14px 0" border-bottom="1px solid line.subtle"
          testId="memory-empty"
      for m, j in memory.entries key=m.id
        column gap=6 padding="14px 0" border-bottom="1px solid line.subtle" testId=`memory-${j}`
          row align-items="baseline" gap=10
            text m.title font-family="family.display" font-size="1.375rem" line-height=1.15 flex=1 min-width=0
              overflow-wrap="anywhere" testId=`memory-title-${j}`
            if m.kind != ""
              text m.kind class=Label
            button press=askForget(m.id, m.title) aria-label=`Forget everything about ${aboutTitle(m.title)}` testId=`memory-forget-${j}`
              appearance="none" padding="4px 0" border="none" background-color="transparent" color="ink.muted"
              :hover
                color="-exact-system-red"
              text "Forget" class=Label color="inherit"
          for f, i in m.facts key=f
            row align-items="baseline" gap=10
              text "—" color="ink.faint" aria-hidden=true
              text f flex=1 min-width=0 font-size="0.9375rem" line-height=1.45 overflow-wrap="break-word"
                testId=`memory-fact-${j}-${i}`
              button press=forget(m.id, f) aria-label=`Forget: ${f}` testId=`memory-forget-${j}-${i}` appearance="none"
                width=24 height=24 min-width=24 padding=0 display="flex" align-items="center" justify-content="center"
                border="none" background-color="transparent" color="ink.faint"
                :hover
                  color="-exact-system-red"
                image "symbol:close" width=11 height=11
          for l in m.links key=l
            text l font-family="family.mono" font-size="0.75rem" color="ink.muted" padding-left=20
      dialog id="confirm-memory-forget" role="alertdialog" aria-label=`Forget everything about ${aboutTitle(forgettingTitle)}?`
        text "Your imp loses every fact here. It may learn some of them again as you talk."
        button commandfor="confirm-memory-forget" command="close" testId="memory-forget-cancel"
          text "Cancel"
        button press=confirmForget commandfor="confirm-memory-forget" command="close" destructive=true
          testId="memory-forget-confirm"
          text "Forget"
      if memory.name != ""
        column gap=2 padding-top=10
          text `${memory.name}, kept on your host.` font-size="0.8125rem" font-style="italic" color="ink.faint"
          text memory.location font-family="family.mono" font-size="0.6875rem" color="ink.faint" overflow-wrap="anywhere"

// Where the apps' code is kept besides the host: every version in the host's history, and a private GitHub repository
// the host pushes each one to, connected with a device code like the ChatGPT sign-in.
// Whether this device tells the person what needs them. The browser or the system asks once; after a no, only its own
// settings can turn notifications back on.
component NotificationSettings
  props
    alerts: NotificationStatus
    asking: bool
    allow: action
  view
    column testId="notifications"
      row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
        text "Notifications" class=Label color="ink.strong" role="heading" aria-level=2
        if alerts.available
          text (alerts.state == "granted" ? "On" : "Off") class=Label testId="notifications-state"
      text "Your imp tells you when a routine finds something, when it needs a key from you, and when it finishes a reply while you are elsewhere. This device shows them while Imp is open on it."
        font-size="0.9375rem" color="ink.muted" line-height=1.45 padding-top=14
      if not alerts.available
        text "This browser can't show notifications." font-style="italic" color="ink.muted" padding-top=12
          testId="notifications-unavailable"
      else if alerts.state == "denied"
        text "Notifications are blocked for Imp. Allow them in your browser's settings for this site, or in System Settings for the app."
          font-style="italic" color="ink.muted" padding-top=12 testId="notifications-denied"
      else if alerts.state != "granted"
        button press=allow disabled=asking testId="notifications-allow" align-self="flex-start"
          margin-top=16 padding="10px 14px" border="none" background-color="AccentColor" color="ink.on-fill"
          font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
          :disabled
            background-color="surface.soft"
            color="ink.faint"
          text "Turn on notifications"

component BackupSettings
  props
    backup: Backup
    busy: bool
    connect: action
    cancel: action
    disconnect: action
    copyCode: action
  view
    column testId="backup"
      row align-items="baseline" justify-content="space-between" padding-bottom=10 border-bottom="1px solid ink.strong"
        text "Backup" class=Label color="ink.strong" role="heading" aria-level=2
        text `${backup.versions} ${backup.versions == 1 ? "version" : "versions"}` class=Label testId="backup-versions"
      text (backup.git ? "Your host keeps every version of your apps' code. Connect GitHub to keep a copy there too, in a private repository. Your apps' data stays on your host." : "Your host keeps no versions of your apps' code yet: it needs git. Install git on it, then restart Imp.")
        font-size="0.9375rem" color="ink.muted" line-height=1.45 padding-top=14
      if backup.status == "on"
        row gap=14 align-items="center" padding="16px 0" margin-top=12 border-top="1px solid line.subtle"
          border-bottom="1px solid line.subtle"
          column flex=1 min-width=0 gap=4 align-items="flex-start"
            text backup.repo font-family="family.display" font-size="1.375rem" line-height=1.15 overflow-wrap="anywhere"
              testId="backup-repo"
            row gap=8 align-items="center"
              row width=6 height=6 aria-hidden=true background-color=(backup.synced ? "-exact-system-green" : "ink.faint")
              text (backup.synced ? "Up to date" : "Not backed up yet") class=Label testId="backup-state"
          link href=`https://github.com/${backup.repo}` testId="backup-open-repo" display="flex" align-items="center" gap=8
            padding="8px 12px" border="1px solid line.strong" color="ink.strong" font-family="family.mono"
            font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase" text-decoration-line="none"
            :hover
              background-color="surface.soft"
            text "Open"
            text "↗" aria-hidden=true
        button press=disconnect disabled=busy testId="backup-disconnect" align-self="flex-start" padding="10px 0"
          border="none" background-color="transparent" color="ink.muted"
          :hover
            color="-exact-system-red"
          text "Disconnect GitHub" class=Label color="inherit"
      else if backup.status == "waiting"
        column gap=10 padding-top=18 testId="backup-waiting"
          Step(number="01", title="Open GitHub's sign-in page")
          link href=backup.url testId="backup-open" display="flex" align-items="center" justify-content="center"
            gap=8 padding="13px 16px" background-color="AccentColor" color="ink.on-fill"
            font-family="family.mono" font-size="0.8125rem" letter-spacing="0.1em" text-transform="uppercase"
            text-decoration-line="none"
            text "Open GitHub"
            image "symbol:open-app" width=14 height=14 aria-hidden=true
          Step(number="02", title="Enter this code")
          row align-items="center" gap=8 padding="6px 6px 6px 16px" border="1px solid line.strong"
            text backup.code flex=1 font-family="family.mono" font-size="1.5rem" font-weight=500
              letter-spacing="0.18em" user-select="all" testId="backup-code"
            button press=copyCode testId="backup-copy" display="flex" align-items="center" gap=6
              padding="9px 12px" border="1px solid line.strong" background-color="transparent" color="ink.strong"
              font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
              :hover
                background-color="surface.soft"
              image "symbol:copy" width=13 height=13 aria-hidden=true
              text "Copy"
          row gap=10 align-items="center" padding-top=2
            progress aria-label="Waiting for approval"
            text "Waiting for you to approve…" font-style="italic" color="ink.muted"
          button press=cancel testId="backup-cancel" align-self="flex-start" padding="4px 0" border="none"
            background-color="transparent" color="ink.muted"
            :hover
              color="ink.strong"
            text "Cancel" class=Label color="inherit"
      else if backup.status == "starting"
        row gap=10 align-items="center" padding-top=18 testId="backup-starting"
          progress aria-label="Loading"
          text "Asking GitHub for a code…" font-style="italic" color="ink.muted"
      else
        button press=connect disabled=(not backup.git or busy) testId="backup-connect" align-self="flex-start"
          margin-top=16 padding="10px 14px" border="none" background-color="AccentColor" color="ink.on-fill"
          font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
          :disabled
            background-color="surface.soft"
            color="ink.faint"
          text "Connect GitHub"
      if backup.error != ""
        row gap=8 align-items="flex-start" padding="10px 14px" margin-top=12 background-color="danger.soft"
          border-left="2px solid -exact-system-red"
          image "symbol:alert" color="-exact-system-red" width=16 height=16 aria-hidden=true
          text backup.error font-size="0.9375rem" flex=1 min-width=0 overflow-wrap="anywhere" testId="backup-error"

// A word set in the display serif with its first letter in the script, the catalogue's drop capital.
// An app's page: the shell's bar above the app's own screen, which the app cannot draw over. While the app shows a
// preview of a new version, the bar says so, says what the version reads from outside, and offers Save and Discard.
// Otherwise it says how the app's sync went, with Sync now, and after a save offers to undo it.
component AppPage
  props
    id: string
    draft: bool
    undo: string
    reads: string
    sync: string
    save: action
    discard: action
    undoSave: action
    syncNow: action
    keys: bool
  slot
  view
    column flex=1 min-height=0
      if draft
        row testId="preview-bar" align-items="center" gap=12 padding="10px 20px" background-color="fill.preview"
          color="ink.on-fill" flex-wrap="wrap"
          text "Preview" class=Label color="ink.on-fill"
          column flex=1 min-width="12rem" gap=2
            text "A new version, on a copy of your data. Nothing you do here is kept." font-size="0.9375rem"
            if reads != ""
              text reads font-size="0.875rem" opacity=0.85 testId="preview-reads"
          button press=discard(id) testId="preview-discard" padding="7px 12px" border="1px solid ink.on-fill"
            background-color="transparent" color="ink.on-fill"
            text "Discard" class=Label color="inherit"
          button press=save(id) aria-keyshortcuts="Meta+S" testId="preview-save" padding="7px 12px"
            border="1px solid ink.on-fill" background-color="ink.on-fill" color="fill.preview" position="relative"
            text "Save" class=Label color="inherit"
            if keys
              KeyBadge(chord="Meta+S", at="end")
      else if undo != "" or sync != ""
        // In line with the page's title and its Chat button above.
        row justify-content="center" padding="8px 20px 0"
          row width="100%" max-width="46rem" align-items="center" gap=12
            if sync != ""
              row flex=1 min-width=0 align-items="center" gap=10 testId="sync-bar"
                text sync font-size="0.8125rem" color=(sync.startsWith("Sync failing") ? "-exact-system-red" : "ink.muted")
                  min-width=0 overflow-wrap="anywhere" testId="sync-status"
                button press=syncNow(id) disabled=(sync == "Syncing…") testId="sync-now" padding="4px 0" border="none"
                  background-color="transparent" color="ink.muted" flex-shrink=0
                  :hover
                    color="ink.strong"
                  :disabled
                    color="ink.faint"
                  text "Sync now" class=Label color="inherit"
            else
              row flex=1
            if undo != ""
              button commandfor=`undo-${id}` command="show-modal" testId="undo-save" padding="6px 10px"
                border="1px solid line.strong" background-color="transparent" color="ink.strong" flex-shrink=0
                text (undo == "remove" ? "Undo: remove app" : "Undo last save") class=Label color="inherit"
        dialog id=`undo-${id}` role="alertdialog" aria-label="Undo the last save?"
          text (undo == "remove" ? "This removes the app and its data." : undo == "data" ? "The app goes back to its previous version, and its data to how it was before that save: changes since are lost." : "The app goes back to its previous version. Its data stays.")
          button commandfor=`undo-${id}` command="close" testId="undo-cancel"
            text "Cancel"
          button press=undoSave(id) commandfor=`undo-${id}` command="close" destructive=true testId="undo-confirm"
            text "Undo"
      scroll id=`${id}-screen` flex=1 min-height=0
        children

// A shortcut's keys on its control (which is position="relative"), shown while ⌘ is held: over its top corner at the
// "end" or the "start", or for a "tab" along a narrow window's bottom edge, inside it beside the symbol at its centre.
component KeyBadge
  props
    chord: string
    at: string
  view
    text keysOf(chord) class=Key position="absolute" top=(at == "tab" ? "6px" : "-8px")
      left=(at == "tab" ? "calc(50% + 16px)" : at == "start" ? "-8px" : "auto") right=(at == "end" ? "-8px" : "auto")
      z-index=2 pointer-events="none" aria-hidden=true testId=`keys-${chord}`

component Initialled
  props
    word: string
    size: string
    heading: number
  view
    text role="heading" aria-level=heading font-family="family.display" font-size=size line-height=1.05
      letter-spacing="-0.01em"
      // The script capital's swash leans into the next letter: a little room keeps the word readable.
      text word.slice(0, 1) font-family="family.script" font-size="1.18em" line-height=0.8 margin-right="0.08em"
      text word.slice(1)

// The Computer tab: the computer's live screen, which the host serves as a page of its own, while the computer is ready;
// otherwise what it is doing, or a way to choose one.
component ComputerScreen
  props
    computer: Computer
    src: string
    shown: bool
    openTab: action
    setUp: action
  view
    column flex=1 min-height=0 testId="computer-page"
      row align-items="center" gap=10 padding="10px 20px" border-bottom="1px solid line.subtle"
        row width=6 height=6 aria-hidden=true
          background-color=(computer.status == "ready" ? "-exact-system-green" : computer.status == "failed" ? "-exact-system-red" : "ink.faint")
        text (computer.name == "" ? "No computer yet" : computer.name) font-size="0.9375rem" flex=1 min-width=0
          line-clamp=1 testId="computer-page-name"
        text computerStatus(computer.status) class=Label testId="computer-page-status"
        if computer.status == "ready"
          button press=openTab testId="computer-new-tab" display="flex" align-items="center" gap=6 padding="6px 10px"
            border="1px solid line.strong" background-color="transparent" color="ink.strong"
            :hover
              background-color="surface.soft"
            text "New window" class=Label color="inherit"
            text "↗" aria-hidden=true font-family="family.mono"
      // Connected only while the tab is open: a watched screen keeps the computer awake.
      if computer.status == "ready" and shown
        iframe src=src title="Your imp's computer" testId="computer-frame" flex=1 min-height=0 width="100%"
          border="none"
      else if computer.status != "ready"
        column flex=1 min-height=0 align-items="center" justify-content="center" gap=12 padding="24px 20px"
          text-align="center" testId="computer-waiting"
          image (computer.kind == "cloud" ? "symbol:icon.cloud" : "symbol:icon.computer") width=28 height=28 aria-hidden=true
          text (computer.status == "none" ? "Your imp has no computer yet." : computer.status == "failed" ? `Could not reach ${computer.name}.` : `Starting ${computer.name}…`)
            font-family="family.display" font-size="1.625rem" line-height=1.2 max-width="30rem"
          text (computer.status == "none" ? "Give it Imp cloud, a Linux computer of yours on Tailscale, or this machine." : computer.status == "failed" ? computer.error : "A computer that slept wakes up in a few seconds.")
            color="ink.muted" font-size="0.9375rem" max-width="34rem" overflow-wrap="anywhere"
          if computer.status == "none" or computer.status == "failed"
            button press=setUp testId="computer-set-up" padding="8px 12px" border="1px solid line.strong"
              background-color="transparent" color="ink.strong"
              :hover
                background-color="surface.soft"
              text "Open Settings" class=Label color="inherit"

// Where the agent works: the machine now, Imp cloud's sizes, and the computers on the person's tailnet with the two
// things to do once so one of them can be chosen.
component ComputerSettings
  props
    computer: Computer
    switching: bool
    switchError: string
    refreshing: bool
    useContainer: action
    useCloud: action
    setCloudKey: action
    useOwn: action
    refresh: action
    retry: action
    openScreen: action
    copyPrompt: action
  state settingUp = false
  state keyDraft = ""
  derive usable = computer.devices.filter(d => d.problem == "").length
  action toggleSetup
    settingUp = not settingUp
  action editKey(v: string)
    keyDraft = v
  view
    column
      row padding-bottom=10 border-bottom="1px solid ink.strong"
        text "Computer" class=Label color="ink.strong" role="heading" aria-level=2
      row gap=14 align-items="center" padding="16px 0" border-bottom="1px solid line.subtle"
        row width="2.75rem" height="2.75rem" min-width="2.75rem" align-items="center" justify-content="center"
          border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
          image (computer.kind == "cloud" ? "symbol:icon.cloud" : "symbol:icon.computer") width=20 height=20
        column flex=1 min-width=0 gap=4 align-items="flex-start"
          text (computer.name == "" ? "No computer yet" : computer.name) font-family="family.display" font-size="1.375rem"
            line-height=1.15 overflow-wrap="anywhere" testId="computer-name"
          row gap=8 align-items="center"
            row width=6 height=6 aria-hidden=true
              background-color=(computer.status == "ready" ? "-exact-system-green" : computer.status == "failed" ? "-exact-system-red" : "ink.faint")
            text computerStatus(computer.status) class=Label testId="computer-status"
        if computer.status == "failed"
          button press=retry testId="computer-retry" padding="8px 12px" border="1px solid line.strong"
            background-color="transparent" color="ink.strong" font-family="family.mono" font-size="0.75rem"
            letter-spacing="0.1em" text-transform="uppercase"
            :hover
              background-color="surface.soft"
            text "Retry"
        if computer.status == "ready"
          button press=openScreen testId="computer-open-screen" display="flex" align-items="center" gap=8 padding="8px 12px"
            border="1px solid line.strong" background-color="transparent" color="ink.strong" font-family="family.mono"
            font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
            :hover
              background-color="surface.soft"
            text "Open screen"
            text "→" aria-hidden=true
      if computer.status == "failed" and computer.error != ""
        row gap=8 align-items="flex-start" padding="10px 14px" margin-top=12 background-color="danger.soft"
          border-left="2px solid -exact-system-red"
          image "symbol:alert" color="-exact-system-red" width=16 height=16 aria-hidden=true
          text computer.error font-size="0.9375rem" flex=1 min-width=0 overflow-wrap="anywhere" testId="computer-error"
      if computer.kind == "dev"
        text "This host fixes the computer for development, so there is nothing to choose." font-size="0.9375rem"
          color="ink.muted" padding-top=10
      else
        text "Your imp works on one computer at a time. The one you leave keeps its files, so switching back picks up where it was."
          font-size="0.9375rem" color="ink.muted" padding-top=10 line-height=1.45
        if switchError != "" and not switching
          text switchError color="-exact-system-red" font-size="0.9375rem" padding-top=10 testId="computer-switch-error"
        column gap=10 padding-top=22
          text "Imp cloud" font-family="family.display" font-size="1.25rem" role="heading" aria-level=3
          text (computer.cloudAvailable ? "A computer in E2B's cloud. It sleeps when idle and keeps its files." : "A computer in E2B's cloud. Paste an API key from e2b.dev/dashboard: a new account gets free credit, with no card.")
            font-size="0.9375rem" color="ink.muted" line-height=1.45
          if not computer.cloudAvailable
            row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
              input type="password" value=keyDraft input=editKey submit=setCloudKey(keyDraft.trim()) placeholder="e2b_…"
                aria-label="E2B API key" testId="computer-cloud-key" flex=1 min-width=0 padding="8px 0" border="none"
                background-color="transparent" outline="none" font-family="family.mono" font-size="0.875rem" color="ink.strong"
              button press=setCloudKey(keyDraft.trim()) disabled=(keyDraft.trim() == "" or switching) testId="computer-cloud-key-save"
                padding="9px 14px" border="none" background-color="AccentColor" color="ink.on-fill" font-family="family.mono"
                font-size="0.75rem" letter-spacing="0.1em" text-transform="uppercase"
                :disabled
                  background-color="surface.soft"
                  color="ink.faint"
                text "Save"
          row role="radiogroup" aria-label="Imp cloud size"
            for z, i in computer.sizes key=z.id
              button role="radio" aria-checked=(computer.kind == "cloud" and computer.size == z.id) press=useCloud(z.id)
                disabled=(not computer.cloudAvailable or switching) flex=1 testId=`computer-size-${z.id}`
                padding="10px 4px" border="1px solid line.strong" margin-left=(i == 0 ? "0px" : "-1px")
                background-color=(computer.kind == "cloud" and computer.size == z.id ? "ink.strong" : "transparent")
                color=(computer.kind == "cloud" and computer.size == z.id ? "surface.page" : "ink.strong")
                font-family="family.mono" font-size="0.6875rem" letter-spacing="0.04em" text-transform="uppercase"
                :disabled
                  color="ink.faint"
                text z.label
        column gap=10 padding-top=26
          row align-items="center" gap=10
            text "Your computer" font-family="family.display" font-size="1.25rem" role="heading" aria-level=3 flex=1
            button press=refresh disabled=refreshing aria-label="Look for computers again" testId="computer-refresh"
              appearance="none" width=32 height=32 padding=0 display="flex" align-items="center" justify-content="center"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                background-color="surface.soft"
              image "symbol:refresh" width=15 height=15
          text "Any Linux computer on your tailnet: a home lab box, a VM, a spare laptop. Tailscale signs your imp in; no keys or passwords."
            font-size="0.9375rem" color="ink.muted" line-height=1.45
          if computer.tailnetError != ""
            text computer.tailnetError font-size="0.9375rem" color="-exact-system-red" testId="computer-tailnet-error"
          column border-top="1px solid line.subtle"
            for d in computer.devices key=d.id
              button press=useOwn(d.id) disabled=(d.problem != "" or switching)
                aria-pressed=(computer.kind == "own" and computer.device == d.id) testId=`computer-device-${d.name}`
                display="flex" align-items="center" gap=12 padding="12px 0" background-color="transparent" border="none"
                border-bottom="1px solid line.subtle" text-align="start" color="ink.strong"
                :hover
                  background-color="surface.soft"
                image "symbol:icon.computer" width=16 height=16 aria-hidden=true
                  color=(d.problem == "" ? "ink.strong" : "ink.faint")
                column flex=1 min-width=0 gap=2
                  text d.name font-size="1.0625rem" color=(d.problem == "" ? "ink.strong" : "ink.muted")
                  if d.problem != ""
                    text d.problem font-size="0.875rem" color="ink.muted" font-style="italic"
                text (computer.kind == "own" and computer.device == d.id ? "In use" : d.problem == "" ? "Use" : "")
                  class=Label color=(computer.kind == "own" and computer.device == d.id ? "ink.strong" : "AccentColor")
            if computer.devices.length == 0 and computer.tailnetError == ""
              text "No Linux computers on your tailnet yet." font-style="italic" color="ink.muted" padding="12px 0"
                border-bottom="1px solid line.subtle"
          if usable > 0
            button press=toggleSetup aria-expanded=settingUp testId="computer-add" align-self="flex-start" padding="6px 0"
              border="none" background-color="transparent" color="ink.muted"
              :hover
                color="ink.strong"
              text (settingUp ? "Hide setup" : "Add a computer") class=Label color="inherit"
          if usable == 0 or settingUp
            column gap=10 padding-top=10
              text "Give this prompt to a coding agent on the computer." font-size="0.9375rem" color="ink.muted"
              SetupPrompt(prompt=computer.setupPrompt, copy=copyPrompt)
        column gap=10 padding-top=26 testId="computer-container-section"
          row align-items="center" gap=10
            text "This machine" font-family="family.display" font-size="1.25rem" role="heading" aria-level=3 flex=1
            text "Free" class=Label
          text "No E2B account and no spare computer? Your imp can work in a container on the machine Imp runs on, through Docker, OrbStack or Podman. It costs nothing, but it shares this machine's kernel, so it is walled off less well than the two above. Its first start takes a few minutes."
            font-size="0.9375rem" color="ink.muted" line-height=1.45
          if computer.kind == "container"
            text "In use" class=Label color="ink.strong" testId="computer-container-in-use"
          else if computer.containerAvailable
            button press=useContainer disabled=switching testId="computer-container" align-self="flex-start"
              display="flex" align-items="center" gap=8 padding="9px 14px" border="1px solid line.strong"
              background-color="transparent" color="ink.strong" font-family="family.mono" font-size="0.75rem"
              letter-spacing="0.1em" text-transform="uppercase"
              :hover
                background-color="surface.soft"
              :disabled
                color="ink.faint"
              text "Use this machine"
          else
            row gap=10 align-items="flex-start"
              text computer.containerProblem font-size="0.9375rem" font-style="italic" color="ink.muted" flex=1
                testId="computer-container-problem"
              button press=refresh disabled=refreshing testId="computer-container-again" padding="6px 0" border="none"
                background-color="transparent" color="ink.muted"
                :hover
                  color="ink.strong"
                text "Look again" class=Label color="inherit"

// Text to copy into a terminal or a file, set in mono, with Copy.
// A prompt for the person's coding agent: the setup to do, which the agent reads and the person only copies. It
// stays folded, so the person sees a prompt to hand over, not the commands and configuration inside it.
component SetupPrompt
  props
    prompt: string
    copy: action
  state open = false
  action toggle
    open = not open
  view
    column border="1px solid line.strong" testId="computer-setup-prompt"
      row align-items="center"
        button press=toggle aria-expanded=open testId="computer-setup-prompt-toggle" flex=1 display="flex"
          align-items="center" gap=8 padding="10px 12px" border="none" background-color="transparent" color="ink.muted"
          text-align="start"
          :hover
            color="ink.strong"
          text (open ? "−" : "+") font-family="family.mono" width="0.75rem" aria-hidden=true
          text "Setup prompt" class=Label color="inherit"
        button press=copy testId="computer-setup-prompt-copy" display="flex" align-items="center" gap=6
          padding="10px 12px" border="none" background-color="transparent" color="ink.strong" font-family="family.mono"
          font-size="0.6875rem" letter-spacing="0.1em" text-transform="uppercase"
          :hover
            background-color="surface.soft"
          image "symbol:copy" width=12 height=12 aria-hidden=true
          text "Copy"
      if open
        text prompt font-family="family.mono" font-size="0.75rem" line-height=1.55 white-space="pre-wrap"
          overflow-wrap="anywhere" padding="12px 14px" border-top="1px solid line.subtle" background-color="surface.soft"
          max-height="18rem" overflow-y="auto" testId="computer-setup-prompt-text"

// A wizard screen's question, and one short line under it.
component WizardTitle
  props
    title: string
    note: string
  view
    column gap=4
      text title font-family="family.display" font-size="1.75rem" line-height=1.15 role="heading" aria-level=2
      text note color="ink.muted" font-size="0.9375rem"

// A wizard's full-width button: the step's answer when `primary`, another way when not.
component WizardButton
  props
    label: string
    press: action
    testId: string
    primary: bool
    disabled: bool
  view
    button press=press disabled=disabled testId=testId display="flex" align-items="center"
      justify-content="space-between" gap=10 padding="14px 18px" font-family="family.mono" font-size="0.8125rem"
      font-weight=500 letter-spacing="0.1em" text-transform="uppercase"
      border=(primary ? "1px solid AccentColor" : "1px solid line.strong")
      background-color=(primary ? "AccentColor" : "transparent") color=(primary ? "ink.on-fill" : "ink.strong")
      :hover
        opacity=0.9
      :disabled
        background-color="surface.soft"
        border-color="line.subtle"
        color="ink.faint"
      text label
      text "→" aria-hidden=true

// A wizard's button that opens what it holds beneath it, in place, rather than on a screen of its own.
component WizardFold
  props
    label: string
    press: action
    testId: string
    primary: bool
    open: bool
    disabled: bool
  slot
  view
    column
      button press=press disabled=disabled aria-expanded=open testId=testId display="flex" align-items="center"
        justify-content="space-between" gap=10 padding="14px 18px" font-family="family.mono" font-size="0.8125rem"
        font-weight=500 letter-spacing="0.1em" text-transform="uppercase"
        border=(primary ? "1px solid AccentColor" : "1px solid line.strong")
        background-color=(primary ? "AccentColor" : "transparent") color=(primary ? "ink.on-fill" : "ink.strong")
        :hover
          opacity=0.9
        :disabled
          color="ink.faint"
        text label
        text (open ? "↓" : "→") aria-hidden=true
      if open
        column gap=14 padding="16px 18px" border="1px solid line.strong" border-top="none"
          children

// A computer of the person's that the onboarding found ready, and the one press that makes it the imp's.
component FoundComputer
  props
    name: string
    press: action
    disabled: bool
    testId: string
  view
    button press=press disabled=disabled testId=testId display="flex" align-items="center" gap=12
      padding="10px 10px 10px 14px" border="none" background-color="surface.soft" color="ink.strong"
      text-align="start"
      :hover
        background-color="line.subtle"
      :disabled
        color="ink.faint"
      row width=8 height=8 min-width=8 background-color="-exact-system-green" aria-hidden=true
      text name flex=1 min-width=0 font-family="family.display" font-size="1.25rem" line-height=1.15
        overflow-wrap="anywhere"
      text "Use →" class=Label padding="7px 12px" background-color="AccentColor" color="ink.on-fill"

// Onboarding's second step: which computer, then only what that one needs. Settings has the full picture.
component ComputerWizard
  props
    computer: Computer
    switching: bool
    error: string
    useContainer: action
    setCloudKey: action
    useOwn: action
    copyPrompt: action
    choice: string
    toggle: action
    still: bool
  state keyDraft = ""
  derive usable = computer.devices.filter(d => d.problem == "")
  action editKey(v: string)
    keyDraft = v
  view
    column gap=14 testId="onboarding-computer" animation=(still ? "none" : "rise 260ms ease-out both")
      WizardTitle(title="Give it a computer", note="Where your imp works.")
      WizardFold(label="Imp cloud", press=toggle("cloud"), testId="choose-cloud", primary=(choice == ""),
        open=(choice == "cloud"), disabled=false)
        text "Paste a key from e2b.dev/dashboard." font-size="0.9375rem" color="ink.muted"
        row align-items="center" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
          input type="password" value=keyDraft input=editKey submit=setCloudKey(keyDraft.trim()) placeholder="e2b_…"
            aria-label="E2B API key" testId="computer-cloud-key" flex=1 min-width=0 padding="8px 0" border="none"
            background-color="transparent" outline="none" font-family="family.mono" font-size="0.875rem" color="ink.strong"
          button press=setCloudKey(keyDraft.trim()) disabled=(keyDraft.trim() == "" or switching)
            testId="computer-cloud-key-save" padding="9px 14px" border="none" background-color="AccentColor"
            color="ink.on-fill" font-family="family.mono" font-size="0.75rem" letter-spacing="0.1em"
            text-transform="uppercase"
            :disabled
              background-color="surface.soft"
              color="ink.faint"
            text "Use"
      WizardFold(label="Your computer", press=toggle("own"), testId="choose-own", primary=false, open=(choice == "own"),
        disabled=false)
        if computer.tailnetError != ""
          text computer.tailnetError font-size="0.9375rem" color="-exact-system-red" testId="computer-tailnet-error"
        else if usable.length == 0
          text "Give this prompt to a coding agent on a Linux computer." font-size="0.9375rem" color="ink.muted"
          SetupPrompt(prompt=computer.setupPrompt, copy=copyPrompt)
          Watching()
        else
          text (usable.length == 1 ? "Found it" : `Found ${usable.length}`) class=Label color="ink.strong"
            testId="computer-found"
          for d in usable key=d.id
            FoundComputer(name=d.name, press=useOwn(d.id), disabled=switching, testId=`computer-device-${d.name}`)
      // No computer is not a choice: skipping gives the imp a container on the host's machine, which needs nothing.
      if computer.containerAvailable
        button press=useContainer disabled=switching testId="computer-skip" align-self="flex-start" padding="4px 0"
          border="none" background-color="transparent" color="ink.muted"
          :hover
            color="ink.strong"
          text "Skip, use a container here" class=Label color="inherit"
      else
        button press=toggle("container") aria-expanded=(choice == "container") testId="computer-skip"
          align-self="flex-start" padding="4px 0" border="none" background-color="transparent" color="ink.muted"
          :hover
            color="ink.strong"
          text "Skip, use a container here" class=Label color="inherit"
        if choice == "container"
          text computer.containerProblem font-size="0.9375rem" color="ink.muted" testId="computer-container-problem"
          Watching()
      if switching
        row gap=10 align-items="center"
          progress aria-label="Setting it up"
          text "Setting it up…" font-style="italic" color="ink.muted"
      else if error != ""
        text error color="-exact-system-red" font-size="0.9375rem" testId="computer-switch-error"

// That the onboarding is looking for something to appear by itself, so the person need not press anything.
component Watching
  view
    row gap=10 align-items="center" testId="computer-watching"
      progress aria-label="Waiting"
      text "Waiting…" font-style="italic" color="ink.muted"

// One field of the onboarding's API key form, labelled above its input.
component KeyField
  props
    label: string
    value: string
    edit: action
    secret: bool
    placeholder: string
    testId: string
  view
    column gap=4
      text label class=Label
      input type=(secret ? "password" : "text") value=value input=edit placeholder=placeholder aria-label=label
        testId=testId padding="9px 12px" border="1px solid line.strong" background-color="transparent" outline="none"
        font-family="family.mono" font-size="0.875rem" color="ink.strong" autocapitalize="none" autocorrect="off"
        spellcheck=false

// A numbered step of the onboarding.
component Step
  props
    number: string
    title: string
  view
    row gap=12 align-items="baseline"
      text number class=Label
      text title font-family="family.display" font-size="1.25rem"

// The conversation's rows. The chat tab shows it full width; the panel beside an app shows it `compact`.
component Transcript
  props
    prefix: string
    compact: bool
    messages: ChatMessage[]
    lastId: string
    still: bool
  view
    // Its top edge fades, so a row scrolling under the page's title leaves it gently instead of cut in half.
    list id=`${prefix}transcript` appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1
      min-height=0 mask-image="linear-gradient(to bottom, transparent 0px, black 20px)" testId=`${prefix}transcript`
      for m in messages key=m.id
        row justify-content="center" padding=(compact ? "0 18px" : "0 20px")
          column width="100%" max-width="46rem"
            animation=(still or m.id != lastId ? "none" : "rise 220ms ease-out both")
            if m.role == "user"
              row justify-content="flex-end" padding=(compact ? "16px 0 6px" : "20px 0 8px")
                text m.text padding="10px 14px" max-width="85%" overflow-wrap="break-word"
                  white-space="pre-wrap" background-color="surface.soft" font-size=(compact ? "0.9375rem" : "1rem") line-height=1.5
                  testId=`${prefix}message-${m.id}`
            else if m.role == "activity"
              column gap=2 padding="5px 0" testId=`${prefix}message-${m.id}`
                row gap=10 align-items="center" color=(m.failed ? "-exact-system-red" : "ink.muted")
                  image m.icon width=13 height=13 aria-hidden=true
                  text m.title class=Label color=(m.failed ? "-exact-system-red" : "ink.strong") white-space="nowrap"
                  if m.detail != ""
                    text m.detail font-family="family.mono" font-size="0.75rem" color="ink.muted" flex=1 min-width=0
                      white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                // A step that failed says why under its title.
                if m.failed and m.text != ""
                  text m.text font-size="0.8125rem" color="ink.muted" line-height=1.4 padding-left=23 line-clamp=2
                    overflow-wrap="anywhere" testId=`${prefix}message-why-${m.id}`
            else if m.role == "thinking"
              row gap=6 align-items="center" padding="14px 0" aria-label="Your imp is working"
                testId=`${prefix}thinking`
                row width=6 height=6 background-color="ink.faint" aria-hidden=true
                  animation=(still ? "none" : "pulse 1.1s ease-in-out 0ms infinite")
                row width=6 height=6 background-color="ink.faint" aria-hidden=true
                  animation=(still ? "none" : "pulse 1.1s ease-in-out 160ms infinite")
                row width=6 height=6 background-color="ink.faint" aria-hidden=true
                  animation=(still ? "none" : "pulse 1.1s ease-in-out 320ms infinite")
            else if m.role == "error"
              row gap=10 align-items="flex-start" padding="10px 14px" margin="8px 0"
                background-color="danger.soft" border-left="2px solid -exact-system-red" testId=`${prefix}message-${m.id}`
                image "symbol:alert" color="-exact-system-red" width=16 height=16 aria-hidden=true
                text m.text font-size="0.9375rem" flex=1 min-width=0 overflow-wrap="break-word"
            else
              text m.text markup="markdown" padding="10px 0 14px" font-size=(compact ? "1rem" : "1.0625rem") line-height=1.6
                overflow-wrap="break-word" testId=`${prefix}message-${m.id}`

// The square field the person writes in, with Send (or Stop while the assistant works and the field is empty), and
// a microphone that dictates into it where the browser can. While it listens, the words it has not settled on show
// above the field.
component Composer
  props
    prefix: string
    placeholder: string
    compact: bool
    draft: string
    busy: bool
    sending: bool
    stopping: bool
    error: string
    edit: action
    post: action
    stop: action
    canDictate: bool
    dictating: bool
    heard: string
    dictate: action
    keys: bool
  derive said = withSpoken(draft, heard).trim()
  // Enter sends, as a chat's composer does; Shift+Enter breaks the line, and the Enter that picks an input method's
  // candidate stays the input method's.
  action compose(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey and not e.isComposing
      preventDefault()
      if said != "" and not sending
        post(prefix)
  view
    row justify-content="center" padding=(compact ? "10px 14px 14px" : "10px 16px 14px")
      column width="100%" max-width="46rem" gap=8
        if error != ""
          text error color="-exact-system-red" font-size="0.8125rem" testId=`${prefix}send-error`
        if dictating
          row gap=8 align-items="baseline" testId=`${prefix}dictation`
            row width=6 height=6 min-width=6 background-color="-exact-system-red" aria-hidden=true
            text (heard == "" ? "Listening…" : heard) font-style="italic" color="ink.muted" flex=1 min-width=0
              font-size=(compact ? "0.9375rem" : "1rem") overflow-wrap="break-word" testId=`${prefix}dictation-heard`
        row align-items="flex-end" gap=8 padding="5px 5px 5px 14px" border="1px solid line.strong"
          background-color="surface.page" position="relative"
          if keys
            KeyBadge(chord="Meta+L", at="start")
          textarea id=`${prefix}composer` value=draft input=edit key=compose rows=1 field-sizing="content" max-height=180
            placeholder=placeholder aria-label="Message" testId=`${prefix}composer` flex=1 min-width=0
            padding="9px 0" border="none" background-color="transparent" outline="none" resize="none"
            font-family="family.text" font-size=(compact ? "1rem" : "1.0625rem") line-height=1.5 color="ink.strong"
          if canDictate or dictating
            button press=dictate retainFocus=true aria-pressed=dictating
              aria-label=(dictating ? "Stop dictating" : "Dictate") testId=`${prefix}dictate` width=38 height=38
              min-width=38 padding=0 border="none" display="flex" align-items="center" justify-content="center"
              background-color=(dictating ? "danger.soft" : "transparent")
              color=(dictating ? "-exact-system-red" : "ink.muted") transition="background-color 120ms ease, color 120ms ease"
              image "symbol:microphone" width=16 height=16
          if busy and said == ""
            button press=stop disabled=stopping aria-label="Stop" aria-keyshortcuts="Meta+." testId=`${prefix}stop`
              width=38 height=38 min-width=38 padding=0 border="none" background-color="ink.strong"
              color="surface.page" display="flex" align-items="center" justify-content="center" position="relative"
              image "symbol:stop-fill" width=13 height=13
              if keys
                KeyBadge(chord="Meta+.", at="end")
          else
            button press=post(prefix) disabled=(said == "" or sending) retainFocus=true aria-label="Send"
              testId=`${prefix}send` width=38 height=38 min-width=38 padding=0 border="none"
              background-color="AccentColor" color="ink.on-fill" display="flex" align-items="center"
              justify-content="center" transition="background-color 120ms ease"
              :disabled
                background-color="surface.soft"
                color="ink.faint"
              image "symbol:send" width=16 height=16
        if not compact
          text "Asks before anything it can't undo" class=Label color="ink.faint" text-align="center"
            font-size="0.625rem"
