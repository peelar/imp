// Small parts more than one screen of the shell uses: a shortcut's keys on its control, a person's initial, a
// number in words, the question asked before what can't be undone, and the layout every Settings tab shares.

use Key, Label, Body, Title, Display, Initial from "./look.contract"
use ErrorNote from "./controls.contract"

// A chord as the Mac writes it: "Control+Meta+S" is ⌃⌘S.
fn keysOf(chord: string): string =
  chord.replaceAll("Control+", "⌃").replaceAll("Alt+", "⌥").replaceAll("Shift+", "⇧").replaceAll("Meta+", "⌘")

// A shortcut's keys on its control (which is position="relative"), shown while ⌘ is held: over its top corner at the
// "end" or the "start", or for a "tab" along a narrow window's bottom edge, inside it beside the symbol at its centre.
component KeyBadge
  props
    chord: string
    at: string
  view
    text keysOf(chord) class=Key position="absolute" top=(at == "tab" ? "6px" : "-8px")
      left=(at == "tab" ? "calc(50% + 16px)" : at == "start" ? "-8px" : "auto") right=(at == "end" ? "-8px" : "auto")
      z-index=2 pointer-events="none" aria-hidden=true testId=`keys-${chord}`

component Initialled
  props
    word: string
    size: string
    heading: number
  view
    text role="heading" aria-level=heading class=Display font-size=size
      // The script capital's swash leans into the next letter: a little room keeps the word readable.
      text word.slice(0, 1) class=Initial margin-right="0.08em"
      text word.slice(1)

fn numbered(n: number): string = n < 10 ? `0${n}` : `${n}`

// Asks before what can't be undone, in the catalogue's look rather than the platform's alert: square, ruled, the
// question in the display serif and the answers as mono labels. A button opens it with `commandfor=id
// command="show-modal"`; Cancel and Escape close it, and `label` does `confirm` and closes it.
component Confirm
  props
    id: string
    question: string
    message: string
    label: string
    confirm: action
    testId: string
  view
    dialog id=id aria-label=question width="min(26rem, calc(100vw - 32px))" box-sizing="border-box"
      padding=0 border="1px solid ink.strong" border-radius=0 background-color="surface.page" color="ink.strong"
      box-shadow="none"
      column gap="space.sm" padding="space.lg space.lg 0"
        text question class=Title role="heading" aria-level=2
        text message class=Body color="ink.muted"
      row justify-content="flex-end" gap="space.sm" padding="space.md space.lg space.lg"
        button commandfor=id command="close" testId=`${testId}-cancel` padding="space.sm space.ms" border="1px solid line.strong"
          cursor="pointer"
          border-radius=0 background-color="transparent" color="ink.strong"
          :hover
            background-color="surface.soft"
          text "Cancel" class=Label color="inherit"
        button press=confirm commandfor=id command="close" destructive=true testId=`${testId}-confirm` padding="space.sm space.ms"
          cursor="pointer"
          border="1px solid ink.danger" border-radius=0 background-color="ink.danger" color="ink.on-fill"
          :hover
            opacity=0.9
          text label class=Label color="inherit"

// A new release of the Mac app is ready: it waits for the person to restart, never quits Imp.
component RestartButton
  props
    version: string
    busy: bool
    wide: bool
    press: action
    testId: string
  view
    button press=press disabled=busy testId=testId
      cursor=(busy ? "default" : "pointer")
      aria-label=`Restart Imp to update to ${version}` display="flex" align-items="center" gap="space.sm"
      padding="space.sm space.ms" border="none" background-color="AccentColor" color="ink.on-fill"
      class=Label
      white-space="nowrap"
      :disabled
        background-color="surface.soft"
        color="ink.faint"
      image "symbol:icon.refresh" width=12 height=12 aria-hidden=true
      text (wide ? `Restart for ${version}` : "Update")

// Settings' layout, which every tab shares: a line that says what the tab is for, then its sections. A section has its
// name in small capitals over a black rule, a note under it when the section needs one, its rows, each ruled off below
// with its actions at its end, or one line saying it is empty, and below them what adds to it (SettingsFoot).
component SettingsPage
  props
    intro: string
    testId: string
  slot
  view
    column gap="space.xl" testId=testId
      text intro class=Body color="ink.muted"
      children

component SettingsSection
  props
    title: string
    // Beside the name, such as a count or a state; "" for none.
    aside: string
    asideTestId: string
    // What the section is for, when its name doesn't say; "" for none.
    note: string
    testId: string
  slot
  view
    column testId=testId
      row align-items="baseline" gap="space.ms" padding-bottom="space.sm" border-bottom="1px solid ink.strong"
        text title class=Label color="ink.strong" role="heading" aria-level=2 flex=1
        if aside != ""
          text aside class=Label testId=asideTestId
      if note != ""
        text note class=Body color="ink.muted" padding="space.ms 0" border-bottom="1px solid line.subtle"
      children

// One thing in a section: its name in Lead, what it is in Small or Mono under it, and its actions at its end.
component SettingsRow
  props
    testId: string
  slot
  view
    row align-items="center" gap="space.ms" padding="space.ms 0" border-bottom="1px solid line.subtle" testId=testId
      children

// A section with no rows yet, or still loading them.
component SettingsEmpty
  props
    message: string
    testId: string
  view
    text message class=Body color="ink.muted" padding="space.ms 0" border-bottom="1px solid line.subtle" testId=testId

// What adds to a section or changes it, below its rows: a row of buttons, or a form.
component SettingsFoot
  props
    testId: string
  slot
  view
    column gap="space.sm" padding-top="space.ms" testId=testId
      children

// Why a section's last action failed, under its rows; nothing when it didn't.
component SettingsError
  props
    message: string
    testId: string
  view
    if message != ""
      column padding-top="space.ms"
        ErrorNote(message=message, testId=testId)
