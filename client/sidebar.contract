// The sidebar: its places (Chat, the apps, the computer, Routines, Tricks, App directory), New chat and the
// conversations.

use Label, Key, Body, Mono from "./look.contract"
use ChatSummary, Routine from "./host.contract"

// A place in the sidebar the chat tab opens: its symbol, its name, a mark in `mark`'s colour ("" for none) and how
// many it holds, when any.
component PlaceEntry
  props
    id: string
    label: string
    symbol: string
    count: number
    mark: string
    selected: bool
    press: action
  view
    button press=press aria-pressed=selected testId=`${id}-entry` appearance="none" display="flex" align-items="center"
      gap="space.sm" padding="space.sm space.sm" border="none" text-align="start" color="ink.strong"
      background-color=(selected ? "surface.soft" : "transparent")
      :hover
        background-color="surface.soft"
      image symbol width=15 height=15 aria-hidden=true
      text label class=Body flex=1
      if mark != ""
        row width=7 height=7 min-width=7 background-color=mark aria-hidden=true testId=`${id}-mark`
      if count > 0
        text `${count}` class=Label testId=`${id}-count`

// One conversation in the sidebar, by its first message. Pointing at it shows its one action, Archive under Recent and
// Restore under Archived, over the end of its title, so the title does not move; a touch screen, where nothing is
// pointed at, always shows it.
component ChatEntry
  props
    prefix: string
    index: number
    id: string
    title: string
    selected: bool
    touch: bool
    show: action
    // "Archive" or "Restore", and what it does.
    verb: string
    act: action
  state hovered = false
  action hover(on: bool)
    hovered = on
  view
    row hover=hover position="relative" align-items="center" min-width=0 testId=`${prefix}conversation-row-${index}`
      background-color=(selected or hovered ? "surface.soft" : "transparent")
      button press=show(id) aria-pressed=selected testId=`${prefix}conversation-${index}` appearance="none" display="flex"
        flex=1 padding="space.sm space.sm" border="none" text-align="start" color="ink.strong" min-width=0
        background-color="transparent"
        text title class=Body flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      if hovered or touch
        button press=act(id) aria-label=`${verb} ${title}` title=verb testId=`${prefix}conversation-${verb.toLowerCase()}-${index}`
          appearance="none" position="absolute" top=0 bottom=0 right=0 display="flex" align-items="center"
          justify-content="center" padding="0 space.sm" border="none" background-color="surface.soft" color="ink.muted"
          :hover
            color="ink.strong"
          image (verb == "Archive" ? "symbol:icon.archive" : "symbol:icon.restore") width=14 height=14 aria-hidden=true

// The left sidebar: a new chat, the imp's pages (home, routines, tricks, the app directory), then the
// three latest conversations and, folded under them, the rest, and pinned at its foot the archived ones, folded too.
component Sidebar
  props
    prefix: string
    conversations: ChatSummary[]
    current: string
    // The open tab, and whether it is the home page.
    tab: string
    atHome: bool
    home: action
    tricks: number
    routines: Routine[]
    olderOpen: bool
    newChat: action
    show: action
    archive: action
    // The chats the person archived, folded under Archived below the rest, and what brings one back.
    archived: ChatSummary[]
    archivedOpen: bool
    toggleArchived: action
    restore: action
    // A touch screen, where Archive cannot wait to be pointed at.
    touch: bool
    openRoutines: action
    openTricks: action
    openDirectory: action
    toggleOlder: action
    keyboard: bool
    // Whether the app directory's feature flag is on.
    directory: bool
  // A routine at work shows cobalt on the Routines entry, else one with a run the person has not read shows ink.
  derive routineMark = routines.filter(r => r.running).length > 0 ? "AccentColor" : routines.filter(r => r.unread).length > 0 ? "ink.strong" : ""
  view
    column flex=1 min-height=0 testId=`${prefix}sidebar`
      column gap="space.xxs" padding="space.ms space.sm" border-bottom="1px solid line.subtle"
        // New chat is the first of the places, in their look. Beside the chat on a wide window ⌘N is this button's; on
        // a narrow one, the page header's (under the drawer).
        button press=newChat aria-keyshortcuts=(prefix == "" ? "Meta+N" : "") testId=`${prefix}chat-new`
          appearance="none" display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm" border="none"
          background-color="transparent" color="ink.strong" text-align="start"
          :hover
            background-color="surface.soft"
          image "symbol:icon.compose" width=15 height=15 aria-hidden=true
          text "New chat" class=Body flex=1
          if keyboard
            text "⌘N" class=Key testId=`${prefix}chat-new-keys` aria-hidden=true
        PlaceEntry(id=`${prefix}home`, label="Home", symbol="symbol:icon.home", count=0, mark="", selected=atHome,
          press=home)
        PlaceEntry(id=`${prefix}routines`, label="Routines", symbol="symbol:icon.repeat", count=routines.length,
          mark=routineMark, selected=(tab == "routines"), press=openRoutines)
        PlaceEntry(id=`${prefix}tricks`, label="Tricks", symbol="symbol:icon.sparkles", count=tricks, mark="",
          selected=(tab == "tricks"), press=openTricks)
        if directory
          PlaceEntry(id=`${prefix}directory`, label="App directory", symbol="symbol:icon.layers", count=0, mark="",
            selected=(tab == "directory"), press=openDirectory)
      scroll flex=1 min-height=0
        if conversations.length > 0
          column gap="space.xxs" padding="space.ms space.sm space.md"
            text "Recent" class=Label padding="0 space.sm space.xs"
            for c, i in conversations.slice(0, 3) key=c.id
              ChatEntry(prefix=prefix, index=i, id=c.id, title=c.title, selected=(tab == "chat" and c.id == current), touch=touch, show=show, verb="Archive", act=archive)
            if conversations.length > 3
              button press=toggleOlder aria-expanded=olderOpen testId=`${prefix}conversations-older` appearance="none"
                display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm" margin-top="space.xs" border="none"
                background-color="transparent" color="ink.muted" text-align="start"
                :hover
                  color="ink.strong"
                text (olderOpen ? "−" : "+") class=Mono width=12 aria-hidden=true
                text (olderOpen ? "Hide older" : `Older (${conversations.length - 3})`) class=Label color="inherit"
              if olderOpen
                for c, i in conversations.slice(3) key=c.id
                  ChatEntry(prefix=prefix, index=(i + 3), id=c.id, title=c.title, selected=(tab == "chat" and c.id == current), touch=touch, show=show, verb="Archive", act=archive)
      // Archived chats, pinned to the bottom edge of the conversations and folded until opened: a chat
      // opened here can be read and written in, and Restore puts it back under Recent. Open, the list scrolls on its own
      // past a third of the window, so Recent keeps its room.
      if archived.length > 0
        column padding="space.xs space.sm space.sm" testId=`${prefix}archived`
          button press=toggleArchived aria-expanded=archivedOpen testId=`${prefix}conversations-archived`
            appearance="none" display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm" border="none"
            background-color="transparent" color="ink.muted" text-align="start"
            :hover
              color="ink.strong"
            text (archivedOpen ? "−" : "+") class=Mono width=12 aria-hidden=true
            text `Archived (${archived.length})` class=Label color="inherit"
          if archivedOpen
            scroll max-height="33vh"
              column gap="space.xxs" padding-bottom="space.xs"
                for c, i in archived key=c.id
                  ChatEntry(prefix=`${prefix}archived-`, index=i, id=c.id, title=c.title,
                    selected=(tab == "chat" and c.id == current), touch=touch, show=show, verb="Restore", act=restore)
