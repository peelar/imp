test "the app directory installs an app from a GitHub link through the imp, and opens one already installed"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  request POST "/api/call/todosAdd" ["Pack camera"]
  clock until state account.status == "signedIn" within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  tap "directory-entry"
  clock settle
  expect state nav.tab == "directory"
  expect tree has "directory"
  expect text "directory-name-habits" == "Habits"
  expect tree has "directory-install-habits"
  expect tree missing "directory-install-todos"
  type "directory-link" "github.com/someone"
  expect tree has "directory-link-error"
  type "directory-link" "github.com/someone/weather"
  expect tree missing "directory-link-error"
  tap "directory-link-install"
  clock settle
  expect state nav.tab == "chat"
  clock until state chat.messages.0.text == "Install the app from github.com/someone/weather so I can try it." within 5000
  clock until state chat.busy == false within 10000
  tap "directory-entry"
  expect text "directory-link" == ""
  tap "directory-open-todos"
  expect tree has "chat-panel"
  expect text "todo-1" == "Pack camera"

test "a routine the imp saves is listed in the Routines pane, runs now in its own conversation, pauses and is deleted"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  tap "routines-entry"
  expect state nav.tab == "routines"
  expect tree has "routines-empty"
  expect tree has "chat-panel"
  tap "routine-new"
  expect tree has "routines"
  expect text "side-composer" == "Every weekday at 8, "
  type "side-composer" "Please save routine: Weather | 0 8 * * 1-5 | Check the weather"
  tap "side-send"
  clock until state routines.length == 1 within 10000
  clock until state chat.busy == false within 10000
  expect text "routines-count" == "1"
  tap "routines-entry"
  expect text "routine-name-0" == "Weather"
  tap "routine-0"
  clock until state chat.routine == "Weather" within 5000
  expect tree has "routine-bar"
  expect text "routine-instruction" == "Check the weather"
  expect text "routine-last" == "Not run yet"
  tap "routine-run"
  clock until state chat.messages.1.text == "Hello from the test model." within 10000
  expect state chat.messages.0.text == "Check the weather"
  clock until state routines.0.running == false within 5000
  expect tree missing "routine-unread-0"
  tap "routine-pause"
  clock until state routines.0.paused == true within 5000
  expect text "routine-status" == "Paused"
  tap "routine-pause"
  clock until state routines.0.paused == false within 5000
  tap "routine-delete"
  tap "routine-delete-confirm"
  clock until state routines.length == 0 within 5000
  clock until state chat.routine == "" within 5000
  expect tree missing "routine-bar"
  tap "routines-entry"
  expect tree has "routines-empty"

test "the composer's microphone dictates until it is pressed again"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  tap "dictate"
  clock +100
  expect text "dictation-heard" == "Listening…"
  tap "dictate"
  clock +100
  expect tree missing "dictation"

test "a todo is renamed in place, and deleted"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  type "todo-draft" "Water plnts"
  tap "todo-add"
  clock until state todosReadList.0.title == "Water plnts" within 5000
  tap "todo-edit-1"
  type "todo-rename-1" "Water the plants"
  type "todo-rename-1" key "Escape"
  expect tree missing "todo-rename-1"
  expect text "todo-1" == "Water plnts"
  tap "todo-edit-1"
  type "todo-rename-1" "Water the plants"
  type "todo-rename-1" key "Enter"
  clock until state todosReadList.0.title == "Water the plants" within 5000
  expect text "todo-1" == "Water the plants"
  tap "todo-delete-1"
  clock until state todosReadList.length == 0 within 5000
  expect tree missing "todo-1"

test "Enter sends a message, Shift+Enter breaks its line, and one the host never got comes back to the box"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "First line"
  type "composer" key "Shift+Enter"
  expect state chat.messages.length == 0
  type "composer" key "Enter"
  clock until state chat.messages.0.text == "First line" within 5000
  expect text "composer" == ""
  clock until state chat.busy == false within 10000
  fail fetch "http://127.0.0.1:8787/api/call/chatSend" times 1
  type "composer" "Are you there?"
  type "composer" key "Enter"
  clock until state draft == "Are you there?" within 5000
  expect tree has "send-error"
  tap "send"
  clock until state chat.messages.2.text == "Are you there?" within 5000
  expect tree missing "send-error"

// The hints themselves show only outside a browser (the Mac app), which Chrome cannot emulate.
test "⌘ chords open the apps, Settings, a new chat and the message box, and a browser tab hints at none of them"
  size 1280x800
  prefer pointer fine
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "chat-new"
  type "composer" key "Meta+,"
  expect state nav.tab == "settings"
  type "app" key "Meta+2"
  expect state nav.tab == "todos"
  expect tree has "chat-new"
  type "app" key "Meta+n"
  clock until state chat.messages.length == 0 within 5000
  expect state nav.tab == "chat"
  type "app" key "Meta+,"
  expect state nav.tab == "settings"
  type "app" key "Meta+l"
  expect state nav.tab == "settings"
  expect tree has "chat-panel"
  expect tree missing "chat-new-keys"
  type "app" key "Meta" down
  clock +500
  expect tree missing "keys-Meta+1"
  type "app" key "Meta" up

// The GitHub app Imp ships: with no github key it has nothing yet, and says how it gets its data.
test "the GitHub app opens to an empty inbox that says it has not synced yet"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-github"
  clock until state githubReadInbox.synced == false within 5000
  expect text "github-heading" == "Nothing needs you"
  expect tree has "github-empty"
  expect tree has "github-filter-review"

test "an app is uninstalled with its data only once the person confirms it"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  request POST "/api/call/todosAdd" ["Pack camera"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  clock until state todosReadList.length == 1 within 5000
  tap "app-manage"
  tap "uninstall"
  tap "uninstall-cancel"
  clock settle
  expect state apps.length == 2
  tap "uninstall"
  tap "uninstall-confirm"
  clock until state apps.length == 1 within 5000
  clock settle
  expect state nav.tab == "chat"
  expect state uninstallError == ""

// scripts/test-host.ts serves an OpenAI-compatible API on port 8799.
test "onboarding takes an OpenAI-compatible API key in place of ChatGPT, and the imp answers on it"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-general"
  tap "signout"
  tap "signout-confirm"
  clock until state account.status == "signedOut" within 5000
  tap "key-open"
  type "key-base" "http://127.0.0.1:8799/v1"
  type "key-value" "wrong-key"
  type "key-model" "fake-model"
  tap "key-use"
  clock until state apiKeyError == "127.0.0.1:8799 refused this key." within 5000
  expect state account.status == "signedOut"
  type "key-value" ""
  type "key-value" "test-key"
  tap "key-use"
  clock until state account.status == "signedIn" within 5000
  expect state account.kind == "apiKey"
  expect state keyValue == ""
  tap "tab-settings"
  tap "chat-new"
  type "composer" "Hello"
  tap "send"
  clock until state chat.messages.1.text == "Hello from the API." within 10000
  tap "tab-settings"
  tap "settings-pane-general"
  expect text "account-model" == "fake-model"
  expect text "account-base" == "http://127.0.0.1:8799/v1"
  tap "home-logo"
  expect state nav.tab == "chat"
  clock until state chat.messages.length == 0 within 5000
  expect tree has "home"
