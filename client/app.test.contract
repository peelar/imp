// The tests share one host (scripts/test-host.ts), so they run in order: the first signs in, the rest are signed in.

test "onboarding signs in with ChatGPT through a device code"
  clock data
  expect tree has "onboarding"
  expect tree missing "composer"
  tap "signin"
  clock until state account.status == "waiting" within 5000
  expect text "signin-code" == "TEST-1234"
  clock until state account.status == "signedIn" within 5000
  expect tree missing "onboarding"
  expect tree has "composer"
  tap "tab-settings"
  expect text "account-email" == "tester@example.com"
  expect text "account-plan" == "Plus"

test "a todo added in the Todos app is listed and counted"
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  type "todo-draft" "Pack camera"
  tap "todo-add"
  clock until state todosReadList.0.title == "Pack camera" within 5000
  expect text "todo-1" == "Pack camera"
  expect text "todos-left" == "1 todo left"
  expect text "todo-draft" == ""

test "the assistant adds a todo that the open Todos app shows at once"
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please add todo: Book train to Kraków"
  tap "tab-todos"
  tap "tab-chat"
  tap "send"
  expect text "composer" == ""
  clock until state todosReadList.1.title == "Book train to Kraków" within 10000
  clock until state chat.busy == false within 10000
  expect tree missing "message-live"
  tap "tab-todos"
  expect text "todo-2" == "Book train to Kraków"

test "on a wide window the chat sits beside an open app, and what it is asked there lands in the app"
  size 1280x800
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  expect tree has "chat-panel"
  type "side-composer" "Add todo: Call the vet"
  tap "side-send"
  clock until state todosReadList.2.title == "Call the vet" within 10000
  clock until state chat.busy == false within 10000
  expect text "todo-3" == "Call the vet"
  clock until state chat.messages.3.text == "Add todo: Call the vet" within 1000
  expect state chat.messages.4.title == "Todos · Add"
  expect state chat.messages.4.detail == "Call the vet"
  tap "chat-hide"
  expect tree missing "chat-panel"
  tap "dock-toggle"
  expect tree has "chat-panel"
  tap "chat-expand"
  expect tree missing "chat-panel"
  expect tree has "composer"

test "settings show the computer the agent works on"
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  clock until state computer.status == "ready" within 10000
  expect text "computer-name" == "This computer (development)"
  expect text "computer-status" == "Ready"
  expect tree missing "computer-size-2c-4096m"
  expect tree missing "computer-command"
  expect tree has "computer-open-screen"

test "what the imp is asked to remember shows in Settings, reaches its prompt, and can be forgotten"
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  expect tree has "memory-empty"
  tap "tab-chat"
  type "composer" "Please remember: Lives in Kraków"
  tap "send"
  clock until state memory.entries.0.facts.0 == "Lives in Kraków" within 10000
  clock until state chat.busy == false within 10000
  type "composer" "What do you know about me?"
  tap "send"
  clock until state chat.messages.10.text == "I know: Lives in Kraków" within 10000
  tap "tab-settings"
  expect text "memory-title-0" == "You"
  expect text "memory-fact-0-0" == "Lives in Kraków"
  tap "memory-forget-0-0"
  clock until state memory.entries.0.facts.length == 0 within 5000
  expect tree missing "memory-fact-0-0"
  tap "memory-forget-0"
  clock until state memory.entries.length == 0 within 5000
  expect tree has "memory-empty"

test "after a chat the imp remembers what it learned on its own, without a tool call"
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  type "composer" "By the way, I live in Gdańsk now."
  tap "send"
  clock until state chat.busy == false within 10000
  clock until state memory.entries.0.facts.0 == "Lives in Gdańsk" within 10000
  tap "tab-settings"
  expect text "memory-fact-0-0" == "Lives in Gdańsk"

test "a key added in Settings reaches the imp's commands as a stand-in, never as its value"
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  clock until state secrets.status == "ready" within 120000
  expect tree has "secrets-empty"
  tap "secret-add-github"
  type "secret-value" "ghp_testvalue123"
  tap "secret-save"
  clock until state secrets.secrets.0.name == "github" within 20000
  expect text "secret-name-0" == "github"
  expect tree missing "secret-form"
  tap "secret-add-github"
  expect text "secret-value" == ""
  tap "secret-cancel"
  tap "tab-chat"
  type "composer" "Please run: printenv GITHUB_TOKEN"
  tap "send"
  clock until state chat.busy == false within 30000
  clock until state chat.messages.15.text == "I see imp-secret-github." within 10000

test "the imp asks for a key it lacks, and the owner adds it from the request"
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please ask for a key: linear"
  tap "send"
  clock until state secrets.requests.0.name == "linear" within 10000
  clock until state chat.busy == false within 10000
  tap "tab-settings"
  expect tree has "secret-request-0"
  tap "secret-request-add-0"
  expect tree has "secret-form"
  type "secret-value" "lin_api_test"
  tap "secret-save"
  clock until state secrets.requests.length == 0 within 20000
  expect tree missing "secret-request-0"
  clock until state secrets.secrets.length == 2 within 5000
  tap "secret-delete-0"
  clock until state secrets.secrets.length == 1 within 10000
  expect text "secret-name-0" == "linear"

test "the imp asks for a login, and the owner adds it with its one-time-code key"
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please ask for a login: github.com"
  tap "send"
  clock until state secrets.requests.0.name == "github-login" within 10000
  clock until state chat.busy == false within 10000
  tap "tab-settings"
  clock until state secrets.status == "ready" within 120000
  tap "secret-request-add-0"
  expect text "secret-site" == "github.com"
  type "secret-username" "adrian"
  type "secret-value" "hunter2"
  type "secret-otp" "not a key"
  tap "secret-save"
  clock until state loginSaved.ok == false within 20000
  expect tree has "secret-error"
  type "secret-otp" "otpauth://totp/GitHub:adrian?secret=JBSWY3DPEHPK3PXP&issuer=GitHub"
  tap "secret-save"
  clock until state secrets.requests.length == 0 within 20000
  clock until state secrets.secrets.0.name == "github-login" within 5000
  expect text "secret-detail-0" == "github.com · adrian · one-time codes"
  tap "secret-replace-0"
  expect text "secret-username" == "adrian"
  type "secret-username" "adrian-p"
  tap "secret-save"
  clock until state secrets.secrets.0.username == "adrian-p" within 20000
  expect text "secret-detail-0" == "github.com · adrian-p · one-time codes"

test "settings back the apps' code up to GitHub, connected with a device code"
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  clock until state backup.versions == 1 within 5000
  expect text "backup-versions" == "01 version"
  tap "backup-connect"
  clock until state backup.status == "waiting" within 5000
  expect text "backup-code" == "TEST-5678"
  clock until state backup.synced == true within 10000
  expect text "backup-repo" == "tester/imp-apps"
  expect text "backup-state" == "Up to date"
  tap "backup-disconnect"
  clock until state backup.status == "off" within 5000
  expect tree has "backup-connect"

test "the sidebar starts new chats, folds all but the latest three, and lists the imp's tricks"
  size 1280x800
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  expect tree has "sidebar"
  expect text "conversation-0" == "Please add todo: Book train to Kraków"
  expect text "tricks-count" == "2"
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  expect tree has "home"
  type "composer" "First new chat"
  tap "send"
  clock until state chat.conversations.length == 2 within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Second new chat"
  tap "send"
  clock until state chat.conversations.length == 3 within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Third new chat"
  tap "send"
  clock until state chat.conversations.length == 4 within 5000
  expect text "conversation-0" == "Third new chat"
  expect text "conversation-2" == "First new chat"
  expect tree missing "conversation-3"
  tap "conversations-older"
  expect text "conversation-3" == "Please add todo: Book train to Kraków"
  tap "conversation-3"
  clock until state chat.messages.0.text == "Please add todo: Book train to Kraków" within 5000
  tap "tricks-entry"
  expect tree has "tricks"
  expect text "trick-title-0" == "Search Hacker News"
  expect text "trick-title-1" == "Track a parcel"
  tap "trick-0"
  expect tree missing "tricks"
  expect text "composer" == "Search Hacker News: "

test "on a narrow window the conversations and tricks open as a drawer"
  size 390x844
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  expect tree missing "sidebar"
  tap "drawer-toggle"
  expect tree has "drawer-sidebar"
  tap "drawer-tricks-entry"
  expect tree missing "drawer"
  expect tree has "tricks"

test "the app directory installs an app from a GitHub link through the imp, and opens one already installed"
  size 1280x800
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  tap "directory-entry"
  expect tree has "directory"
  expect tree missing "composer"
  expect text "directory-name-habits" == "Habits"
  expect tree has "directory-install-habits"
  expect tree missing "directory-install-todos"
  type "directory-link" "github.com/someone"
  expect tree has "directory-link-error"
  type "directory-link" "github.com/someone/weather"
  expect tree missing "directory-link-error"
  tap "directory-link-install"
  expect tree missing "directory"
  clock until state chat.messages.0.text == "Install the app at https://github.com/someone/weather. Clone it on your computer, copy its app folder (app.json, app.contract and server.ts) to apps/<its id>/ in your workspace, and preview it." within 5000
  clock until state chat.busy == false within 10000
  tap "directory-entry"
  expect text "directory-link" == ""
  tap "directory-open-todos"
  expect tree has "chat-panel"
  expect text "todo-1" == "Pack camera"
