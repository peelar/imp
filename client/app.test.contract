// Exact starts the host (scripts/test-host.ts) empty for each test, so each test sets up what it needs through the
// host's API with `request`: the first starts from nothing to onboard; the rest are signed in, with GitHub installed
// as onboarding leaves it, and Todos and its todos where they need them. Each opens Imp on a new chat.

test "onboarding signs in with ChatGPT through a device code"
  clock data
  expect tree has "onboarding"
  expect tree missing "composer"
  tap "signin"
  clock until state account.status == "waiting" within 5000
  expect text "signin-code" == "TEST-1234"
  clock until state account.status == "signedIn" within 5000
  // The test host's computer is fixed, so the onboarding goes on to the first app: GitHub, which the imp is asked to
  // build, and on a narrow window the chat opens to watch it.
  expect tree has "first-app"
  expect text "onboarding-step" == "3 / 3"
  // One thing to do: connecting GitHub comes after, on the app's page.
  expect tree missing "github-connect"
  // Back goes to the computer step, done as it is, and on again to the first app without changing it.
  tap "onboarding-back"
  expect tree has "onboarding-computer"
  expect text "onboarding-step" == "2 / 3"
  tap "onboarding-continue"
  expect tree has "first-app"
  expect text "onboarding-step" == "3 / 3"
  tap "first-app-build"
  clock until state account.introduceApps == false within 10000
  expect tree missing "onboarding"
  clock until state chat.messages.0.text == "Build me a GitHub app that shows only the pull requests waiting for my review, and the ones I opened that are waiting on a review." within 5000
  expect state nav.tab == "chat"
  clock until state chat.busy == false within 10000
  // GitHub shows what an app is above it, until that is closed. Without GitHub connected it waits, which is no
  // failure: the bar says nothing of the sync, and the card offers GitHub's sign-in right there.
  tap "tab-github"
  expect tree has "app-guide"
  expect tree has "app-needs"
  expect tree missing "sync-bar"
  tap "app-guide-dismiss"
  expect tree missing "app-guide"
  expect tree has "app-manage"
  tap "app-github-connect"
  clock until state github.status == "waiting" within 5000
  expect text "app-github-code" == "TEST-5678"
  tap "app-github-cancel"
  clock until state github.status == "off" within 5000
  tap "tab-chat"
  tap "new-chat-chat"
  clock until state chat.messages.length == 0 within 5000
  expect tree has "composer"
  tap "tab-settings"
  tap "settings-pane-general"
  expect text "account-email" == "tester@example.com"
  expect text "account-plan" == "Plus"

test "the model is chosen next to the message box"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  expect text "model" == "faux-1"
  type "model" "faux-2"
  clock until state account.model == "faux-2" within 5000
  expect text "model" == "faux-2"
  type "model" "faux-1"
  clock until state account.model == "faux-1" within 5000

test "the app directory installs Todos, which Imp ships, and opens it"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "directory-entry"
  tap "directory-install-todos"
  clock until state apps.length == 2 within 5000
  clock settle
  expect state nav.tab == "todos"
  expect tree missing "app-guide"
  tap "home-entry"

test "a todo added in the Todos app is listed and counted"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  type "todo-draft" "Pack camera"
  tap "todo-add"
  clock until state todosReadList.0.title == "Pack camera" within 5000
  expect text "todo-1" == "Pack camera"
  expect text "todos-left" == "1 todo left"
  expect text "todo-draft" == ""

// A frozen page (a background tab, or one in the back/forward cache) holds no stream to the host, or the next page
// opened in the tab waits for one of the browser's six connections; it opens them again when it resumes.
test "a frozen page lets go of the host's streams, and catches up when it resumes"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  clock until state todosReadList.length == 0 within 5000
  prefer frozen true
  request POST "/api/call/todosAdd" ["Added while frozen"]
  clock +1000 real
  expect state todosReadList.length == 0
  prefer frozen false
  clock until state todosReadList.0.title == "Added while frozen" within 5000

test "the assistant adds a todo that the open Todos app shows at once"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please add todo: Book train to Kraków"
  tap "tab-todos"
  tap "tab-chat"
  tap "send"
  expect text "composer" == ""
  clock until state chat.busy == false within 10000
  expect tree missing "message-live"
  tap "tab-todos"
  clock until state todosReadList.0.title == "Book train to Kraków" within 5000
  expect text "todo-1" == "Book train to Kraków"

// The test model answers an image with its type (scripts/test-host.ts), so its answer says the image reached it.
test "an image attached to a message shows in the box, can be taken off, and reaches the imp above the words"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "attach"
  pick "images" "fixtures/screenshot.png"
  clock until state attachments.length == 1 within 5000
  expect tree has "attachments"
  tap "detach"
  expect state attachments.length == 0
  expect tree missing "attachments"
  tap "attach"
  pick "images" "fixtures/screenshot.png"
  clock until state attachments.length == 1 within 5000
  type "composer" "What is on this?"
  tap "send"
  expect state attachments.length == 0
  clock until state chat.busy == false within 10000
  clock until state chat.messages.length == 2 within 5000
  expect state chat.messages.0.text == "What is on this?"
  expect state chat.messages.0.images.length == 1
  expect state chat.messages.1.text == "I see image/png."

test "on a wide window the chat sits beside an open app, and what it is asked there lands in the app"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-todos"
  expect tree has "chat-panel"
  type "side-composer" "Add todo: Call the vet"
  tap "side-send"
  clock until state todosReadList.0.title == "Call the vet" within 10000
  clock until state chat.busy == false within 10000
  expect text "todo-1" == "Call the vet"
  clock until state chat.messages.0.text == "Add todo: Call the vet" within 1000
  expect state chat.messages.1.title == "Todos · Add"
  expect state chat.messages.1.detail == "Call the vet"
  tap "chat-expand"
  expect tree missing "chat-panel"
  expect tree has "chat-column"
  expect tree has "composer"
  expect tree has "tab-settings"

test "on a wide window each app keeps its own chat beside it, which a reload opens again"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "A chat from the home page"
  tap "send"
  clock until state chat.conversations.0.title == "A chat from the home page" within 5000
  clock until state chat.busy == false within 10000
  // No chat is about Todos yet, so a new one sits beside it, whichever was open.
  tap "tab-todos"
  clock until state chat.messages.length == 0 within 5000
  type "side-composer" "Add todo: Call the vet"
  tap "side-send"
  clock until state chat.messages.0.text == "Add todo: Call the vet" within 5000
  clock until state chat.busy == false within 10000
  // Another chat picked in the sidebar opens on the chat page; Todos opens its own beside it again.
  tap "conversation-1"
  clock until state chat.messages.0.text == "A chat from the home page" within 5000
  expect state nav.tab == "chat"
  tap "tab-todos"
  clock until state chat.messages.0.text == "Add todo: Call the vet" within 5000
  reload
  clock until state chat.messages.0.text == "Add todo: Call the vet" within 5000
  expect state nav.tab == "todos"
  expect tree has "chat-panel"
  // GitHub has none of its own.
  tap "tab-github"
  clock until state chat.messages.length == 0 within 5000

test "settings show the computer the agent works on, and offer to turn notifications on"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-general"
  expect text "notifications-state" == "Off"
  expect tree has "notifications-allow"
  expect tree missing "computer-name"
  tap "settings-pane-computer"
  expect tree missing "notifications-allow"
  clock until state computer.status == "ready" within 10000
  expect text "computer-name" == "This computer (development)"
  expect text "computer-status" == "Ready"
  expect tree missing "computer-size-2c-4096m"
  expect tree missing "computer-setup-prompt"
  expect tree has "computer-open-screen"

test "the computer's screen opens in its own tab, beside the chat on a wide window, and connects only while shown"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  clock until state computer.status == "ready" within 10000
  tap "tab-computer"
  expect state nav.tab == "computer"
  expect tree has "computer-frame"
  expect tree has "chat-panel"
  expect text "computer-page-status" == "Ready"
  tap "tab-settings"
  tap "settings-pane-computer"
  expect tree missing "computer-frame"
  tap "computer-open-screen"
  expect tree has "computer-frame"

test "what the imp is asked to remember shows in Settings, reaches its prompt, and can be forgotten"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-memory"
  expect tree has "memory-empty"
  tap "tab-chat"
  type "composer" "Please remember: Lives in Kraków"
  tap "send"
  clock until state memory.entries.0.facts.0 == "Lives in Kraków" within 10000
  clock until state chat.busy == false within 10000
  type "composer" "What do you know about me?"
  tap "send"
  clock until state chat.messages.4.text == "I know: Lives in Kraków" within 10000
  tap "tab-settings"
  tap "settings-pane-memory"
  expect text "memory-title-0" == "You"
  expect text "memory-fact-0-0" == "Lives in Kraków"
  tap "memory-forget-0-0"
  clock until state memory.entries.0.facts.length == 0 within 5000
  expect tree missing "memory-fact-0-0"
  tap "memory-forget-0"
  tap "memory-forget-confirm"
  clock until state memory.entries.length == 0 within 5000
  expect tree has "memory-empty"

test "after a chat the imp remembers what it learned on its own, without a tool call"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-chat"
  type "composer" "By the way, I live in Gdańsk now."
  tap "send"
  clock until state chat.busy == false within 10000
  clock until state memory.entries.0.facts.0 == "Lives in Gdańsk" within 10000
  tap "tab-settings"
  tap "settings-pane-memory"
  expect text "memory-fact-0-0" == "Lives in Gdańsk"

test "a key added in Settings reaches the imp's commands as a stand-in, never as its value"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-secrets"
  clock until state secrets.status == "ready" within 120000
  expect tree has "secrets-empty"
  tap "secret-add-github"
  type "secret-value" "ghp_testvalue123"
  tap "secret-save"
  clock until state secrets.secrets.0.name == "github" within 20000
  expect text "secret-name-0" == "GitHub"
  expect text "settings-count-secrets" == "1"
  expect tree missing "secret-form"
  tap "secret-add-github"
  expect text "secret-value" == ""
  tap "secret-cancel"
  tap "tab-chat"
  type "composer" "Please run: printenv GITHUB_TOKEN"
  tap "send"
  clock until state chat.busy == false within 30000
  clock until state chat.messages.2.text == "I see imp-secret-github." within 10000

test "the imp asks for a key it lacks, and the owner adds it from the request"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please ask for a key: linear"
  tap "send"
  clock until state secrets.requests.0.name == "linear" within 10000
  clock until state chat.busy == false within 10000
  tap "tab-settings"
  tap "settings-pane-secrets"
  clock until state secrets.status == "ready" within 120000
  expect tree has "secret-request-0"
  tap "secret-request-add-0"
  expect tree has "secret-form"
  type "secret-value" "lin_api_test"
  tap "secret-save"
  clock until state secrets.requests.length == 0 within 20000
  expect tree missing "secret-request-0"
  clock until state secrets.secrets.length == 1 within 5000
  expect text "secret-name-0" == "Linear"
  tap "secret-delete-0"
  expect state secrets.secrets.length == 1
  tap "secret-delete-confirm"
  clock until state secrets.secrets.length == 0 within 10000
  expect tree has "secrets-empty"

test "the imp asks for a login, and the owner adds it with its one-time-code key"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "Please ask for a login: github.com"
  tap "send"
  clock until state secrets.requests.0.name == "github-login" within 10000
  clock until state chat.busy == false within 10000
  tap "tab-settings"
  tap "settings-pane-secrets"
  clock until state secrets.status == "ready" within 120000
  tap "secret-request-add-0"
  expect text "secret-site" == "github.com"
  type "secret-username" "adrian"
  type "secret-value" "hunter2"
  type "secret-otp" "not a key"
  tap "secret-save"
  clock until state loginSaved.ok == false within 20000
  expect tree has "secret-error"
  type "secret-otp" "otpauth://totp/GitHub:adrian?secret=JBSWY3DPEHPK3PXP&issuer=GitHub"
  tap "secret-save"
  clock until state secrets.requests.length == 0 within 20000
  clock until state secrets.secrets.0.name == "github-login" within 5000
  expect text "secret-detail-0" == "github.com · adrian · one-time codes"
  tap "secret-replace-0"
  expect text "secret-username" == "adrian"
  type "secret-username" "adrian-p"
  tap "secret-save"
  clock until state secrets.secrets.0.username == "adrian-p" within 20000
  expect text "secret-detail-0" == "github.com · adrian-p · one-time codes"

test "settings connect GitHub with a device code, then back the apps' code up to it"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  request POST "/api/call/appsInstall" ["todos"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-connections"
  // GitHub, which the onboarding installed, then Todos, from the app directory.
  clock until state backup.versions == 2 within 5000
  expect text "backup-versions" == "2 versions kept"
  expect tree has "backup-turn-on"
  tap "github-connect"
  clock until state github.status == "waiting" within 5000
  expect text "github-code" == "TEST-5678"
  clock until state github.status == "on" within 30000
  expect text "github-login" == "@tester"
  tap "backup-turn-on"
  clock until state backup.synced == true within 10000
  expect text "backup-repo" == "tester/imp-apps"
  expect text "backup-state" == "Up to date"
  tap "github-disconnect"
  clock until state backup.status == "off" within 5000
  expect tree has "github-connect"

test "settings add an MCP server with a key, then remove it"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-connections"
  expect tree has "mcp-empty"
  type "mcp-form-name" "Sentry"
  type "mcp-form-url" "http://mcp.sentry.dev/mcp"
  tap "mcp-form-add"
  clock until state serverError == "Give the server's HTTPS address, such as https://mcp.linear.app/mcp." within 20000
  expect tree has "mcp-form-error"
  type "mcp-form-url" "https://mcp.sentry.dev/mcp"
  type "mcp-form-key" "sntrys_test"
  tap "mcp-form-add"
  clock until state account.mcpServers.0.status == "on" within 20000
  expect text "mcp-name-0" == "Sentry"
  expect text "mcp-status-0" == "Connected"
  tap "mcp-remove-0"
  tap "mcp-remove-confirm"
  clock until state account.mcpServers.length == 0 within 5000
  expect tree has "mcp-empty"

test "Settings' Experimental tab keeps a feature flag for Imp's next start"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-experimental"
  expect text "flag-label-0" == "App directory"
  expect tree missing "flag-pending-0"
  tap "flag-app-directory"
  clock until state account.flags.0.next == false within 5000
  expect state account.flags.0.on == true
  expect text "flag-pending-0" == "Off after Imp restarts"
  tap "flag-app-directory"
  clock until state account.flags.0.next == true within 5000
  expect tree missing "flag-pending-0"

test "Settings' Assistants tab gives the MCP address and shares an app with other assistants"
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  tap "tab-settings"
  tap "settings-pane-assistants"
  expect text "assistants-app-github" == "GitHub"
  expect state account.assistants.0.shared == false
  tap "assistants-share-github"
  clock until state account.assistants.0.shared == true within 5000
  tap "assistants-share-github"
  clock until state account.assistants.0.shared == false within 5000

test "the sidebar starts new chats, folds all but the latest three, and lists the imp's tricks"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  expect tree has "sidebar"
  // Imp opens on the home page, not on the conversation the last test left open.
  expect tree has "home"
  type "composer" "An earlier chat"
  tap "send"
  clock until state chat.conversations.0.title == "An earlier chat" within 5000
  clock until state chat.busy == false within 10000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  expect text "conversation-0" == "An earlier chat"
  expect text "tricks-count" == "2"
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  expect tree has "home"
  type "composer" "First new chat"
  tap "send"
  clock until state chat.conversations.0.title == "First new chat" within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Second new chat"
  tap "send"
  clock until state chat.conversations.0.title == "Second new chat" within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Third new chat"
  tap "send"
  clock until state chat.conversations.0.title == "Third new chat" within 5000
  expect text "conversation-0" == "Third new chat"
  expect text "conversation-2" == "First new chat"
  expect tree missing "conversation-3"
  tap "conversations-older"
  expect text "conversation-3" == "An earlier chat"
  tap "conversation-3"
  clock until state chat.messages.0.text == "An earlier chat" within 5000
  tap "tricks-entry"
  expect tree has "tricks"
  expect text "trick-title-0" == "Search Hacker News"
  expect text "trick-title-1" == "Track a parcel"
  expect state nav.tab == "tricks"
  tap "trick-0"
  expect tree has "tricks"
  expect text "side-composer" == "Search Hacker News: "
  tap "home-entry"
  expect state nav.tab == "chat"
  clock until state chat.messages.length == 0 within 5000
  expect tree has "home"

test "pointing at a chat in the sidebar shows Archive, which folds the chat under Archived until it is restored"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "First new chat"
  tap "send"
  clock until state chat.conversations.0.title == "First new chat" within 5000
  clock until state chat.busy == false within 10000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Second new chat"
  tap "send"
  clock until state chat.conversations.0.title == "Second new chat" within 5000
  clock until state chat.busy == false within 10000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  type "composer" "Third new chat"
  tap "send"
  clock until state chat.conversations.0.title == "Third new chat" within 5000
  clock until state chat.busy == false within 10000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  expect text "conversation-0" == "Third new chat"
  expect tree missing "conversation-archive-0"
  tap "conversation-row-0" hover
  tap "conversation-archive-0"
  clock until state chat.conversations.0.title == "Second new chat" within 5000
  expect text "conversation-0" == "Second new chat"
  expect tree has "home"
  // The open chat, archived, gives way to the home page.
  tap "conversation-0"
  clock until state chat.messages.0.text == "Second new chat" within 5000
  tap "conversation-row-0" hover
  tap "conversation-archive-0"
  clock until state chat.conversations.0.title == "First new chat" within 5000
  clock until state chat.messages.length == 0 within 5000
  expect tree has "home"
  // Archived folds both at the sidebar's foot; one opens to be read, and Restore puts it back under Recent.
  expect text "conversations-archived" == "+Archived (2)"
  expect tree missing "archived-conversation-0"
  tap "conversations-archived"
  expect text "archived-conversation-0" == "Third new chat"
  expect text "archived-conversation-1" == "Second new chat"
  tap "archived-conversation-0"
  clock until state chat.messages.0.text == "Third new chat" within 5000
  tap "archived-conversation-row-0" hover
  tap "archived-conversation-restore-0"
  clock until state chat.conversations.0.title == "Third new chat" within 5000
  expect text "conversation-0" == "Third new chat"
  expect text "conversations-archived" == "−Archived (1)"
  expect state chat.messages.0.text == "Third new chat"

test "a chat the imp is still at work in keeps a mark in the sidebar after the person moves on"
  size 1280x800
  request POST "/api/call/accountSignIn" []
  request POST "/api/call/appsInstall" ["github"]
  clock until state account.status == "signedIn" within 5000
  type "composer" "Build me an app, run: sleep 3"
  tap "send"
  clock until state chat.busy == true within 5000
  tap "chat-new"
  clock until state chat.messages.length == 0 within 5000
  clock until state chat.conversations.0.working == true within 5000
  expect tree has "conversation-working-0"
  clock until state chat.conversations.0.working == false within 15000
  expect tree missing "conversation-working-0"

