// Routines: the routines' page, and the bar above a routine's conversation that runs, pauses and deletes it.

use Label, Body, Heading, Lead, Mono, Small, Subheading from "./look.contract"
use Button from "./controls.contract"
use Routine from "./host.contract"
use numbered, KeyBadge from "./parts.contract"

fn routineStatus(r: Routine): string =
  r.running ? "Running now" : r.asked ? "Starting soon" : r.paused ? "Paused" : r.next == "" ? "Not scheduled" : `Next ${r.next}`

fn routineLast(r: Routine): string = r.last == "" ? "Not run yet" : r.failed ? `Last run failed ${r.last}` : `Last ran ${r.last}`

// The Routines page: what the imp does on a schedule, each opening its conversation, and a way to ask for one.
component RoutineList
  props
    routines: Routine[]
    open: action
    ask: action
  view
    scroll id="routines-list" flex=1 min-height=0
      column max-width="48.5rem" margin="0 auto" padding="space.lg space.md space.xl" gap="space.md" box-sizing="border-box" width="100%"
        testId="routines"
        text "What your imp does on a schedule, such as a morning summary or a weekly check. Open one to see its runs, run it now, pause or delete it."
          color="ink.muted" class=Lead max-width="measure.note"
        row
          button press=ask testId="routine-new" display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm"
            border="1px solid ink.strong" background-color="ink.strong" color="surface.page"
            image "symbol:icon.add" width=12 height=12 aria-hidden=true
            text "Ask for a routine" class=Label color="inherit"
        column
          row align-items="baseline" justify-content="space-between" padding-bottom="space.sm" border-bottom="1px solid ink.strong"
            text "Your routines" class=Label color="ink.strong" role="heading" aria-level=2
            text `No. ${numbered(routines.length)}` class=Label
          if routines.length == 0
            text "None yet. Ask your imp to do something on a schedule, and it keeps it here."
              class=Body font-style="italic" color="ink.muted" padding="space.ms 0" testId="routines-empty"
          for r, i in routines key=r.id
            button press=open(r.id) testId=`routine-${i}` display="flex" align-items="center" gap="space.ms" padding="space.ms 0"
              background-color="transparent" border="none" border-bottom="1px solid line.subtle" text-align="start"
              color="ink.strong" transition="background-color 120ms ease"
              :hover
                background-color="surface.soft"
              row width=44 height=44 min-width=44 align-items="center" justify-content="center"
                border="1px solid line.strong" box-sizing="border-box" aria-hidden=true
                image "symbol:icon.repeat" width=18 height=18
              column gap="space.xxs" flex=1 min-width=0
                text r.name class=Heading testId=`routine-name-${i}`
                text (r.paused ? "Paused" : r.when) class=Body color="ink.muted" line-clamp=1
              if r.running
                row width=7 height=7 min-width=7 background-color="AccentColor" aria-label="Running"
                  testId=`routine-running-${i}`
              else if r.unread
                row width=7 height=7 min-width=7 background-color="ink.strong" aria-label="New run"
                  testId=`routine-unread-${i}`
              text "→" class=Mono color="ink.muted" aria-hidden=true padding-right="space.xs"

// Above an open routine's conversation: when it runs, what it does, how its last run went, and the person's controls.
component RoutineBar
  props
    routine: Routine
    busy: bool
    run: action
    pause: action
    remove: action
    keys: bool
  view
    row justify-content="center" padding="0 space.md" border-bottom="1px solid line.subtle" testId="routine-bar"
      column width="100%" max-width="measure.page" gap="space.sm" padding="space.ms 0"
        row align-items="baseline" gap="space.sm" flex-wrap="wrap"
          text "Routine" class=Label color="ink.strong"
          text routine.when class=Subheading testId="routine-when"
          row flex=1
          text routineStatus(routine) class=Label testId="routine-status"
        text routine.instruction class=Body color="ink.muted" testId="routine-instruction"
        row align-items="center" gap="space.sm" flex-wrap="wrap"
          text routineLast(routine) class=Small color=(routine.failed ? "ink.danger" : "ink.muted")
            flex=1 min-width="10rem" testId="routine-last"
          row gap="space.sm"
            button press=run(routine.id) disabled=(busy or routine.running or routine.asked) aria-keyshortcuts="Meta+R"
              testId="routine-run" display="flex" align-items="center" gap="space.sm" padding="space.sm space.sm"
              border="1px solid ink.strong" background-color="ink.strong" color="surface.page" position="relative"
              image "symbol:icon.play" width=12 height=12 aria-hidden=true
              text "Run now" class=Label color="inherit"
              if keys
                KeyBadge(chord="Meta+R", at="end")
            Button(press=pause(routine.id, not routine.paused), variant="secondary", disabled=busy, testId="routine-pause")
              text (routine.paused ? "Resume" : "Pause")
            button press=remove disabled=busy testId="routine-delete" padding="space.sm space.sm" border="1px solid line.strong"
              background-color="transparent" color="ink.danger"
              :hover
                background-color="danger.soft"
              text "Delete" class=Label color="inherit"
