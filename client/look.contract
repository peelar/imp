// The catalogue's styles and motion, which every screen of the shell shares. Colours and type are app.tamber's.

// The catalogue's small capitals: mono, upper case, spaced.
style Label
  font-family = "family.mono"
  font-size = "0.6875rem"
  font-weight = 500
  letter-spacing = "0.12em"
  text-transform = "uppercase"
  color = "ink.muted"

// A shortcut's keys, as a keycap: the labels' mono in a hairline box.
style Key
  font-family = "family.mono"
  font-size = "0.6875rem"
  font-weight = 500
  line-height = 1.4
  white-space = "nowrap"
  color = "ink.muted"
  padding = "0 5px"
  border = "1px solid line.strong"
  background-color = "surface.page"

style Rule
  height = 1
  background-color = "line.subtle"

keyframes rise
  from opacity=0 translate="0px 6px"

keyframes pulse
  0% opacity=0.25
  50% opacity=1
  100% opacity=0.25
